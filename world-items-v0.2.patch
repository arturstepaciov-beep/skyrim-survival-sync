+#include <Structs/WorldItemData.h>
+#include <TiltedCore/Serialization.hpp>
+void WorldItemData::Serialize(Buffer::Writer& w) const noexcept
+{
+    using TiltedPhoques::Serialization;
+    for (auto v : {Id, Creator, SourceRef, Owner, Token})
+        Serialization::WriteVarInt(w, v);
+    Reference.Serialize(w);
+    Cell.Serialize(w);
+    WorldSpace.Serialize(w);
+    Item.Serialize(w);
+    for (float v : {X, Y, Z, RX, RY, RZ})
+        Serialization::WriteFloat(w, v);
+    Serialization::WriteBool(w, Consumed);
+}
+void WorldItemData::Deserialize(Buffer::Reader& r) noexcept
+{
+    using TiltedPhoques::Serialization;
+    Id = Serialization::ReadVarInt(r);
+    Creator = Serialization::ReadVarInt(r);
+    SourceRef = Serialization::ReadVarInt(r);
+    Owner = Serialization::ReadVarInt(r);
+    Token = Serialization::ReadVarInt(r);
+    Reference.Deserialize(r);
+    Cell.Deserialize(r);
+    WorldSpace.Deserialize(r);
+    Item.Deserialize(r);
+    X = Serialization::ReadFloat(r);
+    Y = Serialization::ReadFloat(r);
+    Z = Serialization::ReadFloat(r);
+    RX = Serialization::ReadFloat(r);
+    RY = Serialization::ReadFloat(r);
+    RZ = Serialization::ReadFloat(r);
+    Consumed = Serialization::ReadBool(r);
+}
