+TEST_CASE("Autosync HUD reports native scheduler seconds", "[encoding.presentation]")
+{
+    REQUIRE(PresentationSyncPolicy::SecondsRemaining(10.0, 0.0) == 10);
+    REQUIRE(PresentationSyncPolicy::SecondsRemaining(10.0, 0.01) == 10);
