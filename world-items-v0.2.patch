+TEST_CASE("Hearthfire chest snapshots assemble before applying and transfers roundtrip", "[encoding.homestead]")
+{
+    HomesteadData original; original.Action = HomesteadAction::State; original.Authority = 12;
+    HomesteadRecord chest; chest.Reference = GameId{3, 0x1234}; chest.Cell = GameId{3, 0x100}; chest.HasInventory = true;
+    for (int n = 0; n < 73; ++n) { Inventory::Entry item; item.BaseId = GameId{0, static_cast<uint32_t>(n + 1)}; item.Count = n + 1; chest.Contents.Entries.push_back(item); }
+    original.Records.push_back(chest);
+    HomesteadWire::Assembler assembler; unsigned parts{}, completed{};
+    HomesteadWire::Split(original, [&](const HomesteadData& part) {
+        NotifyHomestead packet; packet.Data = part;
+        Buffer buffer(65536); Buffer::Writer writer(&buffer); packet.Serialize(writer);
+        REQUIRE(writer.Size() < 65536);
+        Buffer::Reader reader(&buffer); ServerMessageFactory factory; auto decoded = factory.Extract(reader); REQUIRE(decoded);
+        auto reply = CastUnique<NotifyHomestead>(std::move(decoded)); REQUIRE(reply->Data.Authority == 12);
+        HomesteadRecord assembled;
+        if (assembler.Accept(reply->Data.Records.front(), assembled)) { ++completed; REQUIRE(assembled.Contents == chest.Contents); REQUIRE(assembled.Cell == chest.Cell); }
+        ++parts;
+    });
+    REQUIRE(parts == 10); REQUIRE(completed == 1);
+    auto bad = chest; bad.InventoryTotal = 10; bad.InventoryOffset = 2; bad.Contents.Entries.resize(1);
+    HomesteadRecord ignored; REQUIRE_FALSE(assembler.Accept(bad, ignored));
+    RequestHomestead transfer; transfer.Data.Action = HomesteadAction::Transfer; transfer.Data.Token = 22;
+    transfer.Data.Reference = chest.Reference; transfer.Data.Deposit = true; transfer.Data.Item = chest.Contents.Entries.front();
+    Buffer buffer(4096); Buffer::Writer writer(&buffer); transfer.Serialize(writer); Buffer::Reader reader(&buffer);
+    ClientMessageFactory factory; auto decoded = factory.Extract(reader); REQUIRE(decoded);
+    auto request = CastUnique<RequestHomestead>(std::move(decoded));
+    REQUIRE(request->Data.Action == HomesteadAction::Transfer); REQUIRE(request->Data.Token == 22);
