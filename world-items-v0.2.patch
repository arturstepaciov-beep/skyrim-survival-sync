new file mode 100644
index 00000000..cc774ebe
--- /dev/null
+++ b/Code/common/WorldItemPolicy.h
@@ -0,0 +1,52 @@
+#pragma once
+#include <cstdint>
+#include <cmath>
+#include <initializer_list>
+namespace SharedItems
+{
+struct Claim
+{
+    uint32_t Owner{};
+    uint64_t LeaseUntil{};
+    bool Consumed{};
+    bool Grab(uint32_t player, uint64_t now) noexcept
+    {
+        if (Consumed || !player || (Owner && Owner != player && now < LeaseUntil))
+            return false;
+        Owner = player;
+        LeaseUntil = now + 1500;
+        return true;
+    }
+    bool Move(uint32_t player, uint64_t now) noexcept
+    {
+        if (Consumed || !player || Owner != player)
+            return false;
+        LeaseUntil = now + 1500;
+        return true;
+    }
+    bool Release(uint32_t player) noexcept
+    {
+        if (Consumed || !player || Owner != player)
+            return false;
+        Owner = 0;
+        LeaseUntil = 0;
+        return true;
+    }
+    bool Pickup(uint32_t player) noexcept
+    {
+        if (Consumed || !player)
+            return false;
+        Consumed = true;
+        Owner = 0;
+        LeaseUntil = 0;
+        return true;
+    }
+};
+template <class T> bool ValidPose(const T& d) noexcept
+{
+    for (float v : {d.X, d.Y, d.Z, d.RX, d.RY, d.RZ})
+        if (!std::isfinite(v) || std::abs(v) > 10000000.f)
+            return false;
+    return true;
+}
+} // namespace SharedItems
