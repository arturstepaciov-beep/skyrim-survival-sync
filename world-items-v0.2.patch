+    HomesteadRecord ignored; REQUIRE_FALSE(assembler.Accept(bad, ignored));
+    RequestHomestead transfer; transfer.Data.Action = HomesteadAction::Transfer; transfer.Data.Token = 22;
+    transfer.Data.Reference = chest.Reference; transfer.Data.Deposit = true; transfer.Data.Item = chest.Contents.Entries.front();
+    Buffer buffer(4096); Buffer::Writer writer(&buffer); transfer.Serialize(writer); Buffer::Reader reader(&buffer);
+    ClientMessageFactory factory; auto decoded = factory.Extract(reader); REQUIRE(decoded);
+    auto request = CastUnique<RequestHomestead>(std::move(decoded));
+    REQUIRE(request->Data.Action == HomesteadAction::Transfer); REQUIRE(request->Data.Token == 22);
+    REQUIRE(request->Data.Deposit); REQUIRE(request->Data.Item == transfer.Data.Item);
+}
+TEST_CASE("Different custom enchantment effects remain separate inventory variants", "[encoding.homestead]")
+{
+    Inventory::Entry a; a.BaseId = GameId{0, 1}; a.Count = 1;
+    Inventory::EffectItem effect; effect.EffectId = GameId{0, 2}; effect.Magnitude = 10; a.EnchantData.Effects.push_back(effect);
+    auto b = a; b.EnchantData.Effects.front().Magnitude = 20;
+    REQUIRE_FALSE(a.CanBeMerged(b)); Inventory inv; inv.AddOrRemoveEntry(a); inv.AddOrRemoveEntry(b); REQUIRE(inv.Entries.size() == 2);
+}
+
+TEST_CASE("Shared chest reconciliation preserves local dynamic and quest items", "[encoding.homestead]")
+{
+    Inventory current, wanted;
+    Inventory::Entry normal; normal.BaseId = GameId{0, 0x123}; normal.Count = 4;
+    auto dynamic = normal; dynamic.BaseId = GameId{UINT32_MAX, 0x800};
+    auto enchant = normal; enchant.ExtraEnchantId = GameId{UINT32_MAX, 0x900};
+    auto quest = normal; quest.IsQuestItem = true;
+    current.Entries = {normal, dynamic, enchant, quest};
+    auto target = normal; target.Count = 2; wanted.Entries = {target};
+    auto changes = HomesteadInventory::Difference(current, wanted);
+    REQUIRE(changes.Entries.size() == 1); REQUIRE(changes.Entries.front().Count == -2);
+    REQUIRE(changes.Entries.front().BaseId == normal.BaseId);
+    REQUIRE_FALSE(HomesteadInventory::Supported(dynamic)); REQUIRE_FALSE(HomesteadInventory::Supported(enchant));
+    auto share = HomesteadInventory::SharedPart(current); REQUIRE(share.Entries.size() == 1);
+    auto repeated = HomesteadInventory::Difference(wanted, wanted); REQUIRE(repeated.Entries.empty());
+}
