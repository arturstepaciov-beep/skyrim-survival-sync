+void CalendarService::BeginTimeSkip(float aStartTimeInDays, float aDesiredEndTimeInDays, const char* apKind) noexcept
+{
+    m_pendingSkipHours = 0.f;
+    if (!s_gameClockLocked || !m_transport.IsOnline() || !m_hasServerTime)
+        return;
+    const float hours = (aDesiredEndTimeInDays - aStartTimeInDays) * 24.f;
+    if (!std::isfinite(hours) || hours <= 0.f || hours > 24.01f)
+        return;
+    s_localTimeSkip = true;
+    m_deferredSkipDays = 0;
+    m_skipStartDays = TimeData::Get()->GameDaysPassed->f;
+    m_pendingSkipHours = hours;
+    m_pendingSkipTarget = m_serverTime;
+    m_pendingSkipTarget.AddHours(hours);
+
+    spdlog::info("{} started: game time {} -> {} days, {} hours requested, online {}", apKind, aStartTimeInDays, aDesiredEndTimeInDays, m_pendingSkipHours, s_gameClockLocked);
+}
+
+void CalendarService::EndTimeSkip(bool aInterrupted, const char* apKind) noexcept
+{
+    float hours = m_pendingSkipHours;
+    if (s_localTimeSkip)
+    {
+        const float elapsedDays = std::max(0.f, TimeData::Get()->GameDaysPassed->f - m_skipStartDays);
+        TimeData::Get()->GameDaysPassed->f += std::max(0.f, m_deferredSkipDays - elapsedDays);
+        m_accountedSkipDays += std::max(0.f, elapsedDays - m_deferredSkipDays);
+        m_deferredSkipDays = 0;
+        if (aInterrupted)
+        {
+            hours = elapsedDays * 24.f;
+            m_pendingSkipTarget = m_serverTime;
+            m_pendingSkipTarget.AddHours(hours);
+        }
+    }
+    s_localTimeSkip = false;
+    m_pendingSkipHours = 0.f;
+
+    // Offline the game advanced its own clock; online the clock is driven by the server, so ask it to skip.
+    if (!s_gameClockLocked || !m_transport.IsOnline())
+        return;
+
+    if (!(hours > 0.f) || hours > 24.01f)
+    {
+        spdlog::info("{} ended without a time skip: interrupted {}, hours {}", apKind, aInterrupted, hours);
+        return;
+    }
+
+    RequestTimeSkip request{};
+    request.TargetTime = m_pendingSkipTarget.m_timeModel;
+    m_transport.Send(request);
+
+    spdlog::info("{} ended: requested a shared time skip of {} hours", apKind, hours);
 }
 
