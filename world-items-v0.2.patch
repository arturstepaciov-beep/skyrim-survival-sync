+#include <Services/CoopChestService.h>
+#include <World.h>
+#include <Components.h>
+#include <Messages/RequestHomestead.h>
+#include <Messages/NotifyHomestead.h>
+#include <Messages/NotifyInventoryChanges.h>
+#include <Events/PlayerLeaveEvent.h>
+#include <CoopChestLocations.h>
+#include <CoopChestStore.h>
+#include <HomesteadPolicy.h>
+namespace
+{
+const std::filesystem::path StorePath = std::filesystem::path("config") / "CoopChest.dat";
+std::optional<std::string> NameOf(World& w, uint32_t id)
+{
+    const auto& mods = w.ctx().at<ModsComponent>();
+    for (const auto& [name, info] : mods.GetStandardMods()) if (info.id == id) return std::string(name.data(), name.size());
+    for (const auto& [name, info] : mods.GetLiteMods()) if (info.id == id) return std::string(name.data(), name.size());
+    return {};
+}
+std::optional<GameId> Resolve(World& w, const std::string& filename, uint32_t base)
+{
+    const auto& mods = w.ctx().at<ModsComponent>();
+    for (const auto& [name, info] : mods.GetStandardMods())
+        if (std::string(name.data(), name.size()) == filename) return GameId(info.id, base);
+    for (const auto& [name, info] : mods.GetLiteMods())
+        if (std::string(name.data(), name.size()) == filename) return GameId(info.id, base);
+    return {};
+}
+int64_t Count(const Inventory& inv, const Inventory::Entry& item)
+{
+    int64_t count{}; for (const auto& entry : inv.Entries) if (entry.CanBeMerged(item)) count += entry.Count; return count;
+}
+}
+CoopChestService::CoopChestService(World& w, entt::dispatcher& d) : m_world(w)
+{
+    m_request = d.sink<PacketEvent<RequestHomestead>>().connect<&CoopChestService::OnRequest>(this);
+    m_leave = d.sink<PlayerLeaveEvent>().connect<&CoopChestService::OnLeave>(this);
+}
+void CoopChestService::OnLeave(const PlayerLeaveEvent& e) { if (e.pPlayer) m_tokens.erase(e.pPlayer->GetId()); }
+bool CoopChestService::Load()
+{
+    if (m_loaded) return true;
+    std::error_code ec; const bool exists = std::filesystem::exists(StorePath, ec); if (ec) return false;
+    if (!exists) { m_inventory = {}; m_loaded = true; return true; }
+    const auto bytes = CoopChestStore::Read(StorePath);
+    if (!bytes || !CoopChestStore::Decode(*bytes, [this](const std::string& n, uint32_t b) { return Resolve(m_world, n, b); }, m_inventory))
+    {
+        // Do not replace damaged storage or discard stacks whose plugins are absent.
+        spdlog::error("Co-op chest unavailable: config/CoopChest.dat is invalid or requires missing plugins"); return false;
+    }
+    m_loaded = true; return true;
+}
+bool CoopChestService::Persist(const Inventory& inv)
+{
+    auto bytes = CoopChestStore::Encode(inv, [this](uint32_t id) { return NameOf(m_world, id); });
+    return bytes && CoopChestStore::Save(StorePath, *bytes);
+}
+void CoopChestService::Send(Player* player, HomesteadAction action, uint32_t token, bool accepted)
+{
+    HomesteadData data; data.Action = action; data.Token = token; data.Accepted = accepted;
+    data.Reference = GameId(CoopChests::VirtualMod, 0);
+    if (m_loaded)
+    {
+        HomesteadRecord record; record.Reference = data.Reference; record.HasInventory = true; record.Contents = m_inventory; data.Records.push_back(std::move(record));
+    }
+    HomesteadWire::Split(data, [player](const HomesteadData& part) { NotifyHomestead n; n.Data = part; player->Send(n); });
+}
+void CoopChestService::OnRequest(const PacketEvent<RequestHomestead>& e)
+{
+    const auto& q = e.Packet.Data;
+    if (q.Action != HomesteadAction::CoopPoll && q.Action != HomesteadAction::CoopOpen && q.Action != HomesteadAction::CoopTransfer) return;
+    auto* player = e.pPlayer; if (!player || !player->GetCharacter()) return;
+    // The network is server-owned. No host or guest may publish/merge a cached copy.
+    if (!Load()) { Send(player, HomesteadAction::CoopRejected, q.Token, false); return; }
+    if (q.Action == HomesteadAction::CoopPoll) { Send(player, HomesteadAction::CoopState, 0, true); return; }
+    if (q.Reference.ModId != CoopChests::VirtualMod || q.Reference.BaseId < 1 || q.Reference.BaseId > CoopChests::Locations.size()) return;
+    const auto& location = CoopChests::Locations[q.Reference.BaseId - 1];
+    const auto worldId = Resolve(m_world, "Skyrim.esm", 0x3C);
+    const auto actor = *player->GetCharacter();
+    auto* movement = m_world.try_get<MovementComponent>(actor);
+    const auto& cell = player->GetCellComponent();
+    if (!worldId || cell.WorldSpaceId != *worldId || !movement ||
+        !std::isfinite(movement->Position.x) || !std::isfinite(movement->Position.y) || !std::isfinite(movement->Position.z) ||
+        glm::distance(movement->Position, glm::vec3(location.X, location.Y, location.Z)) > 512.f)
+    { Send(player, HomesteadAction::CoopRejected, q.Token, false); return; }
+    if (q.Action == HomesteadAction::CoopOpen) { Send(player, HomesteadAction::CoopOpened, q.Token, true); return; }
+    auto& last = m_tokens[player->GetId()]; if (!HomesteadPolicy::FreshToken(q.Token, last)) return; last = q.Token;
+    auto* inv = m_world.try_get<InventoryComponent>(actor); auto* owner = m_world.try_get<OwnerComponent>(actor);
+    if (!inv || !owner || owner->GetOwner() != player) return;
+    auto item = q.Item;
+    if (item.Count <= 0 || item.Count > 32767 || !HomesteadInventory::Supported(item) || item.ExtraWorn || item.ExtraWornLeft || item.EnchantData.Effects.size() > 64 ||
+        !std::isfinite(item.ExtraCharge) || !std::isfinite(item.ExtraHealth))
+    { Send(player, HomesteadAction::CoopResult, q.Token, false); return; }
+    const auto source = q.Deposit ? Count(inv->Content, item) : Count(m_inventory, item);
+    const auto destination = q.Deposit ? Count(m_inventory, item) : Count(inv->Content, item);
+    bool accepted = HomesteadPolicy::CanTransfer(source, destination, item.Count);
+    Inventory proposedChest = m_inventory, proposedPlayer = inv->Content;
+    auto playerDelta = item; playerDelta.Count = q.Deposit ? -item.Count : item.Count;
+    auto chestDelta = playerDelta; chestDelta.Count = -playerDelta.Count;
+    if (accepted)
+    {
+        proposedPlayer.AddOrRemoveEntry(playerDelta); proposedChest.AddOrRemoveEntry(chestDelta);
+        accepted = HomesteadWire::ValidInventory(proposedPlayer) && HomesteadWire::ValidInventory(proposedChest) && Persist(proposedChest);
+    }
+    if (accepted)
+    {
+        // Disk commit precedes the native inventory acknowledgement. Failed saves
+        // leave both live inventories untouched; never acknowledge a volatile transfer.
+        m_inventory = std::move(proposedChest); inv->Content = std::move(proposedPlayer);
+        NotifyInventoryChanges delta; delta.ServerId = World::ToInteger(actor); delta.OwnershipEpoch = owner->OwnershipEpoch; delta.Item = playerDelta;
+        for (auto* peer : m_world.GetPlayerManager()) peer->Send(delta);
+        for (auto* peer : m_world.GetPlayerManager()) Send(peer, HomesteadAction::CoopResult, peer == player ? q.Token : 0, true);
+    }
+    else Send(player, HomesteadAction::CoopResult, q.Token, false);
+}
