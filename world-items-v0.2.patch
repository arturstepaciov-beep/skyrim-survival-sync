+        auto result = CastUnique<CharacterSpawnRequest>(std::move(decoded));
+        REQUIRE(result->IsResync == refresh);
+        REQUIRE(result->ServerId == 19);
+        REQUIRE(result->OwnershipEpoch == 3);
+        REQUIRE(result->ActionsToReplay == snapshot.ActionsToReplay);
+    }
+    RequestWorldItem request;
+    request.Action = WorldItemAction::Resync;
+    Buffer buffer(4096);
+    Buffer::Writer writer(&buffer);
+    request.Serialize(writer);
+    Buffer::Reader reader(&buffer);
+    ClientMessageFactory factory;
+    auto decoded = factory.Extract(reader);
+    REQUIRE(decoded);
+    REQUIRE(decoded->GetOpcode() == RequestWorldItem::Opcode);
+    auto result = CastUnique<RequestWorldItem>(std::move(decoded));
+    REQUIRE(result->Action == WorldItemAction::Resync);
+}
