+++ b/Code/client/Services/Generic/VolcanoService.cpp
@@ -0,0 +1,193 @@
+#include <Services/VolcanoService.h>
+#include <Services/PapyrusService.h>
+#include <Services/TransportService.h>
+#include <World.h>
+#include <Games/TES.h>
+#include <PlayerCharacter.h>
+#include <Forms/SpellItem.h>
+#include <Forms/TESObjectCELL.h>
+#include <Forms/TESWorldSpace.h>
+#include <Events/UpdateEvent.h>
+#include <Events/DisconnectedEvent.h>
+#include <Events/PapyrusFunctionRegisterEvent.h>
+#include <Messages/RequestWorldItem.h>
+#include <Messages/NotifyWorldItem.h>
+#include <VolcanoSyncPolicy.h>
+#include <WorldItemPolicy.h>
+#include <mutex>
+#include <chrono>
+#include <unordered_map>
+namespace
+{
+uint32_t LocalApocalypseForm(uint32_t base)
+{
+    auto* mods = ModManager::Get();
+    auto* mod = mods ? mods->GetByName("Apocalypse - Magic of Skyrim.esp") : nullptr;
+    return mod && mod->IsLoaded() && !mod->IsLite() ? (uint32_t(mod->standardId) << 24) | base : 0;
+}
+bool IsVisual(uint32_t id)
+{
+    return id && (id == LocalApocalypseForm(ApocalypseVolcano::Fountain) || id == LocalApocalypseForm(ApocalypseVolcano::Light));
+}
+using RemoteCast = void(BSScript::IVirtualMachine*, uint32_t, const SpellItem*, TESObjectREFR*, Actor*, TESObjectREFR*);
+RemoteCast* s_remoteCast = nullptr;
+thread_local uint32_t s_immediateBlame{};
+struct Source { uint32_t Blame; std::chrono::steady_clock::time_point Expires; };
+std::mutex s_sourcesLock;
+std::unordered_map<uint32_t, Source> s_sources;
+void HookVolcanoRemoteCast(BSScript::IVirtualMachine* vm, uint32_t stack, const SpellItem* spell,
+                          TESObjectREFR* source, Actor* blame, TESObjectREFR* target)
+{
+    const auto previous = s_immediateBlame;
+    if (spell && spell->formID == LocalApocalypseForm(ApocalypseVolcano::LavaSpell) &&
+        source && blame && blame == PlayerCharacter::Get())
+    {
+        s_immediateBlame = blame->formID;
+        std::lock_guard<std::mutex> lock(s_sourcesLock);
+        const auto now = std::chrono::steady_clock::now();
+        for (auto i = s_sources.begin(); i != s_sources.end();)
+            if (i->second.Expires < now) i = s_sources.erase(i); else ++i;
+        if (s_sources.size() < 128 || s_sources.contains(source->formID))
+            s_sources.insert_or_assign(source->formID, Source{blame->formID, now + std::chrono::seconds(12)});
+    }
+    s_remoteCast(vm, stack, spell, source, blame, target);
+    s_immediateBlame = previous;
+}
+}
+uint32_t ResolveVolcanoProjectileOwner(uint32_t shooter, uint32_t spell) noexcept
+{
+    if (!spell || spell != LocalApocalypseForm(ApocalypseVolcano::LavaSpell)) return 0;
+    if (s_immediateBlame) return s_immediateBlame;
+    std::lock_guard<std::mutex> lock(s_sourcesLock);
+    auto i = s_sources.find(shooter);
+    if (i == s_sources.end() || i->second.Expires < std::chrono::steady_clock::now()) return 0;
+    return i->second.Blame;
+}
+VolcanoService::VolcanoService(World& w, entt::dispatcher& d, TransportService& t) : m_world(w), m_transport(t)
+{
+    m_update = d.sink<UpdateEvent>().connect<&VolcanoService::OnUpdate>(this);
+    m_notify = d.sink<NotifyWorldItem>().connect<&VolcanoService::OnNotify>(this);
+    m_disconnect = d.sink<DisconnectedEvent>().connect<&VolcanoService::OnDisconnect>(this);
+    m_papyrus = d.sink<PapyrusFunctionRegisterEvent>().connect<&VolcanoService::OnPapyrus>(this);
+}
+void VolcanoService::OnPapyrus(const PapyrusFunctionRegisterEvent& e)
+{
+    if (!s_remoteCast && e.Namespace == "Spell" && e.Name == "RemoteCast")
+    {
+        s_remoteCast = reinterpret_cast<RemoteCast*>(e.Function);
+        TP_HOOK(&s_remoteCast, HookVolcanoRemoteCast);
+        spdlog::info("Installed Apocalypse Volcano RemoteCast attribution adapter");
+    }
+}
+void VolcanoService::Send(const WorldItemData& data)
+{
+    RequestWorldItem q;
+    q.Action = WorldItemAction::VolcanoVisual;
+    q.Data = data;
+    m_transport.Send(q);
+}
+void VolcanoService::RemoveReplica(uint64_t key)
+{
+    auto i = m_replicas.find(key);
+    if (i == m_replicas.end()) return;
+    if (auto* ref = Cast<TESObjectREFR>(TESForm::GetById(i.value().FormId)))
+    {
+        ref->Disable();
+        ref->Delete();
+    }
+    m_replicaForms.erase(i.value().FormId);
+    m_replicas.erase(key);
+}
+void VolcanoService::OnDisconnect(const DisconnectedEvent&)
+{
+    Vector<uint64_t> keys;
+    for (const auto& [key, r] : m_replicas) keys.push_back(key);
+    for (auto key : keys) RemoveReplica(key);
+    m_localVisuals.clear();
+    m_timer = 0;
+    std::lock_guard<std::mutex> lock(s_sourcesLock);
+    s_sources.clear();
+}
+void VolcanoService::OnUpdate(const UpdateEvent& e)
+{
+    if (!m_transport.IsOnline()) return;
+    if (!s_remoteCast)
+        if (const void* fn = m_world.ctx().at<PapyrusService>().Get("Spell", "RemoteCast"))
+            OnPapyrus(PapyrusFunctionRegisterEvent("RemoteCast", "Spell", const_cast<void*>(fn)));
+    m_timer += e.Delta;
+    if (m_timer < 0.25) return;
+    m_timer = 0;
+    const auto now = m_world.GetTick();
+    Vector<uint64_t> expired;
+    for (const auto& [key, r] : m_replicas) if (now >= r.Expires) expired.push_back(key);
+    for (auto key : expired) RemoveReplica(key);
+    if (!LocalApocalypseForm(ApocalypseVolcano::Fountain)) return;
+    auto* tes = TES::Get();
+    if (!tes) return;
+    Vector<TESObjectCELL*> cells;
+    if (tes->interiorCell) cells.push_back(tes->interiorCell);
+    else if (tes->cells && tes->cells->arr && tes->cells->dimension <= 15)
+        for (uint32_t i = 0; i < tes->cells->dimension * tes->cells->dimension; ++i)
+            if (tes->cells->arr[i]) cells.push_back(tes->cells->arr[i]);
+    Map<uint32_t, WorldItemData> found;
+    const Vector<FormType> types{static_cast<FormType>(24), static_cast<FormType>(31)};
+    for (auto* cell : cells)
+    {
+        if (!cell->IsAttached()) continue;
+        for (auto* ref : cell->GetRefsByFormTypes(types))
+        {
+            if (!ref || !ref->baseForm || !ref->IsTemporary() || ref->IsDisabled() || ref->IsDeleted() ||
+                !IsVisual(ref->baseForm->formID) || m_replicaForms.contains(ref->formID) || found.size() >= ApocalypseVolcano::MaxVisuals) continue;
+            WorldItemData pose;
+            pose.Token = ref->formID;
+            auto& mods = m_world.GetModSystem();
+            mods.GetServerModId(ref->baseForm->formID, pose.Reference);
+            mods.GetServerModId(cell->formID, pose.Cell);
+            if (auto* ws = ref->GetWorldSpace()) mods.GetServerModId(ws->formID, pose.WorldSpace);
+            pose.X = ref->position.x; pose.Y = ref->position.y; pose.Z = ref->position.z;
+            pose.RX = ref->rotation.x; pose.RY = ref->rotation.y; pose.RZ = ref->rotation.z;
+            found.emplace(ref->formID, pose);
+            Send(pose); // Heartbeat restores late join and removes dropped-packet dependence.
+        }
+    }
+    for (const auto& [id, old] : m_localVisuals)
+        if (!found.contains(id)) { auto ended = old; ended.Consumed = true; Send(ended); }
+    m_localVisuals = std::move(found);
+}
+void VolcanoService::OnNotify(const NotifyWorldItem& n)
+{
+    if (n.Action != WorldItemAction::VolcanoVisual || !m_transport.IsOnline() ||
+        n.Data.Creator == m_transport.GetLocalPlayerId()) return;
+    const auto& data = n.Data;
+    const uint64_t key = (uint64_t(data.Creator) << 32) | data.Token;
+    if (data.Consumed) { RemoveReplica(key); return; }
+    auto& mods = m_world.GetModSystem();
+    const auto baseId = mods.GetGameId(data.Reference);
+    if (!IsVisual(baseId) || !SharedItems::ValidPose(data)) return;
+    auto* player = PlayerCharacter::Get();
+    auto* cell = Cast<TESObjectCELL>(TESForm::GetById(mods.GetGameId(data.Cell)));
+    if (!player || !cell || !cell->IsAttached()) return;
+    auto i = m_replicas.find(key);
+    TESObjectREFR* ref = i == m_replicas.end() ? nullptr : Cast<TESObjectREFR>(TESForm::GetById(i.value().FormId));
+    if (!ref)
+    {
+        if (m_replicas.size() >= ApocalypseVolcano::MaxVisuals) return;
+        const void* fn = m_world.ctx().at<PapyrusService>().Get("ObjectReference", "PlaceAtMe");
+        if (!fn) return;
+        PapyrusFunction<TESObjectREFR*, TESObjectREFR, TESForm*, int32_t, bool, bool> place(fn);
+        ref = place(player, TESForm::GetById(baseId), 1, false, true);
+        if (!ref) return;
+        NiPoint3 pos{glm::vec3(data.X, data.Y, data.Z)};
+        ref->MoveTo(cell, pos);
+        ref->SetRotation(data.RX, data.RY, data.RZ);
+        m_replicaForms.insert(ref->formID);
+        ref->Enable();
+        spdlog::info("Replicated Volcano visual {:X}, source {}:{}", baseId, data.Creator, data.Token);
+    }
+    else if (i.value().Pose.X != data.X || i.value().Pose.Y != data.Y || i.value().Pose.Z != data.Z)
+    {
+        ref->SetWorldPosition(NiPoint3{glm::vec3(data.X, data.Y, data.Z)});
+        ref->SetRotation(data.RX, data.RY, data.RZ);
+    }
+    m_replicas.insert_or_assign(key, Replica{ref->formID, m_world.GetTick() + ApocalypseVolcano::ReplicaLeaseMs, data});
+}
