+bool Actor::HasLocalRentalState() const noexcept
+{
+    const auto factions = GetFactions();
+    const auto& mods = World::Get().GetModSystem();
+    auto isInnkeeper = [&mods](const auto& entries)
+    {
+        return std::any_of(entries.begin(), entries.end(), [&mods](const auto& entry)
