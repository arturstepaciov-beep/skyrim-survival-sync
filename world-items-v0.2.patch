diff --git a/Code/server/Services/HomesteadService.cpp b/Code/server/Services/HomesteadService.cpp
new file mode 100644
index 00000000..3679ff22
--- /dev/null
+++ b/Code/server/Services/HomesteadService.cpp
@@ -0,0 +1,117 @@
+#include <Services/HomesteadService.h>
+#include <World.h>
+#include <Components.h>
+#include <GameServer.h>
+#include <Messages/RequestHomestead.h>
+#include <Messages/NotifyHomestead.h>
+#include <Messages/NotifyInventoryChanges.h>
+#include <HomesteadPolicy.h>
+#include <HomesteadInventory.h>
+#include <cmath>
+namespace
+{
+int64_t Count(const Inventory& inv, const Inventory::Entry& item)
+{
+    int64_t n{};
+    for (const auto& e : inv.Entries) if (e.CanBeMerged(item)) n += e.Count;
+    return n;
+}
+}
+HomesteadService::HomesteadService(World& w, entt::dispatcher& d) : m_world(w)
+{
+    m_request = d.sink<PacketEvent<RequestHomestead>>().connect<&HomesteadService::OnRequest>(this);
+}
+bool HomesteadService::IsShared(const GameId& id) const noexcept
+{
+    const auto i = m_records.find(id);
+    return i != m_records.end() && i->second.HasInventory;
+}
+void HomesteadService::Send(Player* p, HomesteadData data)
+{
+    data.Authority = m_authority;
+    HomesteadWire::Split(data, [p](const HomesteadData& part) { NotifyHomestead n; n.Data = part; p->Send(n); });
+}
+void HomesteadService::OnRequest(const PacketEvent<RequestHomestead>& e)
+{
+    if (e.Packet.Data.Action >= HomesteadAction::CoopPoll) return;
+    auto* p = e.pPlayer;
+    if (!p || !p->GetCharacter()) return;
+    // The earliest connected assigned player hosts this session. Never accept a guest seed.
+    uint32_t authority{};
+    for (auto* candidate : m_world.GetPlayerManager())
+        if (candidate->GetCharacter() && (!authority || candidate->GetId() < authority)) authority = candidate->GetId();
+    if (authority != m_authority)
+    {
+        m_records.clear(); m_tokens.clear(); m_assembler.Pending.clear(); m_authority = authority;
+    }
+    const auto& q = e.Packet.Data;
+    if (q.Action == HomesteadAction::Poll)
+    {
+        HomesteadData n; n.Action = HomesteadAction::State;
+        for (const auto& [id, record] : m_records)
+        {
+            n.Records.push_back(record);
+            if (n.Records.size() == 32) { Send(p, n); n.Records.clear(); }
+        }
+        Send(p, std::move(n));
+        return;
+    }
+    if (q.Action == HomesteadAction::Publish)
+    {
+        if (p->GetId() != m_authority || q.Records.size() > 64) return;
+        HomesteadData n; n.Action = HomesteadAction::State;
+        for (const auto& part : q.Records)
+        {
+            HomesteadRecord record; if (!m_assembler.Accept(part, record)) continue;
+            if (!record.Reference || (m_records.size() >= 16384 && !m_records.contains(record.Reference))) continue;
+            auto [i, fresh] = m_records.try_emplace(record.Reference, record);
+            if (!fresh)
+            {
+                i->second.Disabled = record.Disabled;
+                // Never reset a live shared chest from a subsequent host heartbeat.
+                if (!i->second.HasInventory && record.HasInventory) { i->second.HasInventory = true; i->second.Contents = record.Contents; }
+            }
+            n.Records.push_back(i->second);
+        }
+        if (!n.Records.empty()) for (auto* peer : m_world.GetPlayerManager()) Send(peer, n);
+        return;
+    }
+    auto i = m_records.find(q.Reference);
+    if (i == m_records.end() || !i->second.HasInventory || i->second.Disabled)
+    {
+        HomesteadData n; n.Action = HomesteadAction::Rejected; n.Token = q.Token; n.Reference = q.Reference; Send(p, std::move(n)); return;
+    }
+    auto& chest = i->second;
+    if (!p->GetCellComponent().IsInRange(CellIdComponent(chest.Cell, chest.WorldSpace, chest.Coords), false)) return;
+    if (q.Action == HomesteadAction::Open)
+    {
+        HomesteadData n; n.Action = HomesteadAction::Opened; n.Token = q.Token; n.Reference = q.Reference; n.Records.push_back(chest); Send(p, std::move(n)); return;
+    }
+    if (q.Action != HomesteadAction::Transfer || !HomesteadPolicy::FreshToken(q.Token, m_tokens[p->GetId()])) return;
+    m_tokens[p->GetId()] = q.Token;
+    auto actor = *p->GetCharacter();
+    auto* inv = m_world.try_get<InventoryComponent>(actor);
+    auto* owner = m_world.try_get<OwnerComponent>(actor);
+    if (!inv || !owner || owner->GetOwner() != p) return;
+    auto item = q.Item;
+    item.ExtraWorn = item.ExtraWornLeft = false;
+    const auto source = q.Deposit ? Count(inv->Content, item) : Count(chest.Contents, item);
+    const auto destination = q.Deposit ? Count(chest.Contents, item) : Count(inv->Content, item);
+    const bool accepted = HomesteadInventory::Supported(item) && item.EnchantData.Effects.size() <= 64 &&
+        (q.Deposit ? chest.Contents.Entries.size() : inv->Content.Entries.size()) < HomesteadWire::MaxEntries && !item.IsQuestItem && item.BaseId && std::isfinite(item.ExtraCharge) && std::isfinite(item.ExtraHealth) &&
+        HomesteadPolicy::CanTransfer(source, destination, item.Count);
+    if (accepted)
+    {
+        auto playerDelta = item; playerDelta.Count = q.Deposit ? -item.Count : item.Count;
+        auto chestDelta = playerDelta; chestDelta.Count = -playerDelta.Count;
+        inv->Content.AddOrRemoveEntry(playerDelta);
+        chest.Contents.AddOrRemoveEntry(chestDelta);
+        NotifyInventoryChanges delta;
+        delta.ServerId = World::ToInteger(actor); delta.OwnershipEpoch = owner->OwnershipEpoch; delta.Item = playerDelta;
+        // The initiating client has not mutated its inventory: include it in the commit.
+        for (auto* peer : m_world.GetPlayerManager()) peer->Send(delta);
+    }
+    HomesteadData n; n.Action = HomesteadAction::Result; n.Reference = q.Reference; n.Token = q.Token; n.Accepted = accepted; n.Records.push_back(chest);
+    if (accepted) { for (auto* peer : m_world.GetPlayerManager()) Send(peer, n); }
+    else Send(p, std::move(n));
+}
