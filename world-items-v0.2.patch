+bool Eligible(TESObjectREFR* ref)
+{
+    if (!ref || !ref->baseForm || ref->IsDeleted() || ref->IsDisabled() || ref->extraData.HasQuestObjectAlias())
+        return false;
+    switch (static_cast<uint8_t>(ref->baseForm->formType))
+    {
+    case 23:
+    case 26:
+    case 30:
+    case 32:
+    case 41:
+    case 42:
+    case 46:
+    case 52: return true;
+    default: return false;
+    }
+}
+float Difference(const WorldItemData& a, const WorldItemData& b)
+{
+    return std::abs(a.X - b.X) + std::abs(a.Y - b.Y) + std::abs(a.Z - b.Z) + 10.f * (std::abs(a.RX - b.RX) + std::abs(a.RY - b.RY) + std::abs(a.RZ - b.RZ));
+}
