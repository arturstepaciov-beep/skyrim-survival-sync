+#pragma once
+#include <cmath>
+#include <cstdint>
+
+namespace SurvivalTime
+{
+constexpr uint32_t MonthDays[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+template <class T> bool Valid(const T& t) noexcept
+{
+    return t.Year <= 10000 && t.Month < 12 && t.Day >= 1 && t.Day <= MonthDays[t.Month] && std::isfinite(t.Time) && t.Time >= 0 && t.Time < 24;
+}
+template <class T> double InDays(const T& t) noexcept
+{
+    double days = static_cast<double>(t.Year) * 365.0 + t.Day;
+    for (uint32_t m = 0; m < t.Month && m < 12; ++m)
+        days += MonthDays[m];
+    return days + static_cast<double>(t.Time) / 24.0;
+}
+// Return only the remaining distance to the desired wake-up time. Replayed or
+// overlapping requests never add the full requested duration a second time.
+template <class T> float HoursToTarget(const T& current, const T& target) noexcept
+{
+    if (!Valid(current) || !Valid(target))
+        return 0.f;
+    const double hours = (InDays(target) - InDays(current)) * 24.0;
+    if (!std::isfinite(hours) || hours <= 0.0 || hours > 24.01)
+        return 0.f;
+    return static_cast<float>(hours);
+}
+} // namespace SurvivalTime
diff --git a/Code/common/WorldItemPolicy.h b/Code/common/WorldItemPolicy.h
new file mode 100644
index 00000000..cc774ebe
--- /dev/null
+++ b/Code/common/WorldItemPolicy.h
@@ -0,0 +1,52 @@
+#pragma once
+#include <cstdint>
+#include <cmath>
+#include <initializer_list>
+namespace SharedItems
+{
+struct Claim
+{
+    uint32_t Owner{};
+    uint64_t LeaseUntil{};
+    bool Consumed{};
+    bool Grab(uint32_t player, uint64_t now) noexcept
+    {
+        if (Consumed || !player || (Owner && Owner != player && now < LeaseUntil))
+            return false;
+        Owner = player;
+        LeaseUntil = now + 1500;
+        return true;
+    }
+    bool Move(uint32_t player, uint64_t now) noexcept
+    {
+        if (Consumed || !player || Owner != player)
+            return false;
+        LeaseUntil = now + 1500;
+        return true;
+    }
+    bool Release(uint32_t player) noexcept
+    {
+        if (Consumed || !player || Owner != player)
+            return false;
+        Owner = 0;
+        LeaseUntil = 0;
+        return true;
+    }
+    bool Pickup(uint32_t player) noexcept
+    {
+        if (Consumed || !player)
+            return false;
+        Consumed = true;
+        Owner = 0;
+        LeaseUntil = 0;
+        return true;
+    }
+};
+template <class T> bool ValidPose(const T& d) noexcept
+{
+    for (float v : {d.X, d.Y, d.Z, d.RX, d.RY, d.RZ})
+        if (!std::isfinite(v) || std::abs(v) > 10000000.f)
+            return false;
+    return true;
+}
+} // namespace SharedItems
