diff --git a/Code/common/HearthfireIndex.h b/Code/common/HearthfireIndex.h
new file mode 100644
index 00000000..4c381e59
--- /dev/null
+++ b/Code/common/HearthfireIndex.h
@@ -0,0 +1,45 @@
+#pragma once
+#include <filesystem>
+#include <fstream>
+#include <unordered_set>
+#include <cstring>
+#include <cstdint>
+namespace HearthfireIndex
+{
+// Read only record headers from the installed master. No Bethesda assets are shipped.
+// GRUP sizes include their 24-byte header; all other sizes exclude the header.
+inline bool ReadReferenceIndex(const std::filesystem::path& path, uint32_t prefix, std::unordered_set<uint32_t>& out)
+{
+    std::ifstream file(path, std::ios::binary);
+    if (!file) return false;
+    file.seekg(0, std::ios::end); const auto length = file.tellg(); file.seekg(0);
+    uint32_t masters{};
+    while (file && file.tellg() >= 0 && file.tellg() + std::streamoff(24) <= length)
+    {
+        char header[24]{}; file.read(header, 24);
+        uint32_t size{}, id{}; std::memcpy(&size, header + 4, 4); std::memcpy(&id, header + 12, 4);
+        if (std::memcmp(header, "GRUP", 4) == 0)
+        {
+            if (size < 24 || file.tellg() + std::streamoff(size - 24) > length) return false;
+            continue;
+        }
+        const auto end = file.tellg() + std::streamoff(size);
+        if (end > length || size > 128 * 1024 * 1024) return false;
+        if (std::memcmp(header, "TES4", 4) == 0)
+        {
+            while (file && file.tellg() + std::streamoff(6) <= end)
+            {
+                char name[4]; uint16_t subSize{};
+                file.read(name, 4); file.read(reinterpret_cast<char*>(&subSize), 2);
+                if (file.tellg() + std::streamoff(subSize) > end) return false;
+                if (std::memcmp(name, "MAST", 4) == 0) ++masters;
+                file.seekg(subSize, std::ios::cur);
+            }
+        }
+        else if (std::memcmp(header, "REFR", 4) == 0 && (id >> 24) == masters)
+            out.insert(prefix | (id & 0xFFFFFF));
+        file.seekg(end);
+    }
+    return file && file.tellg() == length && !out.empty();
+}
+}
diff --git a/Code/common/HomesteadInventory.h b/Code/common/HomesteadInventory.h
new file mode 100644
index 00000000..bc876f72
--- /dev/null
+++ b/Code/common/HomesteadInventory.h
@@ -0,0 +1,38 @@
+#pragma once
+#include <Structs/Inventory.h>
+#include <cstdint>
+namespace HomesteadInventory
+{
+inline bool Supported(const Inventory::Entry& e)
+{
+    return bool(e.BaseId) && e.BaseId.ModId != UINT32_MAX && e.ExtraEnchantId.ModId != UINT32_MAX &&
+           e.ExtraPoisonId.ModId != UINT32_MAX && !e.IsQuestItem;
+}
+inline Inventory SharedPart(const Inventory& original)
+{
+    Inventory result;
+    for (const auto& e : original.Entries) if (Supported(e) && e.Count > 0) result.AddOrRemoveEntry(e);
+    return result;
+}
+// Return precise variant deltas. Never clear a whole inventory: locally generated
+// forms and quest items cannot safely be removed and reconstructed from GameIds.
+inline Inventory Difference(const Inventory& current, const Inventory& desired)
+{
+    auto before = SharedPart(current); auto after = SharedPart(desired);
+    Inventory result;
+    for (const auto& entry : before.Entries)
+    {
+        int64_t target{};
+        for (const auto& e : after.Entries) if (e.CanBeMerged(entry)) target += e.Count;
+        const int64_t delta = target - entry.Count;
+        if (delta) { auto change = entry; change.Count = static_cast<int32_t>(delta); result.Entries.push_back(change); }
+    }
+    for (const auto& entry : after.Entries)
+    {
+        bool found{};
+        for (const auto& e : before.Entries) if (e.CanBeMerged(entry)) { found = true; break; }
+        if (!found) result.Entries.push_back(entry);
+    }
+    return result;
+}
+}
