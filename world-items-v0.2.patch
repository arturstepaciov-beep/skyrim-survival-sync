diff --git a/Tests/survival_time.cpp b/Tests/survival_time.cpp
new file mode 100644
index 00000000..27c10fd3
--- /dev/null
+++ b/Tests/survival_time.cpp
@@ -0,0 +1,36 @@
+#include "../Code/common/SurvivalTimePolicy.h"
+#include <cassert>
+#include <limits>
+#include <iostream>
+struct Clock
+{
+    unsigned Year = 201, Month = 7, Day = 17;
+    float Time = 20.f;
+};
+int main()
+{
+    using namespace SurvivalTime;
+    Clock now, target{201, 7, 18, 4};
+    assert(std::abs(HoursToTarget(now, target) - 8.f) < 0.001f);
+    now = target;
+    assert(HoursToTarget(now, target) == 0); // duplicate / second sleeper
+    Clock longer{201, 7, 18, 8};
+    assert(std::abs(HoursToTarget(now, longer) - 4.f) < 0.001f);
+    assert(HoursToTarget(longer, target) == 0);            // out-of-order packet
+    assert(HoursToTarget(now, Clock{201, 7, 20, 4}) == 0); // over 24h
+    assert(std::abs(HoursToTarget(Clock{201, 11, 31, 23}, Clock{202, 0, 1, 1}) - 2.f) < 0.001f);
+    assert(std::abs(HoursToTarget(Clock{201, 1, 28, 23}, Clock{201, 2, 1, 1}) - 2.f) < 0.001f);
+    assert(HoursToTarget(now, Clock{201, 12, 1, 4}) == 0);
+    assert(HoursToTarget(now, Clock{201, 1, 30, 4}) == 0);
+    assert(HoursToTarget(now, Clock{201, 7, 18, std::numeric_limits<float>::quiet_NaN()}) == 0);
+    assert(HoursToTarget(now, Clock{201, 7, 18, std::numeric_limits<float>::infinity()}) == 0);
+    assert(HoursToTarget(now, Clock{201, 7, 18, -1}) == 0);
+    // FPS-independent policy: the same wake target yields the same final time.
+    for (int fps : {20, 30, 60, 120, 144})
+    {
+        Clock start{201, 7, 17, 20.f + 1.f / fps};
+        const auto hours = HoursToTarget(start, target);
+        assert(std::abs(InDays(start) + hours / 24.0 - InDays(target)) < 1e-7);
+    }
+    std::cout << "PASS: overlapping sleeps, replay, out-of-order requests, midnight/year/month rollover, invalid requests and frame rates\n";
+}
diff --git a/Tests/world_items.cpp b/Tests/world_items.cpp
new file mode 100644
index 00000000..1f826732
--- /dev/null
+++ b/Tests/world_items.cpp
@@ -0,0 +1,53 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include "../Code/common/WorldItemPolicy.h"
+#include <cassert>
+#include <iostream>
+#include <limits>
+#include <array>
+struct Pose
+{
+    float X{}, Y{}, Z{}, RX{}, RY{}, RZ{};
+};
+int main()
+{
+    using SharedItems::Claim;
+    Claim a;
+    assert(a.Grab(1, 100));
+    assert(!a.Grab(2, 200));
+    assert(!a.Move(2, 300));
+    assert(a.Move(1, 300));
+    assert(!a.Grab(2, 1700));
+    assert(a.Grab(2, 1800));
+    assert(!a.Release(1));
+    assert(a.Release(2));
+    assert(a.Grab(1, 2000));
+    assert(a.Pickup(2));
+    assert(!a.Pickup(1));
+    assert(!a.Pickup(2));
+    assert(!a.Grab(1, 999999));
+    assert(!a.Move(2, 999999));
+    for (int first : {1, 2})
+    {
+        Claim r;
+        int granted = 0;
+        for (int retry = 0; retry < 1000; ++retry)
+        {
+            granted += r.Pickup(first);
+            granted += r.Pickup(3 - first);
+        }
+        assert(granted == 1);
+    }
+    Pose p;
+    assert(SharedItems::ValidPose(p));
+    p.X = std::numeric_limits<float>::quiet_NaN();
+    assert(!SharedItems::ValidPose(p));
+    p.X = 0;
+    p.RY = std::numeric_limits<float>::infinity();
+    assert(!SharedItems::ValidPose(p));
+    p.RY = 0;
+    p.Z = 1e8;
+    assert(!SharedItems::ValidPose(p));
+    std::cout << "PASS: exclusive grab, lease expiry, stale movement/release, competing pickup, replay, consumed tombstone, invalid pose\n";
+}
