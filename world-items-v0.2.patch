+bool Structure(const TESObjectREFR* ref)
+{
+    if (!ref || !ref->baseForm || ref->IsDeleted() || ref->IsTemporary()) return false;
+    // Placed architecture, enable-parent markers, furniture, lights, doors and containers.
+    // Actors, loose loot and script activators retain their existing synchronization paths.
+    const auto type = static_cast<uint8_t>(ref->baseForm->formType);
+    return type == 28 || type == 29 || type == 31 || type == 34 || type == 36 || type == 40;
+}
+}
+HomesteadService::HomesteadService(World& w, entt::dispatcher& d, TransportService& t) : m_world(w), m_transport(t)
+{
