+struct TESObjectREFR;
+struct CellChangeEvent;
+class WorldItemService : public BSTEventSink<TESGrabReleaseEvent>
+{
+public:
+    WorldItemService(World&, entt::dispatcher&, TransportService&);
+    void Resync();
+    void SetAutoResync(bool enabled) { m_autoResync = enabled; m_autoResyncTimer = 0; }
+    [[nodiscard]] bool IsAutoResyncEnabled() const noexcept { return m_autoResync; }
+    [[nodiscard]] int GetAutoResyncSeconds() const noexcept
+    {
+        return PresentationSyncPolicy::SecondsRemaining(m_resyncInterval, m_autoResyncTimer);
+    }
+    void SetResyncInterval(int seconds);
+    void SetResyncHotkey(int key);
+    bool TryPickup(TESObjectREFR*);
+    bool IsTracked(TESObjectREFR*) const;
+
+private:
+    struct Local
+    {
+        WorldItemData Data;
+        WorldItemData AppliedPose;
+        bool HasAppliedPose{};
+        uint32_t FormId{};
+        float StillTime{};
+        float HeartbeatTime{};
+        bool WasGrabbed{};
+        uint32_t MotionOwner = 0xFFFFFFFF;
+        bool NewlyCreated = true;
+    };
+    World& m_world;
+    TransportService& m_transport;
+    Map<uint32_t, Local> m_items;
+    Map<uint32_t, WorldItemData> m_pendingDrops;
+    Map<uint32_t, WorldItemData> m_observedProps;
+    void ObservePhysics();
+    bool m_autoResync{};
+    double m_autoResyncTimer{};
+    double m_resyncInterval = 10.0;
+    int m_resyncHotkey{};
+    bool m_resyncKeyDown{};
+    uint64_t m_nextResyncTick{};
+    uint32_t m_dropCounter{};
+    uint32_t m_grabbedFormId{};
+    TESObjectREFR* Grabbed() const;
+    BSTEventResult OnEvent(const TESGrabReleaseEvent*, const EventDispatcher<TESGrabReleaseEvent>*) override;
+    double m_timer{}, m_snapshotTimer{}, m_physicsScanTimer{};
+    entt::scoped_connection m_update, m_notify, m_drop, m_disconnect, m_cell;
+    void OnUpdate(const UpdateEvent&);
+    void OnNotify(const NotifyWorldItem&);
+    void OnDrop(const WorldItemDropEvent&);
+    void OnDisconnect(const DisconnectedEvent&);
+    void OnCell(const CellChangeEvent&);
+    WorldItemData Describe(TESObjectREFR*) const;
+    void Send(WorldItemAction, const WorldItemData&);
+    void Materialize(Local&);
+};
