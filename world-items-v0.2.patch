+void OverlayService::OnUpdate(const UpdateEvent&) noexcept
+{
+    // Publish the actual scheduler state, even while the interaction overlay is closed.
+    // A heartbeat also restores the indicator after a browser reload.
+    if (m_pOverlay)
+    {
+        const auto& sync = m_world.ctx().at<WorldItemService>();
+        const int seconds = m_transport.IsOnline() && sync.IsAutoResyncEnabled()
+            ? sync.GetAutoResyncSeconds() : -1;
+        const auto now = std::chrono::steady_clock::now();
+        if (seconds != m_lastResyncSeconds || now - m_lastResyncHudUpdate >= std::chrono::seconds(1))
+        {
+            auto arguments = CefListValue::Create();
+            arguments->SetInt(0, seconds);
+            m_pOverlay->ExecuteAsync("resyncCountdown", arguments);
+            m_lastResyncSeconds = seconds;
+            m_lastResyncHudUpdate = now;
+        }
+    }
+    RunDebugDataUpdates();
+    RunPlayerHealthUpdates();
+}
