diff --git a/Tests/coop_chest_store.cpp b/Tests/coop_chest_store.cpp
new file mode 100644
index 00000000..1937c99f
--- /dev/null
+++ b/Tests/coop_chest_store.cpp
@@ -0,0 +1,70 @@
+#include <cstdlib>
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+#include <iostream>
+#include <TiltedCore/Buffer.hpp>
+namespace TiltedPhoques { using String = std::string; template<class T> using Vector = std::vector<T>; }
+#include "../Code/common/CoopChestStore.h"
+#include "../Code/common/CoopChestLocations.h"
+#include "../Code/common/HomesteadPolicy.h"
+
+// Standalone definitions for ID identity; the disk codec uses no network serializer.
+GameId::GameId(uint32_t mod, uint32_t base) noexcept : BaseId(base), ModId(mod) {}
+bool GameId::operator==(const GameId& other) const noexcept { return BaseId == other.BaseId && ModId == other.ModId; }
+bool GameId::operator!=(const GameId& other) const noexcept { return !(*this == other); }
+GameId::operator bool() const noexcept { return BaseId != 0 || ModId != 0; }
+
+// Always evaluate checks, including in release builds where NDEBUG is defined.
+#define CHECK(condition) do { if (!(condition)) { std::cerr << "FAIL line " << __LINE__ << ": " << #condition << std::endl; std::exit(1); } } while (false)
+
+int main()
+{
+    CoopChestStore::NameOf names = [](uint32_t id) -> std::optional<std::string>
+    { if (id == 4) return "Skyrim.esm"; if (id == 17) return "Enchantments.esp"; return {}; };
+    CoopChestStore::Resolve remap = [](const std::string& name, uint32_t base) -> std::optional<GameId>
+    { if (name == "Skyrim.esm") return GameId(9, base); if (name == "Enchantments.esp") return GameId(3, base); return {}; };
+    Inventory source;
+    Inventory::Entry sword; sword.BaseId = GameId(4, 0x1234); sword.Count = 6; sword.ExtraHealth = 1.3f; sword.ExtraCharge = 27.25f;
+    sword.ExtraEnchantId = GameId(17, 0x810); sword.ExtraEnchantCharge = 500; sword.EnchantData.IsWeapon = true;
+    Inventory::EffectItem effect; effect.EffectId = GameId(17, 0x811); effect.Magnitude = 12.5f; effect.Area = 10; effect.Duration = 30; effect.RawCost = 4.25f;
+    sword.EnchantData.Effects.push_back(effect); sword.ExtraPoisonId = GameId(4, 0x55); sword.ExtraPoisonCount = 2;
+    sword.ExtraSoulLevel = 4; sword.ExtraEnchantRemoveUnequip = true; source.Entries.push_back(sword);
+    auto bytes = CoopChestStore::Encode(source, names); CHECK(bytes);
+    Inventory decoded; CHECK(CoopChestStore::Decode(*bytes, remap, decoded));
+    CHECK(decoded.Entries.size() == 1 && decoded.Entries[0].BaseId == GameId(9, 0x1234));
+    CHECK(decoded.Entries[0].ExtraEnchantId == GameId(3, 0x810));
+    CHECK(decoded.Entries[0].EnchantData.Effects[0].EffectId == GameId(3, 0x811));
+    CHECK(decoded.Entries[0].Count == 6 && decoded.Entries[0].ExtraPoisonCount == 2);
+    auto newNames = [](uint32_t id) -> std::optional<std::string>
+    { if (id == 9) return "Skyrim.esm"; if (id == 3) return "Enchantments.esp"; return {}; };
+    auto roundtrip = CoopChestStore::Encode(decoded, newNames); CHECK(roundtrip && *roundtrip == *bytes);
+    auto unchanged = decoded.Entries[0].Count;
+    auto missing = [](const std::string&, uint32_t) -> std::optional<GameId> { return {}; };
+    CHECK(!CoopChestStore::Decode(*bytes, missing, decoded)); CHECK(decoded.Entries[0].Count == unchanged);
+    for (size_t cut = 0; cut < bytes->size(); ++cut)
+    { CoopChestStore::Bytes truncated(bytes->begin(), bytes->begin() + cut); CHECK(!CoopChestStore::Decode(truncated, remap, decoded)); }
+    auto damaged = *bytes; damaged[20] ^= 0x10; CHECK(!CoopChestStore::Decode(damaged, remap, decoded));
+    Inventory bad = source; bad.Entries[0].Count = -1; CHECK(!CoopChestStore::Encode(bad, names));
+    bad = source; bad.Entries[0].ExtraWorn = true; CHECK(!CoopChestStore::Encode(bad, names));
+    bad = source; bad.Entries[0].IsQuestItem = true; CHECK(!CoopChestStore::Encode(bad, names));
+    bad = source; bad.Entries[0].BaseId.ModId = UINT32_MAX; CHECK(!CoopChestStore::Encode(bad, names));
+    bad = source; bad.Entries[0].EnchantData.Effects.resize(65); CHECK(!CoopChestStore::Encode(bad, names));
+    Inventory empty; auto emptyBytes = CoopChestStore::Encode(empty, names); CHECK(emptyBytes);
+    CHECK(CoopChestStore::Decode(*emptyBytes, remap, empty));
+    auto directory = std::filesystem::temp_directory_path() / ("coop-store-test-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    auto path = directory / "CoopChest.dat";
+    CHECK(CoopChestStore::Save(path, *bytes)); auto read = CoopChestStore::Read(path); CHECK(read && *read == *bytes);
+    CHECK(CoopChestStore::Save(path, *emptyBytes)); read = CoopChestStore::Read(path); CHECK(read && *read == *emptyBytes);
+    // A blocked replacement must leave the previous durable data intact.
+    std::filesystem::create_directory(path.string() + ".tmp");
+    CHECK(!CoopChestStore::Save(path, *bytes)); read = CoopChestStore::Read(path); CHECK(read && *read == *emptyBytes);
+    std::filesystem::remove_all(directory);
+    CHECK(CoopChests::Locations.size() == 10);
+    int64_t lastItem = 1; CHECK(HomesteadPolicy::CanTransfer(lastItem, 0, 1)); --lastItem;
+    CHECK(!HomesteadPolicy::CanTransfer(lastItem, 0, 1)); // competing last-item withdrawal
+    CHECK(!HomesteadPolicy::FreshToken(12, 12));
+    std::cout << "PASS: persistent variants, changed mod IDs, missing plugins, truncation/corruption, failed replacement, competing withdrawal, replay\n";
+}
