+#pragma once
+#include <cstdint>
+#include <limits>
+namespace HomesteadPolicy
+{
+// Transfer exact variants, never base-id-only matches. Reject overflow and negatives.
+inline bool CanTransfer(int64_t source, int64_t destination, int64_t amount) noexcept
+{
+    return amount > 0 && amount <= 32767 && source >= amount && destination >= 0 &&
+           destination <= std::numeric_limits<int32_t>::max() - amount;
+}
+inline bool FreshToken(uint32_t token, uint32_t previous) noexcept { return token != 0 && token > previous; }
+}
diff --git a/Code/common/HomesteadWire.h b/Code/common/HomesteadWire.h
new file mode 100644
index 00000000..3cd072cc
--- /dev/null
+++ b/Code/common/HomesteadWire.h
@@ -0,0 +1,56 @@
+#pragma once
+#include <Structs/HomesteadData.h>
+#include <unordered_map>
+namespace HomesteadWire
+{
+constexpr size_t MaxEntries = 4096;
+constexpr size_t ChunkEntries = 8;
+inline bool ValidInventory(const Inventory& inv)
+{
+    if (inv.Entries.size() > MaxEntries) return false;
+    for (const auto& e : inv.Entries) if (e.Count < 0 || e.EnchantData.Effects.size() > 64) return false;
+    return true;
+}
+template<class Send> void Split(const HomesteadData& data, Send send)
+{
+    if (data.Records.empty()) { send(data); return; }
+    for (const auto& record : data.Records)
+    {
+        if (!ValidInventory(record.Contents)) continue;
+        const auto total = record.HasInventory ? record.Contents.Entries.size() : 0;
+        size_t offset{};
+        do
+        {
+            HomesteadData packet = data; packet.Records.clear();
+            HomesteadRecord part = record; part.Contents.Entries.clear();
+            part.InventoryOffset = static_cast<uint32_t>(offset); part.InventoryTotal = static_cast<uint32_t>(total);
+            const auto end = std::min(total, offset + ChunkEntries);
+            for (size_t i = offset; i < end; ++i) part.Contents.Entries.push_back(record.Contents.Entries[i]);
+            packet.Records.push_back(std::move(part)); send(packet);
+            offset = end;
+        } while (offset < total);
+    }
+}
+struct Assembler
+{
+    std::unordered_map<GameId, HomesteadRecord> Pending;
+    bool Accept(const HomesteadRecord& part, HomesteadRecord& out)
+    {
+        if (!part.HasInventory) { out = part; return true; }
+        if (part.InventoryTotal > MaxEntries || part.Contents.Entries.size() > ChunkEntries || !ValidInventory(part.Contents)) return false;
+        if (part.InventoryOffset == 0)
+        {
+            if (Pending.size() >= 16384) return false;
+            auto initial = part; initial.Contents.Entries.clear();
+            Pending.insert_or_assign(part.Reference, std::move(initial));
+        }
+        auto it = Pending.find(part.Reference);
+        if (it == Pending.end() || it->second.InventoryTotal != part.InventoryTotal || it->second.Contents.Entries.size() != part.InventoryOffset) return false;
+        auto& full = it->second;
+        if (full.Contents.Entries.size() + part.Contents.Entries.size() > part.InventoryTotal) { Pending.erase(it); return false; }
+        full.Contents.Entries.insert(full.Contents.Entries.end(), part.Contents.Entries.begin(), part.Contents.Entries.end());
+        if (full.Contents.Entries.size() != part.InventoryTotal) return false;
+        out = std::move(full); out.InventoryOffset = 0; Pending.erase(it); return true;
+    }
+};
+}
