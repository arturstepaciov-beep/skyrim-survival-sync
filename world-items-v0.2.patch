+VolcanoService::VolcanoService(World& w, entt::dispatcher& d) : m_world(w)
+{
+    m_request = d.sink<PacketEvent<RequestWorldItem>>().connect<&VolcanoService::OnRequest>(this);
+}
+void VolcanoService::OnRequest(const PacketEvent<RequestWorldItem>& e)
+{
+    const auto& q = e.Packet;
+    auto* player = e.pPlayer;
+    if (q.Action != WorldItemAction::VolcanoVisual || !player || !player->GetCharacter() ||
+        !q.Data.Token || !q.Data.Cell || !ApocalypseVolcano::IsVisual(q.Data.Reference.BaseId) || !SharedItems::ValidPose(q.Data)) return;
+    const auto& source = player->GetCellComponent();
+    // Ephemeral, cosmetic-only: never enters world item/inventory records or executes a controller.
+    if (source.IsInInteriorCell() ? (q.Data.WorldSpace || source.Cell != q.Data.Cell) : source.WorldSpaceId != q.Data.WorldSpace) return;
+    NotifyWorldItem n;
+    n.Action = WorldItemAction::VolcanoVisual;
+    n.Data = q.Data;
+    n.Data.Creator = player->GetId();
+    n.Data.Item = {}; // No inventory payload may cross into the cosmetic path.
+    for (auto* recipient : m_world.GetPlayerManager())
+    {
+        if (recipient == player) continue;
+        const auto& dest = recipient->GetCellComponent();
+        if (dest.IsInInteriorCell() ? (!n.Data.WorldSpace && dest.Cell == n.Data.Cell) :
+            (dest.WorldSpaceId == n.Data.WorldSpace && std::abs(double(n.Data.X) - double(dest.CenterCoords.X) * 4096) < 20000 &&
+             std::abs(double(n.Data.Y) - double(dest.CenterCoords.Y) * 4096) < 20000)) recipient->Send(n);
+    }
+}
