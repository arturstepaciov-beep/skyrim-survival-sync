+            return entry.Rank >= 0 && mods.GetGameId(entry.Id) == 0x5091B; // Skyrim.esm JobInnkeeperFaction
+        });
+    };
+    return isInnkeeper(factions.NpcFactions) || isInnkeeper(factions.ExtraFactions);
