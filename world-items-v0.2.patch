index 00000000..1f974648
--- /dev/null
+++ b/.github/workflows/survival-windows.yml
@@ -0,0 +1,32 @@
+name: Build Survival Sync Windows package
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  survival-logic-tests:
+    runs-on: windows-2022
+    steps:
+      - uses: actions/checkout@v4
+      - name: Compile and run survival logic tests with MSVC
+        shell: cmd
+        run: |
+          call "C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat"
+          if errorlevel 1 exit /b 1
+          cl /nologo /std:c++20 /EHsc /W4 /WX Tests\survival_time.cpp /Fe:survival-time-test.exe
+          if errorlevel 1 exit /b 1
+          survival-time-test.exe
+          if errorlevel 1 exit /b 1
+          cl /nologo /std:c++20 /EHsc /W4 /WX /I Tests\stubs /I Code Tests\date_time.cpp Code\common\DateTime.cpp /Fe:date-time-test.exe
+          if errorlevel 1 exit /b 1
+          date-time-test.exe
+          if errorlevel 1 exit /b 1
+  windows-package:
+    needs: survival-logic-tests
+    uses: ./.github/workflows/windows.yml
+    with:
+      build-mode: releasedbg
+      upload-build-for-next-job: true
