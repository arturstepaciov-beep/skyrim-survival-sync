+TESObjectREFR* TESObjectREFR::SpawnWorldCopy(const Inventory::Entry& aItem) const noexcept
+{
+    using ObjectReference = TESObjectREFR;
+    auto& registry = World::Get().ctx().at<PapyrusService>();
+    const void* fn = registry.Get("ObjectReference", "PlaceAtMe");
+    if (!fn)
+        return nullptr;
+    PapyrusFunction<TESObjectREFR*, ObjectReference, TESForm*, int32_t, bool, bool> place(fn);
+    TESForm* base = TESForm::GetById(World::Get().GetModSystem().GetGameId(aItem.BaseId));
+    if (!base)
+        return nullptr;
+    TESObjectREFR* ref = place(this, base, 1, false, false);
+    if (!ref)
+        return nullptr;
+    if (auto* extra = GetExtraDataFromItem(aItem))
+    {
+        while (extra->data)
+        {
+            auto* node = extra->data;
+            extra->data = node->next;
+            node->next = nullptr;
+            ref->extraData.Add(node->GetType(), node);
+        }
+        if (extra->bitfield)
+            Memory::Delete(extra->bitfield);
+        Memory::Delete(extra);
+    }
+    if (aItem.Count > 1)
+    {
+        if (auto* existing = Cast<ExtraCount>(ref->extraData.GetByType(ExtraDataType::Count)))
+            existing->count = static_cast<int16_t>(aItem.Count);
+        else
+        {
+            POINTER_SKYRIMSE(void*, countVtable, 186679);
+            auto* count = Memory::Allocate<ExtraCount>();
+            std::memset(count, 0, sizeof(ExtraCount));
+            *reinterpret_cast<void**>(count) = countVtable.Get();
+            count->count = static_cast<int16_t>(aItem.Count);
+            ref->extraData.Add(ExtraDataType::Count, count);
+        }
+    }
+    return ref;
+}
