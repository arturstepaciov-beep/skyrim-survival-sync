+TEST_CASE("Shared network chest transfers retain portal and commit identity", "[encoding.coopchest]")
+{
+    for (auto action : {HomesteadAction::CoopPoll, HomesteadAction::CoopOpen, HomesteadAction::CoopTransfer})
+    {
+        RequestHomestead request; request.Data.Action = action; request.Data.Token = 1234;
+        request.Data.Reference = GameId(CoopChests::VirtualMod, 10);
+        request.Data.Deposit = true; request.Data.Item.BaseId = GameId(0, 0x123); request.Data.Item.Count = 17;
+        Buffer buffer(4096); Buffer::Writer writer(&buffer); request.Serialize(writer);
+        Buffer::Reader reader(&buffer); ClientMessageFactory factory; auto message = factory.Extract(reader); REQUIRE(message);
+        auto decoded = CastUnique<RequestHomestead>(std::move(message));
+        REQUIRE(decoded->Data.Action == action); REQUIRE(decoded->Data.Token == 1234);
+        REQUIRE(decoded->Data.Reference == request.Data.Reference); REQUIRE(decoded->Data.Item == request.Data.Item);
+    }
+    HomesteadData state; state.Action = HomesteadAction::CoopOpened; state.Token = 1234; state.Accepted = true;
+    HomesteadRecord shared; shared.Reference = GameId(CoopChests::VirtualMod, 0); shared.HasInventory = true;
+    for (uint32_t i = 1; i <= 33; ++i) { Inventory::Entry item; item.BaseId = GameId(0, i); item.Count = i; shared.Contents.Entries.push_back(item); }
+    state.Records.push_back(shared); HomesteadWire::Assembler assembler; size_t complete{};
+    HomesteadWire::Split(state, [&](const HomesteadData& chunk) {
+        NotifyHomestead notify; notify.Data = chunk; Buffer buffer(32768); Buffer::Writer writer(&buffer); notify.Serialize(writer);
+        Buffer::Reader reader(&buffer); ServerMessageFactory factory; auto message = factory.Extract(reader); REQUIRE(message);
+        auto decoded = CastUnique<NotifyHomestead>(std::move(message));
+        REQUIRE(decoded->Data.Action == HomesteadAction::CoopOpened); REQUIRE(decoded->Data.Token == 1234);
+        HomesteadRecord full;
+        if (assembler.Accept(decoded->Data.Records.front(), full)) { ++complete; REQUIRE(full.Contents == shared.Contents); }
+    });
+    REQUIRE(complete == 1);
+}
