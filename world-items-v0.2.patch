+BSTEventResult WorldItemService::OnEvent(const TESGrabReleaseEvent* e, const EventDispatcher<TESGrabReleaseEvent>*)
+{
+    if (!e || !e->ref)
+        return BSTEventResult::kOk;
+    if (e->grabbed)
+        m_grabbedFormId = e->ref->formID;
+    else if (m_grabbedFormId == e->ref->formID)
+        m_grabbedFormId = 0;
+    spdlog::info("Shared item: {} ref={:X}", e->grabbed ? "grab" : "release", e->ref->formID);
+    return BSTEventResult::kOk;
+}
+WorldItemData WorldItemService::Describe(TESObjectREFR* ref) const
+{
+    WorldItemData data;
+    data.SourceRef = ref->formID;
+    auto& mods = m_world.GetModSystem();
+    if (!ref->IsTemporary())
+        mods.GetServerModId(ref->formID, data.Reference);
+    mods.GetServerModId(ref->baseForm->formID, data.Item.BaseId);
+    if (auto* cell = ref->GetParentCellEx())
+        mods.GetServerModId(cell->formID, data.Cell);
+    if (auto* ws = ref->GetWorldSpace())
+        mods.GetServerModId(ws->formID, data.WorldSpace);
+    data.Item.Count = std::max(1, static_cast<int32_t>(ref->extraData.GetCount()));
+    TESObjectREFR::GetItemFromExtraData(data.Item, &ref->extraData);
+    data.Item.ExtraWorn = data.Item.ExtraWornLeft = false;
+    data.X = ref->position.x;
+    data.Y = ref->position.y;
+    data.Z = ref->position.z;
+    data.RX = ref->rotation.x;
+    data.RY = ref->rotation.y;
+    data.RZ = ref->rotation.z;
+    return data;
+}
+void WorldItemService::Send(WorldItemAction a, const WorldItemData& data)
+{
+    RequestWorldItem q;
+    q.Action = a;
+    q.Data = data;
+    m_transport.Send(q);
+}
+void WorldItemService::SetResyncInterval(int seconds)
+{
+    m_resyncInterval = seconds < 1 ? 1 : seconds > 300 ? 300 : seconds;
+    m_autoResyncTimer = 0;
+}
+void WorldItemService::SetResyncHotkey(int key)
+{
+    m_resyncHotkey = key >= 0 && key <= 255 && key != VK_F2 && key != VK_ESCAPE ? key : 0;
+    m_resyncKeyDown = m_resyncHotkey && (GetAsyncKeyState(m_resyncHotkey) & 0x8000);
+}
+void WorldItemService::Resync()
+{
+    const auto now = m_world.GetTick();
+    if (!m_transport.IsOnline() || now < m_nextResyncTick)
+        return;
+    m_nextResyncTick = now + 1000;
+    m_autoResyncTimer = 0;
+    for (auto i = m_items.begin(); i != m_items.end(); ++i)
+        i.value().HasAppliedPose = false;
+    Send(WorldItemAction::Resync, {});
+    m_transport.Send(RequestCurrentWeather{});
+    spdlog::info("Client resync requested: remote actor poses, idle replay and world items");
+}
+bool WorldItemService::IsTracked(TESObjectREFR* ref) const
+{
+    if (!ref)
+        return false;
+    for (const auto& [id, l] : m_items)
+        if (l.FormId == ref->formID)
+            return true;
+    return m_pendingDrops.contains(ref->formID);
+}
+bool WorldItemService::TryPickup(TESObjectREFR* ref)
+{
+    if (!m_transport.IsOnline() || !ref || ref->IsDeleted())
+        return false;
+    if (m_pendingDrops.contains(ref->formID))
+        return true; // wait for the creation acknowledgement
+    for (const auto& [id, l] : m_items)
+        if (l.FormId == ref->formID)
+        {
+            if (!l.Data.Consumed)
+            {
+                spdlog::info("Shared item: pickup requested, item={}", id);
+                Send(WorldItemAction::Pickup, l.Data);
+            }
+            return true;
+        }
+    if (!Eligible(ref) || ref->IsTemporary())
+        return false; // unrelated, unregistered runtime spawn
+    const auto data = Describe(ref);
+    if (data.Item.IsQuestItem)
+        return false;
+    Send(WorldItemAction::Pickup, data);
+    return true;
+}
+void WorldItemService::OnDrop(const WorldItemDropEvent& e)
+{
+    if (!m_transport.IsOnline())
+        return;
+    auto* ref = Cast<TESObjectREFR>(TESForm::GetById(e.FormId));
+    if (!ref)
+        return;
+    auto data = Describe(ref);
+    data.Item = e.Item;
+    data.Token = ++m_dropCounter;
+    data.Reference = {};
+    m_pendingDrops[e.FormId] = data;
+    spdlog::info("Shared item: sending drop ref={:X} token={} count={}", e.FormId, data.Token, data.Item.Count);
+    Send(WorldItemAction::Drop, data);
+}
+void WorldItemService::Materialize(Local& l)
+{
+    auto* player = PlayerCharacter::Get();
+    if (!player)
+        return;
+    auto* cell = Cast<TESObjectCELL>(TESForm::GetById(m_world.GetModSystem().GetGameId(l.Data.Cell)));
+    if (!cell || !cell->IsAttached())
+    {
+        spdlog::debug("Shared item: waiting for attached cell, item={}", l.Data.Id);
+        return;
+    }
+    auto* ref = l.FormId ? Cast<TESObjectREFR>(TESForm::GetById(l.FormId)) : nullptr;
+    if (!ref && l.Data.Reference)
+        ref = Cast<TESObjectREFR>(TESForm::GetById(m_world.GetModSystem().GetGameId(l.Data.Reference)));
+    if (ref && ref->IsDeleted())
+        ref = nullptr;
+    if (l.Data.Consumed)
+    {
+        if (ref)
+        {
+            ref->Disable();
+            if (ref->IsTemporary() && ref != Grabbed())
+                ref->Delete();
+        }
+        l.FormId = 0;
+        return;
+    }
+    if (!ref)
+    {
+        l.NewlyCreated = true;
+        l.HasAppliedPose = false;
+        ScopedInventoryOverride guard;
+        ref = player->SpawnWorldCopy(l.Data.Item);
+        if (!ref)
+            spdlog::warn("Shared item: spawn failed, item={}", l.Data.Id);
+        else
+            spdlog::info("Shared item: created item={} ref={:X}", l.Data.Id, ref->formID);
+    }
+    if (!ref)
+        return;
+    l.FormId = ref->formID;
+    const bool owned = l.Data.Owner == m_transport.GetLocalPlayerId();
+    const bool initializeMotion = l.NewlyCreated || (owned && l.MotionOwner != l.Data.Owner);
+    const bool changedPose = !l.HasAppliedPose || l.AppliedPose.Cell != l.Data.Cell || Difference(l.AppliedPose, l.Data) > 0.5f;
+    if (l.NewlyCreated || (!owned && changedPose))
+    {
+        ref->SetRotation(l.Data.RX, l.Data.RY, l.Data.RZ);
+        NiPoint3 pos{glm::vec3(l.Data.X, l.Data.Y, l.Data.Z)};
+        // MoveTo detaches/reinserts the reference and can break its physics and
+        // activation ray. Use it only for initial placement or a cell change.
+        if (l.NewlyCreated || ref->GetParentCellEx() != cell)
+            ref->MoveTo(cell, pos);
+        else if (!ref->SetWorldPosition(pos))
+            spdlog::warn("Shared item: SetPosition unavailable, item={}", l.Data.Id);
+    }
+    if (initializeMotion)
+    {
+        ref->SetWorldMotion(true);
+        l.MotionOwner = l.Data.Owner;
+    }
+    l.AppliedPose = l.Data;
+    l.HasAppliedPose = true;
+    l.NewlyCreated = false;
+}
+void WorldItemService::OnNotify(const NotifyWorldItem& n)
+{
+    if (n.Action == WorldItemAction::VolcanoVisual) return;
+    if (!SharedItems::ValidPose(n.Data))
+        return;
+    if (n.Action == WorldItemAction::Reject)
+    {
+        if (auto i = m_pendingDrops.find(n.Data.SourceRef); i != m_pendingDrops.end() && i->second.Token == n.Data.Token)
+        {
+            if (auto* ref = Cast<TESObjectREFR>(TESForm::GetById(n.Data.SourceRef)))
+            {
+                ref->Disable();
+                ref->Delete();
+            }
+            ScopedInventoryOverride guard;
+            PlayerCharacter::Get()->AddOrRemoveItem(i->second.Item);
+            m_pendingDrops.erase(i);
+            spdlog::warn("Shared drop rejected and restored locally: {:X}", n.Data.SourceRef);
+        }
+        return;
+    }
+    if (!n.Data.Id)
+        return;
+    if (!m_items.contains(n.Data.Id))
+        spdlog::info("Shared item: received item={} creator={} count={}", n.Data.Id, n.Data.Creator, n.Data.Item.Count);
+    auto [it, inserted] = m_items.try_emplace(n.Data.Id);
+    auto& l = it.value();
+    if (inserted && n.Data.Creator == m_transport.GetLocalPlayerId() && !n.Data.Reference)
+    {
+        if (m_pendingDrops.contains(n.Data.SourceRef) && m_pendingDrops.at(n.Data.SourceRef).Token == n.Data.Token)
+        {
+            l.FormId = n.Data.SourceRef;
+            l.NewlyCreated = false;
+            m_pendingDrops.erase(n.Data.SourceRef);
+        }
+    }
+    l.Data = n.Data;
+    Materialize(l);
+}
+void WorldItemService::OnCell(const CellChangeEvent&)
+{
+    if (m_transport.IsOnline())
+        Send(WorldItemAction::Snapshot, {});
+}
+void WorldItemService::OnDisconnect(const DisconnectedEvent&)
+{
+    for (auto& [id, l] : m_items)
+        if (l.FormId && !l.Data.Reference)
+        {
+            if (auto* ref = Cast<TESObjectREFR>(TESForm::GetById(l.FormId)))
+            {
+                ref->Disable();
+                ref->Delete();
+            }
+        }
+    for (const auto& [formId, pending] : m_pendingDrops)
+    {
+        if (auto* ref = Cast<TESObjectREFR>(TESForm::GetById(formId)))
+        {
+            ref->Disable();
+            if (ref != Grabbed())
+                ref->Delete();
+        }
+    }
+    m_grabbedFormId = 0;
+    m_nextResyncTick = 0;
+    m_autoResyncTimer = 0;
+    m_items.clear();
+    m_pendingDrops.clear();
+    m_observedProps.clear();
+    m_timer = m_snapshotTimer = m_physicsScanTimer = 0;
+}
+void WorldItemService::ObservePhysics()
+{
+    auto* tes = TES::Get();
+    if (!tes)
+        return;
+    Vector<TESObjectCELL*> cells;
+    if (tes->interiorCell)
+        cells.push_back(tes->interiorCell);
+    else if (tes->cells && tes->cells->arr && tes->cells->dimension <= 15)
+        for (uint32_t i = 0; i < tes->cells->dimension * tes->cells->dimension; ++i)
+            if (tes->cells->arr[i])
+                cells.push_back(tes->cells->arr[i]);
+    Map<uint32_t, WorldItemData> observed;
+    const Vector<FormType> types{static_cast<FormType>(23), FormType::Armor, FormType::Ingredient,
+        static_cast<FormType>(32), FormType::Weapon, FormType::Ammo, FormType::Alchemy, static_cast<FormType>(52)};
+    for (auto* cell : cells)
+    {
+        if (!cell->IsAttached())
+            continue;
+        for (auto* ref : cell->GetRefsByFormTypes(types))
+        {
+            if (!Eligible(ref) || ref->IsTemporary() || IsTracked(ref) || observed.size() >= 4096)
+                continue;
+            auto pose = Describe(ref);
+            if (!pose.Reference || pose.Item.IsQuestItem)
+                continue;
+            if (auto previous = m_observedProps.find(ref->formID); previous != m_observedProps.end())
+                if (Difference(previous->second, pose) > 1.f)
+                    Send(WorldItemAction::Physics, pose);
+            observed.emplace(ref->formID, std::move(pose));
+        }
+    }
+    m_observedProps = std::move(observed);
+}
+void WorldItemService::OnUpdate(const UpdateEvent& e)
+{
+    if (!m_transport.IsOnline())
+        return;
+    if (auto* ui = UI::Get(); ui && ui->GetMenuOpen(BSFixedString("Loading Menu")))
+    {
+        m_observedProps.clear();
+        return;
+    }
+    DWORD foregroundProcess = 0;
+    GetWindowThreadProcessId(GetForegroundWindow(), &foregroundProcess);
+    const bool down = m_resyncHotkey && (GetAsyncKeyState(m_resyncHotkey) & 0x8000);
+    if (down && !m_resyncKeyDown && foregroundProcess == GetCurrentProcessId() &&
+        !m_world.ctx().at<OverlayService>().GetActive() &&
+        (!UI::Get() || (UI::Get()->numItemMenus == 0 && !UI::Get()->GetMenuOpen(BSFixedString("Console")) &&
+                       !UI::Get()->GetMenuOpen(BSFixedString("Dialogue Menu")))))
+        Resync();
+    m_resyncKeyDown = down;
+    if (m_autoResync)
+    {
+        m_autoResyncTimer += e.Delta;
+        if (m_autoResyncTimer >= m_resyncInterval)
+        {
+            m_autoResyncTimer = 0;
+            Resync();
+        }
+    }
+    m_timer += e.Delta;
+    m_physicsScanTimer += e.Delta;
+    m_snapshotTimer += e.Delta;
+    if (m_snapshotTimer >= 3)
+    {
+        m_snapshotTimer = 0;
+        Send(WorldItemAction::Snapshot, {});
+    }
+    if (m_timer < 1.0 / 15.0)
+        return;
+    const float dt = static_cast<float>(m_timer);
+    m_timer = 0;
+    if (m_physicsScanTimer >= 0.1)
+    {
+        m_physicsScanTimer = 0;
+        ObservePhysics();
+    }
+    auto* grabbed = Grabbed();
+    bool foundGrab = false;
+    for (auto itemIt = m_items.begin(); itemIt != m_items.end(); ++itemIt)
+    {
+        auto& l = itemIt.value();
+        if (l.Data.Consumed)
+            continue;
+        if (!l.FormId)
+        {
+            Materialize(l);
+            continue;
+        }
+        auto* ref = Cast<TESObjectREFR>(TESForm::GetById(l.FormId));
+        if (!ref)
+        {
+            l.FormId = 0;
+            continue;
+        }
+        const bool held = grabbed == ref;
+        foundGrab |= held;
+        if (l.Data.Owner != m_transport.GetLocalPlayerId())
+        {
+            if (held)
+                Send(WorldItemAction::Grab, l.Data);
+            else if (!l.Data.Owner && Difference(Describe(ref), l.Data) > 2.f)
+                Send(WorldItemAction::Physics, l.Data);
+            // Apply remote poses only when a new pose arrives. Repeated MoveTo
+            // calls here continually reset Havok and invalidate the activation ray.
+            continue;
+        }
+        auto pose = Describe(ref);
+        pose.Id = l.Data.Id;
+        if (!pose.Reference && !ref->IsTemporary())
+            continue;
+        if ((!pose.WorldSpace && pose.Cell != l.Data.Cell) || pose.WorldSpace != l.Data.WorldSpace)
+        {
+            Send(WorldItemAction::Release, l.Data);
+            continue;
+        }
+        const bool changed = Difference(pose, l.Data) > 0.1f;
+        l.StillTime = (held || changed) ? 0 : l.StillTime + dt;
+        l.HeartbeatTime += dt;
+        if (held || changed || l.HeartbeatTime >= 0.5f)
+        {
+            Send(WorldItemAction::Move, pose);
+            l.HeartbeatTime = 0;
+            l.Data.Cell = pose.Cell;
+            l.Data.X = pose.X;
+            l.Data.Y = pose.Y;
+            l.Data.Z = pose.Z;
+            l.Data.RX = pose.RX;
+            l.Data.RY = pose.RY;
+            l.Data.RZ = pose.RZ;
+        }
+        if (!held && l.StillTime >= 3.f)
+            Send(WorldItemAction::Release, l.Data);
+        l.WasGrabbed = held;
+    }
+    if (grabbed && !foundGrab && Eligible(grabbed) && !grabbed->IsTemporary())
+        Send(WorldItemAction::Register, Describe(grabbed));
+}
