+namespace
+{
+bool Structure(const TESObjectREFR* ref)
+{
+    if (!ref || !ref->baseForm || ref->IsDeleted() || ref->IsTemporary()) return false;
+    // Placed architecture, enable-parent markers, furniture, lights, doors and containers.
+    // Actors, loose loot and script activators retain their existing synchronization paths.
+    const auto type = static_cast<uint8_t>(ref->baseForm->formType);
+    return type == 28 || type == 29 || type == 31 || type == 34 || type == 36 || type == 40;
+}
+}
+HomesteadService::HomesteadService(World& w, entt::dispatcher& d, TransportService& t) : m_world(w), m_transport(t)
+{
+    m_update = d.sink<UpdateEvent>().connect<&HomesteadService::OnUpdate>(this);
+    m_notify = d.sink<NotifyHomestead>().connect<&HomesteadService::OnNotify>(this);
+    m_disconnect = d.sink<DisconnectedEvent>().connect<&HomesteadService::OnDisconnected>(this);
+}
+void HomesteadService::BuildIndex()
+{
+    if (m_indexReady || m_world.GetTick() < m_nextIndexAttempt) return;
+    auto* mods = ModManager::Get(); auto* mod = mods ? mods->GetByName("HearthFires.esm") : nullptr;
+    if (!mod || !mod->IsLoaded() || mod->IsLite()) return;
+    m_nextIndexAttempt = m_world.GetTick() + 5000;
+    std::error_code ec;
+    auto root = std::filesystem::current_path(ec);
+    for (int depth = 0; !ec && depth < 5 && !root.empty(); ++depth, root = root.parent_path())
+    {
+        for (const auto& path : {root / "Data" / "HearthFires.esm", root / "HearthFires.esm"})
+        {
+            std::unordered_set<uint32_t> ids;
+            if (HearthfireIndex::ReadReferenceIndex(path, uint32_t(mod->standardId) << 24, ids))
+            {
+                m_ids = std::move(ids); m_indexReady = true;
+                spdlog::info("Hearthfire: indexed {} placed references", m_ids.size()); return;
+            }
+        }
+    }
+}
+bool HomesteadService::IsManaged(TESObjectREFR* ref)
+{
+    BuildIndex();
+    return ref && ref->baseForm && ref->baseForm->formType == FormType::Container && !ref->extraData.HasQuestObjectAlias() && m_ids.contains(ref->formID);
+}
+void HomesteadService::Send(HomesteadData data)
+{
+    HomesteadWire::Split(data, [this](const HomesteadData& part) { RequestHomestead q; q.Data = part; m_transport.Send(q); });
+}
+bool HomesteadService::TryOpen(TESObjectREFR* ref)
+{
+    if (!m_transport.IsOnline() || !IsManaged(ref)) return false;
+    if (m_pendingOpen && m_world.GetTick() < m_openDeadline) return true;
+    GameId id{}; if (!m_world.GetModSystem().GetServerModId(ref->formID, id)) return true;
+    HomesteadData q; q.Action = HomesteadAction::Open; q.Reference = id; q.Token = ++m_nextToken;
+    m_pendingOpen = q.Token; m_pendingRef = ref->formID; m_openDeadline = m_world.GetTick() + 5000;
+    Send(std::move(q)); return true;
+}
+bool HomesteadService::TryTransfer(TESObjectREFR* source, TESObjectREFR* destination, TESBoundObject* base, ExtraDataList* extra, int32_t count)
+{
+    if (!m_transport.IsOnline() || ScopedInventoryOverride::IsOverriden()) return false;
+    auto* player = PlayerCharacter::Get();
+    const bool deposit = source == player && IsManaged(destination);
+    const bool withdraw = destination == player && IsManaged(source);
+    if (!deposit && !withdraw)
+    {
+        // Do not let unhandled container-to-world or container-to-NPC removal
+        // mutate a replica while the canonical stack remains spendable.
+        if (IsManaged(source) || IsManaged(destination))
+        {
+            spdlog::warn("Shared Hearthfire storage: withdraw to player inventory before dropping or forwarding items");
+            return true;
+        }
+        return false;
+    }
+    if (!base || count <= 0 || count > 32767) return true;
+    auto* chest = deposit ? destination : source;
+    HomesteadData q; q.Action = HomesteadAction::Transfer; q.Deposit = deposit; q.Token = ++m_nextToken;
+    auto& mods = m_world.GetModSystem();
+    if (!mods.GetServerModId(chest->formID, q.Reference) || !mods.GetServerModId(base->formID, q.Item.BaseId)) return true;
+    if (extra) { ScopedExtraDataOverride guard; source->GetItemFromExtraData(q.Item, extra); }
+    q.Item.Count = count;
+    if (!HomesteadInventory::Supported(q.Item))
+    {
+        spdlog::warn("Shared storage: dynamically generated forms and quest items stay local");
+        return true;
+    }
+    Send(std::move(q));
+    // Leave both inventories untouched until the server commits the exact variant.
+    return true;
+}
+void HomesteadService::OnUpdate(const UpdateEvent&)
+{
+    if (!m_transport.IsOnline()) return;
+    auto* player = PlayerCharacter::Get(); if (!player || !player->parentCell) return;
+    const auto now = m_world.GetTick();
+    if (now >= m_nextPoll)
+    {
+        m_nextPoll = now + (m_authority ? 10000 : 1000);
+        HomesteadData q; q.Action = HomesteadAction::Poll; Send(std::move(q));
+    }
+    if (now < m_nextScan) return;
+    m_nextScan = now + 1000;
+    BuildIndex();
+    if (!m_authority) return;
+    if (m_authority != m_transport.GetLocalPlayerId())
+    {
+        for (const auto& [id, record] : m_remote) Apply(record);
+        return;
+    }
+    // Apply delayed chest commits as their cells become available on the host.
+    for (const auto& [id, record] : m_remote) if (record.HasInventory) Apply(record);
+    HomesteadData q; q.Action = HomesteadAction::Publish;
+    for (uint32_t id : m_ids)
+    {
+        auto* ref = Cast<TESObjectREFR>(TESForm::GetById(id)); if (!Structure(ref)) continue;
+        const bool disabled = ref->IsDisabled();
+        const auto old = m_published.find(id);
+        if (old != m_published.end() && old->second == disabled) continue;
+        HomesteadRecord record;
+        if (!m_world.GetModSystem().GetServerModId(id, record.Reference)) continue;
+        record.Disabled = disabled;
+        auto* cell = ref->GetParentCellEx();
+        if (!cell) continue;
+        if (!m_world.GetModSystem().GetServerModId(cell->formID, record.Cell)) continue;
+        if (auto* space = ref->GetWorldSpace()) m_world.GetModSystem().GetServerModId(space->formID, record.WorldSpace);
+        record.Coords = GridCellCoords::CalculateGridCellCoords(ref->position.x, ref->position.y);
+        // A chest can be seeded only once the host has loaded its actual save inventory.
+        if (ref->baseForm->formType == FormType::Container)
+        {
+            // Quest-bound construction/resource chests must keep their native scripts.
+            if (ref->extraData.HasQuestObjectAlias()) continue;
+            if (!cell->IsAttached()) continue;
+            record.HasInventory = true; record.Contents = HomesteadInventory::SharedPart(ref->GetInventory());
+        }
+        m_published[id] = disabled;
+        if (!HomesteadWire::ValidInventory(record.Contents)) { m_published.erase(id); continue; }
+        q.Records.push_back(std::move(record));
+        if (q.Records.size() == 32) { Send(q); q.Records.clear(); }
+    }
+    if (!q.Records.empty()) Send(std::move(q));
+}
+void HomesteadService::Apply(const HomesteadRecord& record)
+{
+    auto& mods = m_world.GetModSystem();
+    const auto id = mods.GetGameId(record.Reference);
+    if (!m_ids.contains(id)) return;
+    auto* ref = Cast<TESObjectREFR>(TESForm::GetById(id)); if (!Structure(ref)) return;
+    const bool guest = m_authority != m_transport.GetLocalPlayerId();
+    auto* cell = ref->GetParentCellEx();
+    if (guest && !m_original.contains(id))
+    {
+        HomesteadRecord original; original.Reference = record.Reference; original.Disabled = ref->IsDisabled();
+        if (record.HasInventory && cell && cell->IsAttached()) { original.HasInventory = true; original.Contents = ref->GetInventory(); }
+        m_original.emplace(id, std::move(original));
+    }
+    if (guest && ref->IsDisabled() != record.Disabled)
+    {
+        if (record.Disabled) ref->Disable(); else ref->Enable();
+    }
+    if (record.HasInventory && (!guest || (cell && cell->IsAttached())) && !ref->IsDisabled())
+    {
+        Inventory current = ref->GetInventory();
+        if (current != record.Contents)
+        {
+            if (guest && !m_original[id].HasInventory) { m_original[id].HasInventory = true; m_original[id].Contents = current; }
+            ScopedInventoryOverride guard;
+            for (const auto& change : HomesteadInventory::Difference(current, record.Contents).Entries)
+                ref->AddOrRemoveItem(change, true);
+        }
+    }
+}
+void HomesteadService::OnNotify(const NotifyHomestead& n)
+{
+    if (!m_transport.IsOnline()) return;
+    const auto& data = n.Data;
+    if (m_authority != data.Authority)
+    {
+        // A host change starts a new session. Discard stale state before the new authority seeds it.
+        OnDisconnected(DisconnectedEvent{});
+        m_authority = data.Authority;
+    }
+    BuildIndex();
+    bool completed = data.Records.empty();
+    for (const auto& part : data.Records)
+    {
+        HomesteadRecord record; if (!m_assembler.Accept(part, record)) continue;
+        completed = true;
+        const auto id = m_world.GetModSystem().GetGameId(record.Reference);
+        if (!m_ids.contains(id)) continue;
+        m_remote.insert_or_assign(id, record); Apply(record);
+    }
+    if (completed && data.Action == HomesteadAction::Opened && data.Token == m_pendingOpen &&
+        m_world.GetModSystem().GetGameId(data.Reference) == m_pendingRef)
+    {
+        const auto id = m_pendingRef; m_pendingOpen = m_pendingRef = 0;
+        auto* ref = Cast<TESObjectREFR>(TESForm::GetById(id)); auto* player = PlayerCharacter::Get();
+        if (ref && player && !ref->IsDisabled() && m_world.GetTick() <= m_openDeadline && ref->GetParentCellEx() == player->parentCell)
+            ref->Activate(player, 0, nullptr, 1, 0);
+    }
+    if (data.Action == HomesteadAction::Rejected && data.Token == m_pendingOpen)
+    {
+        m_pendingOpen = m_pendingRef = 0;
+        spdlog::warn("Hearthfire chest unavailable: the host must load this house first");
+    }
+    if (data.Action == HomesteadAction::Result && !data.Accepted)
+        spdlog::warn("Hearthfire transfer rejected: item variant or quantity no longer available");
+}
+void HomesteadService::OnDisconnected(const DisconnectedEvent&)
+{
+    // Preserve the guest's own house and storage when returning to single player.
+    for (const auto& [id, original] : m_original)
+    {
+        auto* ref = Cast<TESObjectREFR>(TESForm::GetById(id)); if (!ref) continue;
+        if (ref->IsDisabled() != original.Disabled) { if (original.Disabled) ref->Disable(); else ref->Enable(); }
+        if (original.HasInventory)
+        {
+            ScopedInventoryOverride guard;
+            for (const auto& change : HomesteadInventory::Difference(ref->GetInventory(), original.Contents).Entries)
+                ref->AddOrRemoveItem(change, true);
+        }
+    }
+    m_remote.clear(); m_published.clear(); m_original.clear(); m_assembler.Pending.clear();
+    m_authority = m_pendingOpen = m_pendingRef = 0;
+    m_nextPoll = m_nextScan = 0;
+}
