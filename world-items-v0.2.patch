@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""Regenerate native portal locations from reviewed anchor/arrival measurements."""
+import json
+import math
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[2]
+anchors = json.loads((Path(__file__).with_name('locations.json')).read_text())['anchors']
+expected = {'Whiterun', 'Solitude', 'Windhelm', 'Riften', 'Markarth', 'Dawnstar',
+            'Falkreath', 'Morthal', 'Winterhold', 'Goldenhills Plantation'}
+assert len(anchors) == 10 and {a['city'] for a in anchors} == expected
+lines = ['#pragma once', '#include <array>', '#include <cstdint>', 'namespace CoopChests {',
+         'constexpr uint32_t VirtualMod = 0xFFFFFFFE;', 'constexpr uint32_t LocalFormMod = 0xFFFFFFFD;',
+         'constexpr const char* Plugin = "SurvivalSyncCoop.esp";', 'constexpr uint32_t ContainerBase = 0x800;',
+         'struct Location { const char* Name; float X, Y, Z, Yaw; bool Farming; };',
+         'inline constexpr std::array<Location, 10> Locations{{']
+for anchor in anchors:
+    pose = [*anchor['chestPosition'], anchor['yaw']]
+    assert len(pose) == 4 and all(math.isfinite(v) for v in pose)
+    xyz = ', '.join(f'{v:.3f}f' for v in pose[:3])
+    farm = 'true' if anchor['city'] == 'Goldenhills Plantation' else 'false'
+    lines.append(f'    {{"{anchor["city"]}", {xyz}, {pose[3]:.6f}f, {farm}}},')
+lines += ['}};', '}']
+(root / 'Code/common/CoopChestLocations.h').write_text('\n'.join(lines) + '\n')
+print('Generated ten named portal locations from the reviewed manifest')
