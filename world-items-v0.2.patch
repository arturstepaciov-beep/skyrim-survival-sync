new file mode 100644
index 00000000..4450b49b
--- /dev/null
+++ b/Tools/CoopChests/make_container_plugin.py
@@ -0,0 +1,37 @@
+#!/usr/bin/env python3
+"""Generate our own empty container form; no Bethesda plugin records/assets copied.
+
+The model path references an asset already installed with Skyrim. Placement is
+performed by the native service, so this plugin overrides no cells or worldspaces.
+"""
+from pathlib import Path
+import struct
+
+
+def field(tag, data):
+    return tag.encode('ascii') + struct.pack('<H', len(data)) + data
+
+
+def record(tag, form, data, flags=0):
+    return struct.pack('<4sIIIIHH', tag.encode('ascii'), len(data), flags, form, 0, 44, 0) + data
+
+
+def build():
+    header = field('HEDR', struct.pack('<fII', 1.7, 1, 0x801))
+    header += field('CNAM', b'Survival Sync\0')
+    header += field('SNAM', b'Empty shared-chest replica base; native service owns synchronization.\0')
+    header += field('MAST', b'Skyrim.esm\0') + field('DATA', bytes(8))
+    chest = field('EDID', b'SurvivalSyncCoopChest\0')
+    chest += field('OBND', struct.pack('<6h', -65, -34, 0, 65, 34, 85))
+    chest += field('FULL', b'Co-op Shared Chest\0')
+    chest += field('MODL', b'Clutter\\Ruins\\Ruins_LargeChest.nif\0')
+    chest += field('DATA', struct.pack('<Bf', 0, 0.0))  # no respawn, no initial inventory
+    body = record('CONT', 0x01000800, chest)
+    group = struct.pack('<4sI4sIHHI', b'GRUP', len(body) + 24, b'CONT', 0, 0, 0, 0) + body
+    return record('TES4', 0, header) + group
+
+
+if __name__ == '__main__':
+    path = Path(__file__).resolve().parents[2] / 'GameFiles/Skyrim/SurvivalSyncCoop.esp'
+    path.write_bytes(build())
+    print(f'Generated {path.name}: {path.stat().st_size} bytes; one new empty container, zero overrides')
