new file mode 100644
index 00000000..e1b16966
--- /dev/null
+++ b/Code/encoding/Structs/HomesteadData.cpp
@@ -0,0 +1,47 @@
+#include <Structs/HomesteadData.h>
+#include <TiltedCore/Serialization.hpp>
+using TiltedPhoques::Serialization;
+void HomesteadRecord::Serialize(Buffer::Writer& w) const noexcept
+{
+    Reference.Serialize(w); Cell.Serialize(w); WorldSpace.Serialize(w); Coords.Serialize(w);
+    Serialization::WriteBool(w, Disabled);
+    Serialization::WriteBool(w, HasInventory);
+    if (HasInventory) { Serialization::WriteVarInt(w, InventoryOffset); Serialization::WriteVarInt(w, InventoryTotal); Contents.Serialize(w); }
+}
+void HomesteadRecord::Deserialize(Buffer::Reader& r) noexcept
+{
+    Reference.Deserialize(r); Cell.Deserialize(r); WorldSpace.Deserialize(r); Coords.Deserialize(r);
+    Disabled = Serialization::ReadBool(r);
+    HasInventory = Serialization::ReadBool(r);
+    if (HasInventory) { InventoryOffset = Serialization::ReadVarInt(r) & 0xFFFFFFFF; InventoryTotal = Serialization::ReadVarInt(r) & 0xFFFFFFFF; Contents.Deserialize(r); }
+}
+void HomesteadData::Serialize(Buffer::Writer& w) const noexcept
+{
+    w.WriteBits(static_cast<uint8_t>(Action), 8);
+    Serialization::WriteVarInt(w, Authority);
+    Serialization::WriteVarInt(w, Token);
+    Reference.Serialize(w);
+    Serialization::WriteBool(w, Deposit);
+    Serialization::WriteBool(w, Accepted);
+    Item.Serialize(w);
+    const auto count = std::min<size_t>(Records.size(), 64);
+    w.WriteBits(count, 8);
+    for (size_t i = 0; i < count; ++i) Records[i].Serialize(w);
+}
+void HomesteadData::Deserialize(Buffer::Reader& r) noexcept
+{
+    uint64_t action{}; r.ReadBits(action, 8); Action = static_cast<HomesteadAction>(action);
+    Authority = Serialization::ReadVarInt(r) & 0xFFFFFFFF;
+    Token = Serialization::ReadVarInt(r) & 0xFFFFFFFF;
+    Reference.Deserialize(r);
+    Deposit = Serialization::ReadBool(r);
+    Accepted = Serialization::ReadBool(r);
+    Item.Deserialize(r);
+    uint64_t count{}; r.ReadBits(count, 8);
+    Records.clear();
+    for (uint64_t i = 0; i < count; ++i)
+    {
+        HomesteadRecord record; record.Deserialize(r);
+        if (i < 64) Records.push_back(std::move(record));
+    }
+}
