+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include "../Code/common/WorldItemPolicy.h"
+#include <cassert>
+#include <iostream>
+#include <limits>
+#include <array>
+struct Pose
+{
+    float X{}, Y{}, Z{}, RX{}, RY{}, RZ{};
+};
+int main()
+{
+    using SharedItems::Claim;
+    Claim a;
+    assert(a.Grab(1, 100));
+    assert(!a.Grab(2, 200));
+    assert(!a.Move(2, 300));
+    assert(a.Move(1, 300));
+    assert(!a.Grab(2, 1700));
+    assert(a.Grab(2, 1800));
+    assert(!a.Release(1));
+    assert(a.Release(2));
+    assert(a.Grab(1, 2000));
+    assert(a.Pickup(2));
+    assert(!a.Pickup(1));
+    assert(!a.Pickup(2));
+    assert(!a.Grab(1, 999999));
+    assert(!a.Move(2, 999999));
+    for (int first : {1, 2})
+    {
+        Claim r;
+        int granted = 0;
+        for (int retry = 0; retry < 1000; ++retry)
+        {
+            granted += r.Pickup(first);
+            granted += r.Pickup(3 - first);
+        }
+        assert(granted == 1);
+    }
+    // A resting dropped object keeps one controller for the full 3-second
+    // settling window, while pickup remains available to the other player.
+    Claim resting;
+    assert(resting.Grab(1, 100));
+    for (uint64_t now = 600; now <= 3100; now += 500)
+    {
+        assert(resting.Move(1, now));
+        assert(!resting.Grab(2, now + 1));
+    }
+    assert(resting.Release(1));
+    assert(resting.Pickup(2));
+    assert(!resting.Pickup(1));
+
+    Pose p;
+    assert(SharedItems::ValidPose(p));
+    p.X = std::numeric_limits<float>::quiet_NaN();
+    assert(!SharedItems::ValidPose(p));
+    p.X = 0;
+    p.RY = std::numeric_limits<float>::infinity();
+    assert(!SharedItems::ValidPose(p));
+    p.RY = 0;
+    p.Z = 1e8;
+    assert(!SharedItems::ValidPose(p));
+    std::cout << "PASS: exclusive grab, lease expiry, stale movement/release, competing pickup, replay, consumed tombstone, invalid pose\n";
+}
diff --git a/Tools/CoopChests/README.md b/Tools/CoopChests/README.md
new file mode 100644
index 00000000..19c76ec3
--- /dev/null
+++ b/Tools/CoopChests/README.md
@@ -0,0 +1,71 @@
+# Shared chest network — draft source
+
+This is separate from the existing Hearthfire container adapter. It is **not yet
+native-compiled or tested in Skyrim**. Do not describe the existing v0.5 package as
+containing these chests. No new client/server build is authorized or started here.
+
+## Placement
+
+All access points use one inventory. The five large-city chests are outside their
+stables: Whiterun, Solitude, Windhelm, Riften and Markarth. Dawnstar is beside the
+Windpeak Inn entrance; Falkreath beside Dead Man's Drink; Morthal beside Moorside
+Inn; Winterhold beside the Frozen Hearth. Goldenhills uses the lower outside
+farmhouse approach, independent of the raised upgraded doorway.
+
+`locations.json` records door anchors and exterior teleport arrival coordinates
+read from the supplied masters. Chests are offset away from the doorway and its
+arrival marker. Final clearance from terrain, stairs, walls and NPC paths requires
+in-game review for all ten placements, including upgraded Goldenhills and any
+city/farm overhaul mods. The chest does not copy the farm's quest or ownership.
+
+`make_container_plugin.py` creates **one new empty, script-free container base**
+named Co-op Shared Chest in `SurvivalSyncCoop.esp`, using an already installed
+vanilla model. It overrides no existing containers, cells, worldspaces, navmeshes
+or quests. No Bethesda/Creation Club masters or model/texture assets are shipped.
+The native client creates local access references only in loaded nearby cells.
+It adopts saved references with this unique base and removes duplicate local
+access references. Goldenhills requires the Farming plugin to be loaded.
+
+## Storage and offline view
+
+The server owns `config/CoopChest.dat`; keep it when updating/restarting the server.
+New networks start empty. Clients never seed, merge or overwrite this file from a
+saved house or cached chest. All ten access points read/write this single store.
+
+Deposits/withdrawals are intercepted before local inventory mutation. The server
+checks the exact variant, player ownership, distance to an access point, quantity,
+overflow, request token and bounds, then writes a replacement file before sending
+the inventory commit. Concurrent last-item withdrawals and repeated request tokens
+must not spend the same canonical stack. A failed storage write sends no commit.
+
+Disk records use plugin names and local form IDs, not session mod IDs. Missing
+plugins or a corrupt existing file block storage instead of silently emptying it.
+Keep matching mods on both clients. Quest items, worn items and dynamically
+generated base/enchantment/poison forms are excluded. Unequip items first.
+
+Each PC retains `config/CoopChest-view-cache.dat`, the latest committed snapshot
+received from its most recent server. Offline activation opens a **read-only overlay**
+with those contents; it does not open the native transfer menu. Transfers and NPC
+changes to these dedicated references are blocked while offline. Offline copies
+are never merged back into the server. Reconnecting replaces the view with the
+current server inventory. Ordinary house containers retain their separate behavior.
+
+This does not provide atomic transactions across the server file, player save and
+network acknowledgement. Unexpected process/connection loss during a transfer,
+old player-save rollback and use outside this custom client still need explicit
+recovery/duplication testing. Do not claim complete crash/rollback protection.
+
+## Validation
+
+Standalone storage tests exercise complete item-variant roundtrips, changed mod
+IDs, missing plugins, truncated/corrupt data, failed file replacement and supported
+item restrictions. Existing Hearthfire/world-item policy tests are also run.
+Additional packet tests are added under `[encoding.coopchest]`; they will run with
+the next authorized native build. They have not been executed in this environment.
+
+Before release, compile the Windows client/server and UI, enable the ESP on both
+PCs, and test deposits from each player, simultaneous withdrawals/Take All,
+disconnect while the menu is open, every city, Goldenhills before/after upgrades,
+clean restart, changed load order, missing plugin, server write failure, and the
+read-only offline view. Verify quantities after both players save/reload. Do not
+ship a placeholder claim that local policy tests prove these engine paths.
