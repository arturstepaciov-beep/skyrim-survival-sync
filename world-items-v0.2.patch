+#include <Services/CoopChestService.h>
+#include <Services/TransportService.h>
+#include <Services/OverlayService.h>
+#include <Services/PapyrusService.h>
+#include <OverlayApp.hpp>
+#include <World.h>
+#include <Games/TES.h>
+#include <Games/Overrides.h>
+#include <PlayerCharacter.h>
+#include <TESObjectREFR.h>
+#include <Forms/TESObjectCELL.h>
+#include <Forms/TESWorldSpace.h>
+#include <Forms/TESBoundObject.h>
+#include <Events/UpdateEvent.h>
+#include <Events/DisconnectedEvent.h>
+#include <Messages/RequestHomestead.h>
+#include <Messages/NotifyHomestead.h>
+#include <Structs/Mods.h>
+#include <CoopChestStore.h>
+#include <Interface/UI.h>
+namespace
+{
+const std::filesystem::path CachePath = std::filesystem::path("config") / "CoopChest-view-cache.dat";
+uint32_t Form(const char* filename, uint32_t base)
+{
+    auto* manager = ModManager::Get(); auto* mod = manager ? manager->GetByName(filename) : nullptr;
+    return mod && mod->IsLoaded() ? mod->GetFormId(base) : 0;
+}
+}
+CoopChestService::CoopChestService(World& w, entt::dispatcher& d, TransportService& t) : m_world(w), m_transport(t)
+{
+    m_update = d.sink<UpdateEvent>().connect<&CoopChestService::OnUpdate>(this);
+    m_notify = d.sink<NotifyHomestead>().connect<&CoopChestService::OnNotify>(this);
+    m_disconnect = d.sink<DisconnectedEvent>().connect<&CoopChestService::OnDisconnected>(this);
+    m_mods = d.sink<Mods>().connect<&CoopChestService::OnMods>(this);
+}
+void CoopChestService::OnMods(const Mods& mods)
+{
+    m_modNames.clear(); for (const auto& mod : mods.ModList) m_modNames.emplace(mod.Id, std::string(mod.Filename.data(), mod.Filename.size()));
+}
+bool CoopChestService::IsPortal(const TESObjectREFR* ref) const
+{
+    const auto base = Form(CoopChests::Plugin, CoopChests::ContainerBase);
+    return base && ref && ref->baseForm && ref->baseForm->formID == base;
+}
+uint32_t CoopChestService::PortalIndex(const TESObjectREFR* ref) const
+{
+    if (!IsPortal(ref) || !ref->GetWorldSpace() || ref->GetWorldSpace()->formID != Form("Skyrim.esm", 0x3C)) return 0;
+    for (uint32_t i = 0; i < CoopChests::Locations.size(); ++i)
+    {
+        const auto& p = CoopChests::Locations[i];
+        if (glm::distance(glm::vec3(ref->position), glm::vec3(p.X, p.Y, p.Z)) < 300.f) return i + 1;
+    }
+    return 0;
+}
+void CoopChestService::Send(HomesteadData data)
+{
+    RequestHomestead q; q.Data = std::move(data); m_transport.Send(q);
+}
+void CoopChestService::LoadCache()
+{
+    if (m_cacheLoaded) return;
+    m_cacheLoaded = true;
+    const auto bytes = CoopChestStore::Read(CachePath); if (!bytes) return;
+    Inventory snapshot;
+    if (CoopChestStore::Decode(*bytes, [](const std::string& name, uint32_t base) -> std::optional<GameId>
+        {
+            const auto id = Form(name.c_str(), base); if (!id) return {}; return GameId(CoopChests::LocalFormMod, id);
+        }, snapshot))
+    { m_contents = std::move(snapshot); m_haveSnapshot = true; m_dirty = true; }
+    else spdlog::warn("Co-op chest view cache could not be resolved; it will not seed server storage");
+}
+void CoopChestService::SaveCache()
+{
+    const auto bytes = CoopChestStore::Encode(m_contents, [this](uint32_t id) -> std::optional<std::string>
+    {
+        const auto i = m_modNames.find(id); if (i == m_modNames.end()) return {}; return i->second;
+    });
+    if (!bytes || !CoopChestStore::Save(CachePath, *bytes)) spdlog::warn("Could not save the latest offline co-op chest view");
+}
+void CoopChestService::Apply(TESObjectREFR* ref)
+{
+    if (!m_haveSnapshot || !ref || !ref->GetParentCellEx() || !ref->GetParentCellEx()->IsAttached()) return;
+    if (ref->GetInventory() == m_contents) return;
+    ScopedInventoryOverride guard;
+    // Only the dedicated empty script-free replica is reconciled, never an existing
+    // player-owned/quest container or the player's own inventory.
+    ref->SetInventory(m_contents);
+}
+bool CoopChestService::TryOpen(TESObjectREFR* ref)
+{
+    if (!IsPortal(ref)) return false;
+    const auto index = PortalIndex(ref); if (!index) return true;
+    if (!m_transport.IsOnline()) LoadCache();
+    if (!m_transport.IsOnline())
+    {
+        // Use a read-only view, not the native transfer menu. This also removes
+        // offline Take All, drag/drop and keyboard transfer paths entirely.
+        std::string text;
+        if (!m_haveSnapshot) text = "No synchronized snapshot is available yet. Connect to the server first.";
+        else if (m_contents.Entries.empty()) text = "The last synchronized chest was empty.";
+        else for (const auto& item : m_contents.Entries)
+        {
+            auto* form = TESForm::GetById(m_world.GetModSystem().GetGameId(item.BaseId));
+            const auto* name = form ? form->GetName() : nullptr;
+            text += std::to_string(item.Count) + " x " + (name && *name ? name : "Unavailable item") + "\n";
+        }
+        auto& overlay = m_world.GetOverlayService();
+        if (auto* app = overlay.GetOverlayApp())
+        {
+            auto args = CefListValue::Create(); args->SetString(0, text);
+            app->ExecuteAsync("coopChestView", args); overlay.SetActive(true);
+        }
+        return true;
+    }
+    if (m_openToken && m_world.GetTick() < m_openDeadline) return true;
+    HomesteadData q; q.Action = HomesteadAction::CoopOpen; q.Reference = GameId(CoopChests::VirtualMod, index); q.Token = ++m_token;
+    m_openToken = q.Token; m_openRef = ref->formID; m_openDeadline = m_world.GetTick() + 5000; Send(std::move(q)); return true;
+}
+bool CoopChestService::TryTransfer(TESObjectREFR* source, TESObjectREFR* destination, TESBoundObject* base, ExtraDataList* extra, int32_t count)
+{
+    if (ScopedInventoryOverride::IsOverriden() || (!IsPortal(source) && !IsPortal(destination))) return false;
+    if (!m_transport.IsOnline() || !m_ready) return true; // Offline replicas are strictly view-only.
+    auto* player = PlayerCharacter::Get();
+    const bool deposit = source == player && IsPortal(destination);
+    const bool withdraw = destination == player && IsPortal(source);
+    if ((!deposit && !withdraw) || !base || count <= 0 || count > 32767) return true;
+    auto* chest = deposit ? destination : source; const auto index = PortalIndex(chest); if (!index) return true;
+    HomesteadData q; q.Action = HomesteadAction::CoopTransfer; q.Reference = GameId(CoopChests::VirtualMod, index); q.Token = ++m_token; q.Deposit = deposit;
+    if (!m_world.GetModSystem().GetServerModId(base->formID, q.Item.BaseId)) return true;
+    if (extra) { ScopedExtraDataOverride guard; source->GetItemFromExtraData(q.Item, extra); }
+    q.Item.Count = count;
+    if (!HomesteadInventory::Supported(q.Item) || q.Item.ExtraWorn || q.Item.ExtraWornLeft)
+    { m_world.GetOverlayService().SendSystemMessage("Co-op chest: unequip this item; quest and generated items cannot be transferred."); return true; }
+    Send(std::move(q)); return true; // No native mutation before the server's commit.
+}
+void CoopChestService::OnNotify(const NotifyHomestead& n)
+{
+    const auto& data = n.Data;
+    if (data.Action < HomesteadAction::CoopState || !m_transport.IsOnline()) return;
+    bool completed = false;
+    for (const auto& part : data.Records)
+    {
+        if (part.Reference.ModId != CoopChests::VirtualMod || part.Reference.BaseId != 0 || !part.HasInventory) continue;
+        HomesteadRecord record; if (!m_assembler.Accept(part, record)) continue;
+        const bool changed = !m_ready || m_contents != record.Contents;
+        m_ready = m_haveSnapshot = true; completed = true;
+        if (changed) { m_contents = std::move(record.Contents); m_dirty = true; SaveCache(); }
+    }
+    if (data.Action == HomesteadAction::CoopOpened && completed && data.Token == m_openToken)
+    {
+        auto* ref = Cast<TESObjectREFR>(TESForm::GetById(m_openRef)); auto* player = PlayerCharacter::Get();
+        m_openToken = m_openRef = 0;
+        if (player && IsPortal(ref) && m_world.GetTick() <= m_openDeadline && glm::distance(glm::vec3(ref->position), glm::vec3(player->position)) < 512.f)
+        { Apply(ref); m_nativeOpenRef = ref->formID; ScopedActivateOverride guard; ref->Activate(player, 0, nullptr, 1, 0); }
+    }
+    if (data.Action == HomesteadAction::CoopRejected || (data.Action == HomesteadAction::CoopResult && !data.Accepted))
+    {
+        if (data.Token == m_openToken) m_openToken = m_openRef = 0;
+        m_world.GetOverlayService().SendSystemMessage("Co-op chest unavailable or transfer rejected; neither local inventory was changed.");
+    }
+}
+void CoopChestService::OnDisconnected(const DisconnectedEvent&)
+{
+    if (m_nativeOpenRef)
+        if (auto* ui = UI::Get(); ui && ui->GetMenuOpen(BSFixedString("ContainerMenu"))) ui->CloseAllMenus();
+    m_nativeOpenRef = 0;
+    // Retain the exact last committed view instead of restoring a pre-session chest.
+    m_ready = false; m_wasOnline = false; m_openToken = m_openRef = 0; m_nextPoll = 0; m_assembler.Pending.clear();
+    // Resolve the stable on-disk snapshot locally in case a failed reconnect
+    // already changed the server mod-ID mapping.
+    m_cacheLoaded = false; LoadCache();
+}
+void CoopChestService::OnUpdate(const UpdateEvent&)
+{
+    auto* player = PlayerCharacter::Get(); if (!player || !player->GetNiNode() || !player->parentCell) return;
+    if (auto* ui = UI::Get(); ui && ui->GetMenuOpen(BSFixedString("Loading Menu"))) return;
+    const auto now = m_world.GetTick();
+    if (m_transport.IsOnline())
+    {
+        if (!m_wasOnline) { m_ready = false; m_wasOnline = true; m_nextPoll = 0; }
+        if (now >= m_nextPoll) { HomesteadData q; q.Action = HomesteadAction::CoopPoll; Send(std::move(q)); m_nextPoll = now + 5000; }
+    }
+    if (now < m_nextScan) return; m_nextScan = now + 1000;
+    const auto baseId = Form(CoopChests::Plugin, CoopChests::ContainerBase); if (!baseId) return;
+    if (!m_ready) LoadCache();
+    auto* tes = TES::Get(); if (!tes) return;
+    Vector<TESObjectCELL*> cells;
+    if (tes->interiorCell) cells.push_back(tes->interiorCell);
+    else if (tes->cells && tes->cells->arr && tes->cells->dimension <= 15)
+        for (uint32_t i = 0; i < tes->cells->dimension * tes->cells->dimension; ++i) if (tes->cells->arr[i]) cells.push_back(tes->cells->arr[i]);
+    for (auto* cell : cells)
+    {
+        for (auto* ref : cell->GetRefsByFormTypes({FormType::Container}))
+        {
+            const auto index = PortalIndex(ref); if (!index || ref->IsDeleted()) continue;
+            auto& slot = m_portals[index - 1]; auto* existing = Cast<TESObjectREFR>(TESForm::GetById(slot));
+            if (existing && existing != ref && PortalIndex(existing) == index && !existing->IsDeleted())
+            { ref->Disable(); ref->Delete(); continue; }
+            const bool adopted = slot != ref->formID; slot = ref->formID;
+            if (adopted || m_dirty) Apply(ref);
+        }
+    }
+    if (player->GetWorldSpace() && player->GetWorldSpace()->formID == Form("Skyrim.esm", 0x3C))
+    {
+        auto& papyrus = m_world.ctx().at<PapyrusService>(); const void* fn = papyrus.Get("ObjectReference", "PlaceAtMe");
+        if (!fn) return;
+        auto* base = TESForm::GetById(baseId);
+        PapyrusFunction<TESObjectREFR*, TESObjectREFR, TESForm*, int32_t, bool, bool> place(fn);
+        for (size_t i = 0; i < CoopChests::Locations.size(); ++i)
+        {
+            const auto& location = CoopChests::Locations[i];
+            if (location.Farming && !Form("ccvsvsse004-beafarmer.esl", 0xB20)) continue;
+            const glm::vec3 position(location.X, location.Y, location.Z);
+            if (glm::distance(glm::vec3(player->position), position) > 2200.f) continue;
+            auto* existing = Cast<TESObjectREFR>(TESForm::GetById(m_portals[i])); if (PortalIndex(existing) == i + 1 && !existing->IsDeleted()) continue;
+            const auto grid = GridCellCoords::CalculateGridCellCoords(location.X, location.Y);
+            auto* cell = ModManager::Get()->GetCellFromCoordinates(grid.X, grid.Y, player->GetWorldSpace(), false);
+            if (!cell || !cell->IsAttached()) continue;
+            auto* ref = place(player, base, 1, false, true); if (!ref) continue;
+            ref->MoveTo(cell, position); if (ref->IsDeleted()) continue;
+            ref->SetRotation(0.f, 0.f, location.Yaw); ref->SetWorldMotion(false);
+            m_portals[i] = ref->formID; Apply(ref); ref->Enable();
+            spdlog::info("Co-op chest access created at {}", location.Name);
+        }
+    }
+    m_dirty = false;
+}
diff --git a/Code/client/Services/Generic/HomesteadService.cpp b/Code/client/Services/Generic/HomesteadService.cpp
new file mode 100644
index 00000000..1edb4dba
--- /dev/null
+++ b/Code/client/Services/Generic/HomesteadService.cpp
@@ -0,0 +1,243 @@
+#include <Services/HomesteadService.h>
+#include <Services/TransportService.h>
+#include <World.h>
+#include <Games/TES.h>
+#include <Games/Overrides.h>
+#include <PlayerCharacter.h>
+#include <Forms/TESObjectCELL.h>
+#include <Forms/TESWorldSpace.h>
+#include <TESObjectREFR.h>
+#include <Forms/TESBoundObject.h>
+#include <Events/UpdateEvent.h>
+#include <Events/DisconnectedEvent.h>
+#include <Messages/RequestHomestead.h>
+#include <Messages/NotifyHomestead.h>
+#include <filesystem>
+#include <fstream>
+#include <cstring>
+#include <HearthfireIndex.h>
+#include <HomesteadInventory.h>
+namespace
+{
+bool Structure(const TESObjectREFR* ref)
+{
+    if (!ref || !ref->baseForm || ref->IsDeleted() || ref->IsTemporary()) return false;
+    // Placed architecture, enable-parent markers, furniture, lights, doors and containers.
+    // Actors, loose loot and script activators retain their existing synchronization paths.
+    const auto type = static_cast<uint8_t>(ref->baseForm->formType);
+    return type == 28 || type == 29 || type == 31 || type == 34 || type == 36 || type == 40;
+}
+}
+HomesteadService::HomesteadService(World& w, entt::dispatcher& d, TransportService& t) : m_world(w), m_transport(t)
+{
+    m_update = d.sink<UpdateEvent>().connect<&HomesteadService::OnUpdate>(this);
+    m_notify = d.sink<NotifyHomestead>().connect<&HomesteadService::OnNotify>(this);
+    m_disconnect = d.sink<DisconnectedEvent>().connect<&HomesteadService::OnDisconnected>(this);
+}
+void HomesteadService::BuildIndex()
+{
+    if (m_indexReady || m_world.GetTick() < m_nextIndexAttempt) return;
+    auto* mods = ModManager::Get(); auto* mod = mods ? mods->GetByName("HearthFires.esm") : nullptr;
+    if (!mod || !mod->IsLoaded() || mod->IsLite()) return;
+    m_nextIndexAttempt = m_world.GetTick() + 5000;
+    std::error_code ec;
+    auto root = std::filesystem::current_path(ec);
+    for (int depth = 0; !ec && depth < 5 && !root.empty(); ++depth, root = root.parent_path())
+    {
+        for (const auto& path : {root / "Data" / "HearthFires.esm", root / "HearthFires.esm"})
+        {
+            std::unordered_set<uint32_t> ids;
+            if (HearthfireIndex::ReadReferenceIndex(path, uint32_t(mod->standardId) << 24, ids))
+            {
+                m_ids = std::move(ids); m_indexReady = true;
+                spdlog::info("Hearthfire: indexed {} placed references", m_ids.size()); return;
+            }
+        }
+    }
+}
+bool HomesteadService::IsManaged(TESObjectREFR* ref)
+{
+    BuildIndex();
+    return ref && ref->baseForm && ref->baseForm->formType == FormType::Container && !ref->extraData.HasQuestObjectAlias() && m_ids.contains(ref->formID);
+}
+void HomesteadService::Send(HomesteadData data)
+{
+    HomesteadWire::Split(data, [this](const HomesteadData& part) { RequestHomestead q; q.Data = part; m_transport.Send(q); });
+}
+bool HomesteadService::TryOpen(TESObjectREFR* ref)
+{
+    if (!m_transport.IsOnline() || !IsManaged(ref)) return false;
+    if (m_pendingOpen && m_world.GetTick() < m_openDeadline) return true;
+    GameId id{}; if (!m_world.GetModSystem().GetServerModId(ref->formID, id)) return true;
+    HomesteadData q; q.Action = HomesteadAction::Open; q.Reference = id; q.Token = ++m_nextToken;
+    m_pendingOpen = q.Token; m_pendingRef = ref->formID; m_openDeadline = m_world.GetTick() + 5000;
+    Send(std::move(q)); return true;
+}
+bool HomesteadService::TryTransfer(TESObjectREFR* source, TESObjectREFR* destination, TESBoundObject* base, ExtraDataList* extra, int32_t count)
+{
+    if (!m_transport.IsOnline() || ScopedInventoryOverride::IsOverriden()) return false;
+    auto* player = PlayerCharacter::Get();
+    const bool deposit = source == player && IsManaged(destination);
+    const bool withdraw = destination == player && IsManaged(source);
+    if (!deposit && !withdraw)
+    {
+        // Do not let unhandled container-to-world or container-to-NPC removal
+        // mutate a replica while the canonical stack remains spendable.
+        if (IsManaged(source) || IsManaged(destination))
+        {
+            spdlog::warn("Shared Hearthfire storage: withdraw to player inventory before dropping or forwarding items");
+            return true;
+        }
+        return false;
+    }
+    if (!base || count <= 0 || count > 32767) return true;
+    auto* chest = deposit ? destination : source;
+    HomesteadData q; q.Action = HomesteadAction::Transfer; q.Deposit = deposit; q.Token = ++m_nextToken;
+    auto& mods = m_world.GetModSystem();
+    if (!mods.GetServerModId(chest->formID, q.Reference) || !mods.GetServerModId(base->formID, q.Item.BaseId)) return true;
+    if (extra) { ScopedExtraDataOverride guard; source->GetItemFromExtraData(q.Item, extra); }
+    q.Item.Count = count;
+    if (!HomesteadInventory::Supported(q.Item))
+    {
+        spdlog::warn("Shared storage: dynamically generated forms and quest items stay local");
+        return true;
+    }
+    Send(std::move(q));
+    // Leave both inventories untouched until the server commits the exact variant.
+    return true;
+}
+void HomesteadService::OnUpdate(const UpdateEvent&)
+{
+    if (!m_transport.IsOnline()) return;
+    auto* player = PlayerCharacter::Get(); if (!player || !player->parentCell) return;
+    const auto now = m_world.GetTick();
+    if (now >= m_nextPoll)
+    {
+        m_nextPoll = now + (m_authority ? 10000 : 1000);
+        HomesteadData q; q.Action = HomesteadAction::Poll; Send(std::move(q));
+    }
+    if (now < m_nextScan) return;
+    m_nextScan = now + 1000;
+    BuildIndex();
+    if (!m_authority) return;
+    if (m_authority != m_transport.GetLocalPlayerId())
+    {
+        for (const auto& [id, record] : m_remote) Apply(record);
+        return;
+    }
+    // Apply delayed chest commits as their cells become available on the host.
+    for (const auto& [id, record] : m_remote) if (record.HasInventory) Apply(record);
+    HomesteadData q; q.Action = HomesteadAction::Publish;
+    for (uint32_t id : m_ids)
+    {
+        auto* ref = Cast<TESObjectREFR>(TESForm::GetById(id)); if (!Structure(ref)) continue;
+        const bool disabled = ref->IsDisabled();
+        const auto old = m_published.find(id);
+        if (old != m_published.end() && old->second == disabled) continue;
+        HomesteadRecord record;
+        if (!m_world.GetModSystem().GetServerModId(id, record.Reference)) continue;
+        record.Disabled = disabled;
+        auto* cell = ref->GetParentCellEx();
+        if (!cell) continue;
+        if (!m_world.GetModSystem().GetServerModId(cell->formID, record.Cell)) continue;
+        if (auto* space = ref->GetWorldSpace()) m_world.GetModSystem().GetServerModId(space->formID, record.WorldSpace);
+        record.Coords = GridCellCoords::CalculateGridCellCoords(ref->position.x, ref->position.y);
+        // A chest can be seeded only once the host has loaded its actual save inventory.
+        if (ref->baseForm->formType == FormType::Container)
+        {
+            // Quest-bound construction/resource chests must keep their native scripts.
+            if (ref->extraData.HasQuestObjectAlias()) continue;
+            if (!cell->IsAttached()) continue;
+            record.HasInventory = true; record.Contents = HomesteadInventory::SharedPart(ref->GetInventory());
+        }
+        m_published[id] = disabled;
+        if (!HomesteadWire::ValidInventory(record.Contents)) { m_published.erase(id); continue; }
+        q.Records.push_back(std::move(record));
+        if (q.Records.size() == 32) { Send(q); q.Records.clear(); }
+    }
+    if (!q.Records.empty()) Send(std::move(q));
+}
+void HomesteadService::Apply(const HomesteadRecord& record)
+{
+    auto& mods = m_world.GetModSystem();
+    const auto id = mods.GetGameId(record.Reference);
+    if (!m_ids.contains(id)) return;
+    auto* ref = Cast<TESObjectREFR>(TESForm::GetById(id)); if (!Structure(ref)) return;
+    const bool guest = m_authority != m_transport.GetLocalPlayerId();
+    auto* cell = ref->GetParentCellEx();
+    if (guest && !m_original.contains(id))
+    {
+        HomesteadRecord original; original.Reference = record.Reference; original.Disabled = ref->IsDisabled();
+        if (record.HasInventory && cell && cell->IsAttached()) { original.HasInventory = true; original.Contents = ref->GetInventory(); }
+        m_original.emplace(id, std::move(original));
+    }
+    if (guest && ref->IsDisabled() != record.Disabled)
+    {
+        if (record.Disabled) ref->Disable(); else ref->Enable();
+    }
+    if (record.HasInventory && (!guest || (cell && cell->IsAttached())) && !ref->IsDisabled())
+    {
+        Inventory current = ref->GetInventory();
+        if (current != record.Contents)
+        {
+            if (guest && !m_original[id].HasInventory) { m_original[id].HasInventory = true; m_original[id].Contents = current; }
+            ScopedInventoryOverride guard;
+            for (const auto& change : HomesteadInventory::Difference(current, record.Contents).Entries)
+                ref->AddOrRemoveItem(change, true);
+        }
+    }
+}
+void HomesteadService::OnNotify(const NotifyHomestead& n)
+{
+    if (!m_transport.IsOnline() || n.Data.Action >= HomesteadAction::CoopPoll) return;
+    const auto& data = n.Data;
+    if (m_authority != data.Authority)
+    {
+        // A host change starts a new session. Discard stale state before the new authority seeds it.
+        OnDisconnected(DisconnectedEvent{});
+        m_authority = data.Authority;
+    }
+    BuildIndex();
+    bool completed = data.Records.empty();
+    for (const auto& part : data.Records)
+    {
+        HomesteadRecord record; if (!m_assembler.Accept(part, record)) continue;
+        completed = true;
+        const auto id = m_world.GetModSystem().GetGameId(record.Reference);
+        if (!m_ids.contains(id)) continue;
+        m_remote.insert_or_assign(id, record); Apply(record);
+    }
+    if (completed && data.Action == HomesteadAction::Opened && data.Token == m_pendingOpen &&
+        m_world.GetModSystem().GetGameId(data.Reference) == m_pendingRef)
+    {
+        const auto id = m_pendingRef; m_pendingOpen = m_pendingRef = 0;
+        auto* ref = Cast<TESObjectREFR>(TESForm::GetById(id)); auto* player = PlayerCharacter::Get();
+        if (ref && player && !ref->IsDisabled() && m_world.GetTick() <= m_openDeadline && ref->GetParentCellEx() == player->parentCell)
+            ref->Activate(player, 0, nullptr, 1, 0);
+    }
+    if (data.Action == HomesteadAction::Rejected && data.Token == m_pendingOpen)
+    {
+        m_pendingOpen = m_pendingRef = 0;
+        spdlog::warn("Hearthfire chest unavailable: the host must load this house first");
+    }
+    if (data.Action == HomesteadAction::Result && !data.Accepted)
+        spdlog::warn("Hearthfire transfer rejected: item variant or quantity no longer available");
+}
+void HomesteadService::OnDisconnected(const DisconnectedEvent&)
+{
+    // Preserve the guest's own house and storage when returning to single player.
+    for (const auto& [id, original] : m_original)
+    {
+        auto* ref = Cast<TESObjectREFR>(TESForm::GetById(id)); if (!ref) continue;
+        if (ref->IsDisabled() != original.Disabled) { if (original.Disabled) ref->Disable(); else ref->Enable(); }
+        if (original.HasInventory)
+        {
+            ScopedInventoryOverride guard;
+            for (const auto& change : HomesteadInventory::Difference(ref->GetInventory(), original.Contents).Entries)
+                ref->AddOrRemoveItem(change, true);
+        }
+    }
+    m_remote.clear(); m_published.clear(); m_original.clear(); m_assembler.Pending.clear();
+    m_authority = m_pendingOpen = m_pendingRef = 0;
+    m_nextPoll = m_nextScan = 0;
+}
