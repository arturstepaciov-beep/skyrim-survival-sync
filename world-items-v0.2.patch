+#include "../Code/common/DateTime.h"
+#include "../Code/common/SurvivalTimePolicy.h"
+#include <cassert>
+#include <cmath>
+#include <iostream>
+int main()
+{
+    TimeModel m;
+    m.Year = 201;
+    m.Month = 11;
+    m.Day = 31;
+    m.Time = 23;
+    m.TimeScale = 20;
+    DateTime t(m);
+    t.AddHours(8);
+    assert(t.m_timeModel.Year == 202 && t.m_timeModel.Month == 0 && t.m_timeModel.Day == 1);
+    assert(std::abs(t.m_timeModel.Time - 7) < 0.001);
+    DateTime before(t);
+    t.Update(3600000);
+    assert(std::abs((SurvivalTime::InDays(t.m_timeModel) - SurvivalTime::InDays(before.m_timeModel)) * 24 - 20) < 0.001);
+    assert(t.m_timeModel.TimeScale == 20);
+    auto target = t.m_timeModel;
+    target.Time = 20;
+    const auto hours = SurvivalTime::HoursToTarget(t.m_timeModel, target);
+    t.AddHours(hours);
+    assert(std::abs(t.m_timeModel.Time - 20) < 0.001);
+    assert(SurvivalTime::HoursToTarget(t.m_timeModel, target) == 0);
+    std::cout << "PASS: actual DateTime.cpp advance, calendar rollover, scaled ticking, target replay\n";
+}
diff --git a/Tests/homestead.cpp b/Tests/homestead.cpp
new file mode 100644
index 00000000..bc089218
--- /dev/null
+++ b/Tests/homestead.cpp
@@ -0,0 +1,43 @@
+#include "../Code/common/HomesteadPolicy.h"
+#include "../Code/common/HearthfireIndex.h"
+#include <cassert>
+#include <sstream>
+#include <iostream>
+#include <vector>
+#include <chrono>
+static void u32(std::string& s, uint32_t n) { s.append(reinterpret_cast<const char*>(&n), 4); }
+static void record(std::string& s, const char* type, uint32_t id, const std::string& body)
+{
+    s.append(type, 4); u32(s, static_cast<uint32_t>(body.size())); u32(s, 0); u32(s, id); u32(s, 0); u32(s, 0); s += body;
+}
+int main()
+{
+    using HomesteadPolicy::CanTransfer;
+    assert(CanTransfer(1,0,1));
+    assert(!CanTransfer(0,0,1)); // the second simultaneous take cannot spend the same item
+    int64_t chest=1, playerA=0, playerB=0;
+    if(CanTransfer(chest,playerA,1)){--chest;++playerA;}
+    if(CanTransfer(chest,playerB,1)){--chest;++playerB;}
+    assert(chest==0 && playerA+playerB==1);
+    assert(!CanTransfer(10,0,-1)); assert(!CanTransfer(10,0,0));
+    assert(!CanTransfer(32768,0,32768));
+    assert(!CanTransfer(10,INT32_MAX,1)); assert(!CanTransfer(10,-1,1));
+    assert(HomesteadPolicy::FreshToken(2,1));
+    assert(!HomesteadPolicy::FreshToken(1,1)); assert(!HomesteadPolicy::FreshToken(0,0));
+    assert(!HomesteadPolicy::FreshToken(1,2));
+    std::string masters;
+    masters += "MAST"; masters.append("\x02\0",2); masters.append("a\0",2);
+    masters += "MAST"; masters.append("\x02\0",2); masters.append("b\0",2);
+    std::string esm; record(esm,"TES4",0,masters);
+    std::string children; record(children,"REFR",0x02001234,""); record(children,"REFR",0x00001235,""); record(children,"ACHR",0x02001236,"");
+    esm += "GRUP"; u32(esm,static_cast<uint32_t>(24+children.size())); esm.append(16,'\0'); esm += children;
+    const auto path = std::filesystem::temp_directory_path() / ("hearthfire-index-test-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()) + ".esm");
+    auto put=[&](const std::string& data){std::ofstream f(path,std::ios::binary);f.write(data.data(),data.size());};
+    put(esm); std::unordered_set<uint32_t> ids;
+    assert(HearthfireIndex::ReadReferenceIndex(path,0x07000000,ids));
+    assert(ids.size()==1 && ids.contains(0x07001234)); // local load order differs from file's master index
+    esm.pop_back(); put(esm); ids.clear(); assert(!HearthfireIndex::ReadReferenceIndex(path,0x03000000,ids));
+    put("GRUP"); ids.clear(); assert(!HearthfireIndex::ReadReferenceIndex(path,0,ids));
+    std::filesystem::remove(path);
+    std::cout << "Hearthfire index, quantity conservation, overflow and replay policies passed\n";
+}
