+#include <Services/WorldItemService.h>
+#include <World.h>
+#include <Components.h>
+#include <GameServer.h>
+#include <Services/CharacterService.h>
+#include <Messages/CharacterSpawnRequest.h>
+#include <Messages/RequestWorldItem.h>
+#include <Messages/NotifyWorldItem.h>
+#include <Messages/NotifyInventoryChanges.h>
+#include <Structs/GridCellCoords.h>
+
+WorldItemService::WorldItemService(World& w, entt::dispatcher& d)
+    : m_world(w)
+{
+    m_request = d.sink<PacketEvent<RequestWorldItem>>().connect<&WorldItemService::OnRequest>(this);
+}
+bool WorldItemService::InRange(const Player* p, const WorldItemData& d) const
+{
+    const auto& c = p->GetCellComponent();
+    if (!d.WorldSpace)
+        return c.IsInInteriorCell() && c.Cell == d.Cell;
+    return !c.IsInInteriorCell() && c.WorldSpaceId == d.WorldSpace && std::abs(static_cast<double>(d.X) - static_cast<double>(c.CenterCoords.X) * 4096.0) < 20000 &&
+           std::abs(static_cast<double>(d.Y) - static_cast<double>(c.CenterCoords.Y) * 4096.0) < 20000;
+}
+void WorldItemService::Broadcast(const Record& r)
+{
+    NotifyWorldItem n;
+    n.Data = r.Data;
+    n.Data.Owner = r.Claim.Owner;
+    n.Data.Consumed = r.Claim.Consumed;
+    for (Player* p : m_world.GetPlayerManager())
+        if (InRange(p, n.Data))
+            p->Send(n);
+}
+void WorldItemService::OnRequest(const PacketEvent<RequestWorldItem>& e)
+{
+    if (e.Packet.Action == WorldItemAction::VolcanoVisual) return;
+    Player* p = e.pPlayer;
+    if (!p || !p->GetCharacter())
+        return;
+    const auto& q = e.Packet;
+    const auto actor = *p->GetCharacter();
+    auto* inv = m_world.try_get<InventoryComponent>(actor);
+    auto* owner = m_world.try_get<OwnerComponent>(actor);
+    if (!inv || !owner || owner->GetOwner() != p)
+        return;
+    if (q.Action == WorldItemAction::Resync)
+    {
+        const auto now = GameServer::Get()->GetTick();
+        if (now < m_nextResyncTick[p->GetId()])
+            return;
+        m_nextResyncTick[p->GetId()] = now + 1000;
+        auto view = m_world.view<CharacterComponent, CellIdComponent, OwnerComponent, AnimationComponent>();
+        for (auto entity : view)
+        {
+            const auto& cell = view.get<CellIdComponent>(entity);
+            if (view.get<OwnerComponent>(entity).GetOwner() == p || !p->GetCellComponent().IsInRange(cell, false))
+                continue;
+            CharacterSpawnRequest state;
+            CharacterService::Serialize(m_world, entity, &state);
+            state.IsResync = true;
+            p->Send(state);
+        }
+    }
+    if (q.Action == WorldItemAction::Snapshot || q.Action == WorldItemAction::Resync)
+    {
+        for (const auto& [id, r] : m_items)
+            if (InRange(p, r.Data))
+            {
+                NotifyWorldItem n;
+                n.Data = r.Data;
+                n.Data.Owner = r.Claim.Owner;
+                n.Data.Consumed = r.Claim.Consumed;
+                p->Send(n);
+            }
+        return;
+    }
+    if (!SharedItems::ValidPose(q.Data))
+        return;
+    if (q.Action == WorldItemAction::Drop && q.Data.Token == 0)
+        return;
+    uint32_t id = q.Data.Id;
+    if (!id)
+    {
+        for (const auto& [key, r] : m_items)
+        {
+            if ((q.Data.Reference && r.Data.Reference == q.Data.Reference) || (!q.Data.Reference && r.Data.Creator == p->GetId() && r.Data.Token == q.Data.Token))
+            {
+                id = key;
+                break;
+            }
+        }
+    }
+    if (!id && (q.Action == WorldItemAction::Drop || q.Action == WorldItemAction::Register || q.Action == WorldItemAction::Physics || q.Action == WorldItemAction::Pickup))
+    {
+        if (!InRange(p, q.Data) || !q.Data.Item.BaseId || q.Data.Item.Count <= 0 || q.Data.Item.Count > 32767 || q.Data.Item.IsQuestItem || m_items.size() >= 4096)
+        {
+            if (q.Action == WorldItemAction::Drop)
+            {
+                NotifyWorldItem rejected;
+                rejected.Action = WorldItemAction::Reject;
+                rejected.Data = q.Data;
+                p->Send(rejected);
+            }
+            return;
+        }
+        if (q.Action != WorldItemAction::Drop && !q.Data.Reference)
+            return;
+        Record row;
+        row.Data = q.Data;
+        row.Data.Id = m_nextId++;
+        row.Data.Creator = p->GetId();
+        row.Data.Owner = 0;
+        row.Data.Consumed = false;
+        if (q.Action == WorldItemAction::Drop)
+        {
+            auto match = inv->Content.Entries.end();
+            for (auto i = inv->Content.Entries.begin(); i != inv->Content.Entries.end(); ++i)
+            {
+                auto a = *i, b = q.Data.Item;
+                a.ExtraWorn = a.ExtraWornLeft = b.ExtraWorn = b.ExtraWornLeft = false;
+                if (a.CanBeMerged(b) && i->Count >= q.Data.Item.Count)
+                {
+                    match = i;
+                    break;
+                }
+            }
+            if (match == inv->Content.Entries.end())
+            {
+                NotifyWorldItem rejected;
+                rejected.Action = WorldItemAction::Reject;
+                rejected.Data = q.Data;
+                p->Send(rejected);
+                return;
+            }
+            auto removed = *match;
+            removed.Count = -q.Data.Item.Count;
+            row.Data.Item = *match;
+            row.Data.Item.Count = q.Data.Item.Count;
+            row.Data.Item.ExtraWorn = row.Data.Item.ExtraWornLeft = false;
+            inv->Content.AddOrRemoveEntry(removed);
+            NotifyInventoryChanges n;
+            n.ServerId = World::ToInteger(actor);
+            n.OwnershipEpoch = owner->OwnershipEpoch;
+            n.Item = removed;
+            GameServer::Get()->SendToPlayers(n, p);
+            row.Claim.Grab(p->GetId(), GameServer::Get()->GetTick());
+        }
+        if (q.Action == WorldItemAction::Physics)
+            row.Claim.Grab(p->GetId(), GameServer::Get()->GetTick());
+        id = row.Data.Id;
+        m_items.emplace(id, std::move(row));
+    }
+    auto it = m_items.find(id);
+    if (it == m_items.end() || !InRange(p, it->second.Data))
+        return;
+    auto& row = it.value();
+    const auto now = GameServer::Get()->GetTick();
+    switch (q.Action)
+    {
+    case WorldItemAction::Drop:
+    case WorldItemAction::Register: break;
+    case WorldItemAction::Physics:
+    case WorldItemAction::Grab:
+        if (!row.Claim.Grab(p->GetId(), now))
+            return;
+        break;
+    case WorldItemAction::Move:
+        if (!row.Claim.Move(p->GetId(), now) || (!row.Data.WorldSpace && q.Data.Cell != row.Data.Cell) || q.Data.WorldSpace != row.Data.WorldSpace || !InRange(p, q.Data))
+            return;
+        row.Data.Cell = q.Data.Cell;
+        row.Data.X = q.Data.X;
+        row.Data.Y = q.Data.Y;
+        row.Data.Z = q.Data.Z;
+        row.Data.RX = q.Data.RX;
+        row.Data.RY = q.Data.RY;
+        row.Data.RZ = q.Data.RZ;
+        break;
+    case WorldItemAction::Release:
+        if (!row.Claim.Release(p->GetId()))
+            return;
+        break;
+    case WorldItemAction::Pickup:
+        if (!row.Claim.Pickup(p->GetId()))
+        {
+            Broadcast(row);
+            return;
+        }
+        inv->Content.AddOrRemoveEntry(row.Data.Item);
+        Broadcast(row);
+        {
+            NotifyInventoryChanges n;
+            n.ServerId = World::ToInteger(actor);
+            n.OwnershipEpoch = owner->OwnershipEpoch;
+            n.Item = row.Data.Item;
+            GameServer::Get()->SendToPlayers(n);
+        }
+        return;
+    default: return;
+    }
+    Broadcast(row);
+}
