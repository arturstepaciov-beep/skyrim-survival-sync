+  public bindingResyncKey = false;
+  public resyncKeyLabel = 'Unbound';
+
+  public setResyncInterval(value: string): void {
+    const seconds = Number(value);
+    if (!Number.isFinite(seconds)) return;
+    this.resyncInterval = Math.max(1, Math.min(300, Math.round(seconds)));
+    this.client.setResyncInterval(this.resyncInterval);
+  }
+
+  public clearResyncKey(): void {
+    this.bindingResyncKey = false;
+    this.resyncKeyLabel = 'Unbound';
+    this.client.setResyncHotkey(0);
+  }
+
+  @HostListener('window:keydown', ['$event'])
+  public captureResyncKey(event: KeyboardEvent): void {
+    if (!this.bindingResyncKey) return;
+    event.preventDefault();
+    event.stopPropagation();
+    if (event.repeat) return;
+    if (event.key === 'Escape') { this.bindingResyncKey = false; return; }
+    const key = event.keyCode;
+    // Simple keys only; F2 and modifiers retain their existing menu/input roles.
+    if (key === 113 || key < 8 || key > 255 || [16, 17, 18, 91, 92].includes(key)) return;
+    this.client.setResyncHotkey(key);
+    this.resyncKeyLabel = event.key.toUpperCase();
+    this.bindingResyncKey = false;
+  }
+
+  public setAutoResync(enabled: boolean): void {
+    this.autoResync = enabled;
+    this.client.setAutoResync(enabled);
+  }
+
+  public resyncPending = false;
+
+  public resync(): void {
+    if (this.resyncPending) return;
+    this.resyncPending = true;
+    this.client.resync();
+    setTimeout(() => { this.resyncPending = false; }, 1000);
+  }
+
   public reconnect(): void {
     this.client.reconnect();
   }
