+    REQUIRE(PresentationSyncPolicy::SecondsRemaining(25.0, 0.0) == 25);
+    REQUIRE(PresentationSyncPolicy::SecondsRemaining(1.0, 0.0) == 1);
+    REQUIRE(PresentationSyncPolicy::SecondsRemaining(300.0, 299.01) == 1);
+}
+
+TEST_CASE("Jump and locomotion state stay on the displayed snapshot timeline", "[encoding.presentation]")
+{
+    // The next snapshot contains takeoff. Its graph state must not be shown early.
+    REQUIRE_FALSE(PresentationSyncPolicy::UseNextSample(1000.0, 1033));
+    REQUIRE_FALSE(PresentationSyncPolicy::UseNextSample(1032.99, 1033));
+    REQUIRE(PresentationSyncPolicy::UseNextSample(1033.0, 1033));
+    // The same boundary rule applies to landing and start/stop transitions.
+    REQUIRE(PresentationSyncPolicy::UseNextSample(1066.0, 1066));
+    REQUIRE(PresentationSyncPolicy::UseNextSample(1090.0, 1066));
+}
