+namespace
+{
+TP_THIS_FUNCTION(TSendPlayerGraphEvent, bool, IAnimationGraphManagerHolder, BSFixedString*);
+TSendPlayerGraphEvent* s_sendPlayerGraphEvent = nullptr;
+thread_local bool s_inGraphEvent = false;
+
+bool TP_MAKE_THISCALL(HookPlayerGraphEvent, IAnimationGraphManagerHolder, BSFixedString* eventName)
+{
+    if (s_inGraphEvent)
+        return TiltedPhoques::ThisCall(s_sendPlayerGraphEvent, apThis, eventName);
+    s_inGraphEvent = true;
+    const bool result = TiltedPhoques::ThisCall(s_sendPlayerGraphEvent, apThis, eventName);
+    auto* player = PlayerCharacter::Get();
+    const char* name = eventName ? eventName->AsAscii() : nullptr;
+    // Explicit adapter for TK Dodge's directional graph inputs. Do not broadcast all graph
+    // notifications: vanilla actions already have a separate replication path.
+    if (result && player && apThis == &player->animationGraphHolder && name &&
+        _strnicmp(name, "TKDodge", 7) == 0 && std::strlen(name) <= 64 && World::Get().GetTransport().IsOnline())
+    {
+        ActionEvent event;
+        event.Type = 0x100; // transient direct graph input, not a BGSAction
+        event.Tick = World::Get().GetTick();
+        event.ActorId = player->formID;
+        event.EventName = name;
+        uint32_t step = 0;
+        BSFixedString stepName("iStep");
+        player->animationGraphHolder.GetVariableInt(&stepName, &step);
+        event.State1 = step <= 2 ? step : 0; // TK roll/step selection, not vanilla actor flags.
+        event.State2 = player->actorState.flags2;
+        player->SaveAnimationVariables(event.Variables);
+        World::Get().GetRunner().Trigger(event);
+        spdlog::info("TK Dodge graph input queued: {}", name);
+    }
+    s_inGraphEvent = false;
+    return result;
+}
+struct PlayerGraphHook
+{
+    entt::scoped_connection update;
+    void OnUpdate(const UpdateEvent&)
+    {
+        if (s_sendPlayerGraphEvent) return;
+        auto* player = PlayerCharacter::Get();
+        if (!player || !player->GetNiNode()) return;
+        auto** vtable = *reinterpret_cast<void***>(&player->animationGraphHolder);
+        s_sendPlayerGraphEvent = reinterpret_cast<TSendPlayerGraphEvent*>(vtable[1]);
+        TP_HOOK(&s_sendPlayerGraphEvent, HookPlayerGraphEvent);
+        spdlog::info("Installed TK Dodge player graph event hook");
+    }
+};
+}
+void InstallPlayerGraphSync(entt::dispatcher& dispatcher)
+{
+    static PlayerGraphHook hook;
+    hook.update = dispatcher.sink<UpdateEvent>().connect<&PlayerGraphHook::OnUpdate>(&hook);
+}
