diff --git a/Code/common/CoopChestStore.h b/Code/common/CoopChestStore.h
new file mode 100644
index 00000000..5d581cda
--- /dev/null
+++ b/Code/common/CoopChestStore.h
@@ -0,0 +1,144 @@
+#pragma once
+#include <Structs/Inventory.h>
+#include <HomesteadInventory.h>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+#include <cstring>
+#include <cmath>
+#include <chrono>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#else
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+namespace CoopChestStore
+{
+using Bytes = std::vector<uint8_t>;
+using NameOf = std::function<std::optional<std::string>(uint32_t)>;
+using Resolve = std::function<std::optional<GameId>(const std::string&, uint32_t)>;
+constexpr size_t MaxBytes = 16 * 1024 * 1024;
+constexpr size_t MaxEntries = 4096;
+inline uint64_t Checksum(const Bytes& b)
+{
+    uint64_t h = 14695981039346656037ull;
+    for (auto c : b) { h ^= c; h *= 1099511628211ull; }
+    return h;
+}
+struct Writer
+{
+    Bytes Data;
+    bool Good{true};
+    void U32(uint32_t n) { if (!Good || Data.size() + 4 > MaxBytes) { Good = false; return; } for (int i = 0; i < 4; ++i) Data.push_back(static_cast<uint8_t>(n >> (i * 8))); }
+    void Float(float f) { uint32_t n{}; std::memcpy(&n, &f, 4); if (!std::isfinite(f)) Good = false; U32(n); }
+    void Id(GameId id, const NameOf& nameOf)
+    {
+        if (!id) { U32(0); U32(0); return; }
+        const auto name = nameOf(id.ModId);
+        if (!name || name->empty() || name->size() > 260) { Good = false; return; }
+        if (!Good || Data.size() + name->size() + 8 > MaxBytes) { Good = false; return; }
+        U32(static_cast<uint32_t>(name->size())); Data.insert(Data.end(), name->begin(), name->end()); U32(id.BaseId);
+    }
+};
+struct Reader
+{
+    const Bytes& Data;
+    size_t Position{};
+    bool Good{true};
+    uint32_t U32()
+    {
+        if (Position + 4 > Data.size()) { Good = false; return 0; }
+        uint32_t n{}; for (int i = 0; i < 4; ++i) n |= uint32_t(Data[Position++]) << (i * 8); return n;
+    }
+    float Float() { auto n = U32(); float f{}; std::memcpy(&f, &n, 4); if (!std::isfinite(f)) Good = false; return f; }
+    GameId Id(const Resolve& resolve)
+    {
+        auto n = U32();
+        if (!Good || n > 260 || Position + n + 4 > Data.size()) { Good = false; return {}; }
+        std::string name(Data.begin() + Position, Data.begin() + Position + n); Position += n;
+        auto base = U32();
+        if (!n && !base) return {};
+        if (!n || name.find('\0') != std::string::npos) { Good = false; return {}; }
+        auto id = resolve(name, base); if (!id) { Good = false; return {}; } return *id;
+    }
+};
+inline std::optional<Bytes> Encode(const Inventory& inv, const NameOf& nameOf)
+{
+    if (inv.Entries.size() > MaxEntries) return {};
+    Writer w; w.Data.insert(w.Data.end(), {'S','T','C','O','O','P','0','1'}); w.U32(static_cast<uint32_t>(inv.Entries.size()));
+    for (const auto& e : inv.Entries)
+    {
+        if (!HomesteadInventory::Supported(e) || e.ExtraWorn || e.ExtraWornLeft || e.Count <= 0 || e.EnchantData.Effects.size() > 64) return {};
+        w.Id(e.BaseId, nameOf); w.U32(static_cast<uint32_t>(e.Count)); w.Float(e.ExtraCharge);
+        w.Id(e.ExtraEnchantId, nameOf); w.U32(e.ExtraEnchantCharge); w.U32(e.EnchantData.IsWeapon ? 1 : 0);
+        w.U32(static_cast<uint32_t>(e.EnchantData.Effects.size()));
+        for (const auto& f : e.EnchantData.Effects)
+        {
+            w.Float(f.Magnitude); w.U32(static_cast<uint32_t>(f.Area)); w.U32(static_cast<uint32_t>(f.Duration)); w.Float(f.RawCost); w.Id(f.EffectId, nameOf);
+        }
+        w.Float(e.ExtraHealth); w.Id(e.ExtraPoisonId, nameOf); w.U32(e.ExtraPoisonCount); w.U32(static_cast<uint32_t>(e.ExtraSoulLevel));
+        w.U32(e.ExtraEnchantRemoveUnequip ? 1 : 0);
+    }
+    if (!w.Good || w.Data.size() + 8 > MaxBytes) return {};
+    const auto sum = Checksum(w.Data); w.U32(static_cast<uint32_t>(sum)); w.U32(static_cast<uint32_t>(sum >> 32)); return w.Data;
+}
+inline bool Decode(const Bytes& bytes, const Resolve& resolve, Inventory& out)
+{
+    if (bytes.size() < 20 || bytes.size() > MaxBytes || std::memcmp(bytes.data(), "STCOOP01", 8) != 0) return false;
+    Bytes body(bytes.begin(), bytes.end() - 8);
+    Reader tail{bytes, bytes.size() - 8}; const uint64_t low = tail.U32(), high = tail.U32();
+    if (Checksum(body) != (low | (high << 32))) return false;
+    Reader r{body, 8}; const auto count = r.U32(); if (count > MaxEntries) return false;
+    Inventory result;
+    for (uint32_t i = 0; i < count && r.Good; ++i)
+    {
+        Inventory::Entry e; e.BaseId = r.Id(resolve); e.Count = static_cast<int32_t>(r.U32()); e.ExtraCharge = r.Float();
+        e.ExtraEnchantId = r.Id(resolve); auto charge = r.U32(); if (charge > 65535) return false; e.ExtraEnchantCharge = static_cast<uint16_t>(charge);
+        auto weapon = r.U32(); if (weapon > 1) return false; e.EnchantData.IsWeapon = weapon != 0;
+        const auto effects = r.U32(); if (effects > 64) return false;
+        for (uint32_t j = 0; j < effects && r.Good; ++j)
+        {
+            Inventory::EffectItem f; f.Magnitude = r.Float(); f.Area = static_cast<int32_t>(r.U32()); f.Duration = static_cast<int32_t>(r.U32()); f.RawCost = r.Float(); f.EffectId = r.Id(resolve); e.EnchantData.Effects.push_back(f);
+        }
+        e.ExtraHealth = r.Float(); e.ExtraPoisonId = r.Id(resolve); e.ExtraPoisonCount = r.U32(); e.ExtraSoulLevel = static_cast<int32_t>(r.U32());
+        auto remove = r.U32(); if (remove > 1) return false; e.ExtraEnchantRemoveUnequip = remove != 0;
+        if (!r.Good || e.Count <= 0 || !HomesteadInventory::Supported(e)) return false;
+        result.Entries.push_back(std::move(e));
+    }
+    if (!r.Good || r.Position != body.size()) return false;
+    out = std::move(result); return true;
+}
+inline std::optional<Bytes> Read(const std::filesystem::path& path)
+{
+    std::ifstream f(path, std::ios::binary | std::ios::ate); if (!f) return {};
+    auto size = f.tellg(); if (size < 0 || size > std::streamoff(MaxBytes)) return {};
+    Bytes b(static_cast<size_t>(size)); f.seekg(0); f.read(reinterpret_cast<char*>(b.data()), size);
+    if (!f) return {};
+    return b;
+}
+inline bool Save(const std::filesystem::path& path, const Bytes& bytes)
+{
+    if (bytes.size() > MaxBytes) return false;
+    std::error_code ec; std::filesystem::create_directories(path.parent_path(), ec); if (ec) return false;
+    auto temp = path; temp += ".tmp";
+    { std::ofstream f(temp, std::ios::binary | std::ios::trunc); if (!f) return false;
+      f.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size())); f.flush(); if (!f) return false; }
+#ifdef _WIN32
+    auto handle = CreateFileW(temp.c_str(), GENERIC_WRITE, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (handle == INVALID_HANDLE_VALUE) return false;
+    const bool flushed = FlushFileBuffers(handle) != 0; CloseHandle(handle); if (!flushed) return false;
+    return MoveFileExW(temp.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+    int fd = ::open(temp.c_str(), O_WRONLY); if (fd < 0) return false; bool flushed = ::fsync(fd) == 0; ::close(fd); if (!flushed) return false;
+    std::filesystem::rename(temp, path, ec); return !ec;
+#endif
+}
+}
