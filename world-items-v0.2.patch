diff --git a/Code/common/PresentationSyncPolicy.h b/Code/common/PresentationSyncPolicy.h
new file mode 100644
--- /dev/null
+++ b/Code/common/PresentationSyncPolicy.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+namespace PresentationSyncPolicy
+{
+// The HUD uses the native scheduler's elapsed time, including its loading-screen pause.
+inline int SecondsRemaining(double interval, double elapsed) noexcept
+{
+    if (!std::isfinite(interval) || !std::isfinite(elapsed))
+        return 0;
+    return static_cast<int>(std::ceil(std::clamp(interval - elapsed, 0.0, 300.0)));
+}
+
+// Discrete graph state must never run ahead of the displayed owner timeline.
+inline bool UseNextSample(double renderTick, uint64_t nextTick) noexcept
+{
+    return renderTick >= static_cast<double>(nextTick);
+}
+inline constexpr size_t MaxActionsPerFrame = 32;
+}
