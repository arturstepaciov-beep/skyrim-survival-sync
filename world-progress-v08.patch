+
+void ActorValueService::SendNpcHealth(uint32_t id, uint32_t epoch, float delta, float maximum) noexcept
+{
+    if (!id || !epoch || !std::isfinite(delta) || !PercentageHealth::ValidMaximum(maximum)) return;
+    RequestHealthChangeBroadcast request;
+    request.Id = id; request.Percentage = true; request.OwnershipEpoch = epoch;
+    request.Serial = ++m_healthSequence; request.DeltaHealth = delta; request.MaximumHealth = maximum;
+    m_transport.Send(request);
+}
+
+void ActorValueService::ReapplyNpcHealth(Actor* actor) const noexcept
+{
+    if (!actor || actor->GetExtension()->IsPlayer() || actor->IsEssential() || !actor->GetNiNode() ||
+        actor->GetExtension()->Reconciliation != ActorExtension::ReconciliationStage::None) return;
+    auto token = Utils::GetLocalOwnershipToken(actor->formID);
+    if (!token) token = Utils::GetRemoteOwnershipToken(actor->formID);
+    if (!token) return;
+    const auto found = m_npcHealth.find(token->ServerId);
+    if (found == m_npcHealth.end() || found->second.Epoch != token->OwnershipEpoch) return;
+    const auto maximum = actor->GetActorPermanentValue(ActorValueInfo::kHealth);
+    if (!PercentageHealth::ValidMaximum(maximum)) return;
+    const auto fraction = found->second.Fraction;
+    if (fraction > 0.f && actor->IsDead())
+    {
+        // Let the simulation owner report native/scripted deaths before an old
+        // alive snapshot can revive the actor and hide the death transition.
+        if (!Utils::GetLocalOwnershipToken(actor->formID)) actor->Respawn();
+        return;
+    }
+    actor->ForceActorValue(ActorValueOwner::ForceMode::DAMAGE, ActorValueInfo::kHealth, fraction * maximum);
+    if (fraction == 0.f && !actor->IsDead()) actor->Kill();
+}
+
+void ActorValueService::PollNpcHealth() noexcept
+{
+    if (!m_transport.IsOnline() || m_world.GetTick() < m_nextNpcPoll) return;
+    m_nextNpcPoll = m_world.GetTick() + 1000;
+    auto view = m_world.view<FormIdComponent>();
+    for (auto entity : view)
+    {
+        auto* actor = Cast<Actor>(TESForm::GetById(view.get<FormIdComponent>(entity).Id));
+        if (!actor || !actor->GetNiNode() || actor->GetExtension()->IsPlayer() || actor->IsEssential()) continue;
+        const auto* local = m_world.try_get<LocalComponent>(entity);
+        const auto* remote = m_world.try_get<RemoteComponent>(entity);
+        const auto id = local ? local->Id : remote ? remote->Id : 0;
+        const auto epoch = local ? local->OwnershipEpoch : remote ? remote->OwnershipEpoch : 0;
+        if (!id || !epoch) continue;
+        ReapplyNpcHealth(actor);
+        const auto cached = m_npcHealth.find(id);
+        if (local || cached == m_npcHealth.end() || cached->second.Epoch != epoch)
+            SendNpcHealth(id, epoch, 0.f, actor->GetActorPermanentValue(ActorValueInfo::kHealth));
+    }
+}
