diff --git a/Code/server/Services/QuestRewardSync.cpp b/Code/server/Services/QuestRewardSync.cpp
new file mode 100644
index 00000000..6976c67c
--- /dev/null
+++ b/Code/server/Services/QuestRewardSync.cpp
@@ -0,0 +1,41 @@
+#include <Pch.h>
+#include <World.h>
+#include <GameServer.h>
+#include <Components.h>
+#include <Events/PacketEvent.h>
+#include <Messages/RequestHomestead.h>
+#include <Messages/NotifyHomestead.h>
+#include <Game/Player.h>
+#include <HomesteadInventory.h>
+#include <unordered_set>
+#include <string>
+
+namespace
+{
+struct Rewards
+{
+    entt::scoped_connection request;
+    std::unordered_set<std::string> awarded;
+    void OnRequest(const PacketEvent<RequestHomestead>& e)
+    {
+        const auto& q = e.Packet.Data; auto* player = e.pPlayer;
+        if (q.Action != HomesteadAction::QuestRewardClaim || !player || !player->GetParty().JoinedPartyId ||
+            q.RewardSource.size() < 4 || q.RewardSource.size() > 240 || !q.Token || q.Item.Count <= 0 || q.Item.Count > 32767 ||
+            !HomesteadInventory::Supported(q.Item)) return;
+        const std::string source(q.RewardSource.c_str());
+        if (source.rfind("QF_", 0) && source.rfind("TIF_", 0)) return;
+        if (source.find("/Fragment_") == std::string::npos) return;
+        const auto key = std::to_string(*player->GetParty().JoinedPartyId) + ":" + source + ":" +
+            std::to_string(q.Item.BaseId.ModId) + ":" + std::to_string(q.Item.BaseId.BaseId) + ":" + std::to_string(q.Token);
+        if (!awarded.insert(key).second) return;
+        NotifyHomestead grant; grant.Data = q; grant.Data.Action = HomesteadAction::QuestRewardGrant;
+        grant.Data.Authority = player->GetId(); grant.Data.Accepted = true;
+        GameServer::Get()->SendToParty(grant, player->GetParty());
+    }
+};
+}
+void InstallQuestRewardSync(entt::dispatcher& dispatcher)
+{
+    static Rewards rewards;
+    rewards.request = dispatcher.sink<PacketEvent<RequestHomestead>>().connect<&Rewards::OnRequest>(&rewards);
+}
