diff --git a/Code/common/HousingLayoutPolicy.h b/Code/common/HousingLayoutPolicy.h
new file mode 100644
index 00000000..4013ad70
--- /dev/null
+++ b/Code/common/HousingLayoutPolicy.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+namespace HousingLayout
+{
+struct Parent { uint32_t Key; bool Opposite; };
+// Children never publish their inherited enable state as an independent edit.
+template<class GetParent, class GetRoot> std::optional<bool> Disabled(uint32_t key, GetParent parent, GetRoot root)
+{
+    bool invert{};
+    for (unsigned depth = 0; depth < 64; ++depth)
+    {
+        const auto link = parent(key);
+        if (!link)
+        {
+            const auto state = root(key);
+            return state ? std::optional<bool>(*state != invert) : std::nullopt;
+        }
+        if (link->Key == key) return {};
+        invert = invert != link->Opposite; key = link->Key;
+    }
+    return {}; // malformed/cyclic chains never alter the world
+}
+inline bool BeforeDisabled(bool beforeDisabled, bool replacementEnabled)
+{
+    return beforeDisabled || replacementEnabled;
+}
+}
diff --git a/Code/common/PercentageHealth.h b/Code/common/PercentageHealth.h
new file mode 100644
index 00000000..69ce7a3e
--- /dev/null
+++ b/Code/common/PercentageHealth.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <unordered_map>
+
+namespace PercentageHealth
+{
+inline bool ValidMaximum(float maximum) { return std::isfinite(maximum) && maximum > 0.f; }
+inline float Ratio(float current, float maximum)
+{
+    return ValidMaximum(maximum) && std::isfinite(current) ? std::clamp(current / maximum, 0.f, 1.f) : 1.f;
+}
+inline float Delta(float damageOrHealing, float maximum)
+{
+    return std::isfinite(damageOrHealing) && ValidMaximum(maximum)
+        ? std::clamp(damageOrHealing / maximum, -1.f, 1.f) : 0.f;
+}
+struct State
+{
+    double Fraction{1.0};
+    uint64_t Revision{1};
+    uint32_t Epoch{};
+    std::unordered_map<uint32_t, uint64_t> LastSequence;
+
+    void Seed(float current, float maximum, bool dead)
+    {
+        Fraction = dead ? 0.0 : Ratio(current, maximum);
+        Revision = 1; Epoch = 0; LastSequence.clear();
+    }
+    // The caller validates the packet against the actor's CURRENT ownership epoch.
+    bool Apply(uint32_t epoch, uint32_t sender, uint64_t sequence, float delta)
+    {
+        if (!epoch || !sequence || !std::isfinite(delta) || delta < -1.f || delta > 1.f) return false;
+        if (Epoch != epoch) { Epoch = epoch; LastSequence.clear(); }
+        auto& last = LastSequence[sender];
+        if (sequence <= last) return false;
+        last = sequence;
+        // Healing never resurrects a shared corpse. World respawns need a new entity/reset.
+        if (Fraction > 0.0 && delta != 0.f)
+        { Fraction = std::clamp(Fraction + static_cast<double>(delta), 0.0, 1.0); if (Fraction < 1e-6) Fraction = 0.0; ++Revision; }
+        return true;
+    }
+    void Kill() { if (Fraction != 0.0) { Fraction = 0.0; ++Revision; } }
+};
+}
diff --git a/Code/common/QuestRewardPolicy.h b/Code/common/QuestRewardPolicy.h
new file mode 100644
index 00000000..8accb818
--- /dev/null
+++ b/Code/common/QuestRewardPolicy.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+namespace QuestRewards
+{
+// Identity is a script fragment/callsite plus item form. Occurrences allow the
+// same radiant reward to be earned again without replaying an earlier grant.
+struct Ledger
+{
+    struct Claim { uint32_t Occurrence; bool Suppress; };
+    std::unordered_map<std::string, uint32_t> Counts;
+    std::unordered_set<std::string> Native, Granted;
+    static std::string Key(const std::string& source, uint32_t occurrence) { return source + ":" + std::to_string(occurrence); }
+    Claim BeginNative(const std::string& source)
+    {
+        const auto occurrence = ++Counts[source]; const auto key = Key(source, occurrence);
+        if (Granted.contains(key)) return {occurrence, true};
+        Native.insert(key); return {occurrence, false};
+    }
+    bool Receive(const std::string& source, uint32_t occurrence)
+    {
+        if (!occurrence) return false;
+        const auto key = Key(source, occurrence);
+        return Granted.insert(key).second && !Native.contains(key);
+    }
+};
+}
