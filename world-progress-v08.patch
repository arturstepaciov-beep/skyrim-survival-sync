diff --git a/Code/common/WorldProgressPolicy.h b/Code/common/WorldProgressPolicy.h
new file mode 100644
index 00000000..78f399b3
--- /dev/null
+++ b/Code/common/WorldProgressPolicy.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <vector>
+#include <cmath>
+#include <cstdint>
+#include <algorithm>
+namespace WorldProgress
+{
+struct Value
+{
+    uint32_t Key{};
+    uint64_t Revision{};
+    std::vector<float> Numbers;
+    std::vector<float> Previous;
+};
+inline bool Valid(const Value& value)
+{
+    return !value.Numbers.empty() && value.Numbers.size() <= 128 &&
+        std::all_of(value.Numbers.begin(), value.Numbers.end(), [](float f) { return std::isfinite(f) && std::abs(f) < 1000000000.f; });
+}
+inline bool Commit(Value& state, const Value& request)
+{
+    if (!Valid(request) || state.Key != request.Key || state.Numbers.size() != request.Numbers.size()) return false;
+    if (state.Revision != request.Revision)
+    {
+        if (request.Previous.size() != state.Numbers.size()) return false;
+        auto merged = state.Numbers; bool changed{};
+        for (size_t i = 0; i < merged.size(); ++i)
+        {
+            if (!std::isfinite(request.Previous[i])) return false;
+            if (request.Numbers[i] == request.Previous[i]) continue;
+            if (merged[i] != request.Previous[i] && merged[i] != request.Numbers[i]) return false;
+            changed |= merged[i] != request.Numbers[i]; merged[i] = request.Numbers[i];
+        }
+        if (!changed) return false;
+        state.Numbers = std::move(merged); ++state.Revision; return true;
+    }
+    state.Numbers = request.Numbers; ++state.Revision; return true;
+}
+inline bool Harvest(Value& plot, uint64_t expectedRevision, float day)
+{
+    if (!Valid(plot) || plot.Numbers.size() != 4 || plot.Revision != expectedRevision || !std::isfinite(day)) return false;
+    auto& v = plot.Numbers;
+    if (v[0] <= 0 || day - v[1] < 1.f || (v[2] != 0.f && day - v[3] < 3.f)) return false;
+    v[2] = 1.f; v[3] = day; ++plot.Revision; return true;
+}
+}
