diff --git a/Code/client/Services/Generic/CoopHud.cpp b/Code/client/Services/Generic/CoopHud.cpp
new file mode 100644
index 00000000..1ca1b1a4
--- /dev/null
+++ b/Code/client/Services/Generic/CoopHud.cpp
@@ -0,0 +1,181 @@
+#include <TiltedOnlinePCH.h>
+#include <World.h>
+#include <Components.h>
+#include <Services/OverlayService.h>
+#include <Services/TransportService.h>
+#include <Services/PapyrusService.h>
+#include <Services/ScriptStateAccess.h>
+#include <OverlayApp.hpp>
+#include <PlayerCharacter.h>
+#include <Camera/PlayerCamera.h>
+#include <Games/TES.h>
+#include <Forms/TESGlobal.h>
+#include <Forms/TESObjectCELL.h>
+#include <Forms/TESWorldSpace.h>
+#include <Interface/UI.h>
+#include <Games/Memory.h>
+#include <Structs/GridCellCoords.h>
+#include <Events/UpdateEvent.h>
+#include <Events/DisconnectedEvent.h>
+#include <Messages/NotifyPlayerCellChanged.h>
+#include <unordered_map>
+#include <algorithm>
+#include <cmath>
+
+namespace
+{
+TESForm* SurvivalForm(uint32_t base)
+{
+    auto* mods = ModManager::Get(); auto* mod = mods ? mods->GetByName("ccqdrsse001-survivalmode.esl") : nullptr;
+    return mod && mod->IsLoaded() ? TESForm::GetById(mod->GetFormId(base)) : nullptr;
+}
+struct CoopHud
+{
+    std::unordered_map<uint32_t, NotifyPlayerCellChanged> locations;
+    struct Marker { uint32_t Reference{}; GameId World{}; glm::vec3 Position{}; };
+    std::unordered_map<uint32_t, Marker> markers;
+    entt::scoped_connection update, notify, disconnected;
+    uint64_t next{};
+    void OnLocation(const NotifyPlayerCellChanged& n)
+    {
+        if (n.HasPosition && std::isfinite(n.Position.x) && std::isfinite(n.Position.y) && std::isfinite(n.Position.z)) locations[n.PlayerId] = n;
+    }
+    void RemoveMarker(Marker& marker)
+    {
+        auto* ref = Cast<TESObjectREFR>(TESForm::GetById(marker.Reference));
+        if (ref && !ref->IsDeleted()) { ref->Disable(); ref->Delete(); }
+        marker.Reference = 0;
+    }
+    void OnDisconnect(const DisconnectedEvent&)
+    {
+        for (auto& [id, marker] : markers) RemoveMarker(marker);
+        markers.clear(); locations.clear(); next = 0;
+    }
+    void UpdateMarker(uint32_t id, const char* name, const NotifyPlayerCellChanged& location)
+    {
+        auto& world = World::Get(); auto& marker = markers[id];
+        // A world map marker has no meaningful position inside an interior.
+        if (!location.WorldSpaceId) { RemoveMarker(marker); return; }
+        auto* space = Cast<TESWorldSpace>(TESForm::GetById(world.GetModSystem().GetGameId(location.WorldSpaceId)));
+        auto* player = PlayerCharacter::Get(); if (!space || !player) return;
+        auto* ref = Cast<TESObjectREFR>(TESForm::GetById(marker.Reference));
+        if (ref && ref->IsDeleted()) ref = nullptr;
+        if (ref && marker.World == location.WorldSpaceId && glm::distance(marker.Position, location.Position) < 70.f) return;
+        const auto grid = GridCellCoords::CalculateGridCellCoords(location.Position.x, location.Position.y);
+        auto* cell = space->LoadCell(grid.X, grid.Y); if (!cell) return;
+        if (!ref)
+        {
+            const auto* fn = world.ctx().at<PapyrusService>().Get("ObjectReference", "PlaceAtMe");
+            if (!fn) return;
+            PapyrusFunction<TESObjectREFR*, TESObjectREFR, TESForm*, int32_t, bool, bool> place(fn);
+            ref = place(player, TESForm::GetById(0x10), 1, false, true); if (!ref) return;
+            // Native SE/AE ExtraMapMarker/MapMarkerData layouts, with engine
+            // vtables so saves and reference cleanup use the engine destructors.
+            struct MapData { void* NameVtable; BSFixedString Name; uint8_t Flags; uint8_t Pad; uint16_t Type; uint32_t Padding; };
+            struct MapExtra { void* Vtable; BSExtraData* Next; MapData* Data; };
+            static_assert(sizeof(MapData) == 0x18 && sizeof(MapExtra) == 0x18);
+            auto* data = static_cast<MapData*>(Memory::Allocate(sizeof(MapData))); memset(data, 0, sizeof(MapData));
+            VersionDbPtr<void> nameVtable(228543); data->NameVtable = nameVtable.Get();
+            data->Name.Set((std::string("Co-op: ") + name).c_str()); data->Flags = 1; data->Type = 64;
+            auto* extra = static_cast<MapExtra*>(Memory::Allocate(sizeof(MapExtra))); memset(extra, 0, sizeof(MapExtra));
+            VersionDbPtr<void> extraVtable(229884); extra->Vtable = extraVtable.Get(); extra->Data = data;
+            ref->extraData.Add(static_cast<ExtraDataType>(0x2C), reinterpret_cast<BSExtraData*>(extra));
+            marker.Reference = ref->formID;
+        }
+        ref->MoveTo(cell, NiPoint3(location.Position)); ref->EnableImpl();
+        const auto* add = world.ctx().at<PapyrusService>().Get("ObjectReference", "AddToMap");
+        if (add) { PapyrusFunction<void, TESObjectREFR, bool> show(add); show(ref, false); }
+        marker.World = location.WorldSpaceId; marker.Position = location.Position;
+    }
+    void OnUpdate(const UpdateEvent&)
+    {
+        auto& world = World::Get(); const auto now = world.GetTick();
+        if (now < next) return; next = now + 100;
+        auto* overlay = world.GetOverlayService().GetOverlayApp();
+        auto* player = PlayerCharacter::Get();
+        if (!overlay || !player || !player->GetNiNode() || !player->parentCell || !player->parentCell->IsAttached()) return;
+        if (auto* ui = UI::Get(); ui && ui->GetMenuOpen(BSFixedString("Loading Menu"))) return;
+        double hunger = -1;
+        auto* enabled = Cast<TESGlobal>(SurvivalForm(0x826));
+        auto* value = Cast<TESGlobal>(SurvivalForm(0x81A));
+        auto* maximum = Cast<TESGlobal>(SurvivalForm(0x80C));
+        if (enabled && enabled->f != 0 && value && maximum && maximum->f > 0 && std::isfinite(value->f))
+            hunger = std::clamp(double(value->f / maximum->f), 0.0, 1.0);
+        // Survival's own condition records when its watcher disabled fast travel.
+        // Restore that control without stopping hunger/cold/exhaustion quests.
+        if (hunger >= 0)
+        {
+            auto* conditions = ScriptStateAccess::Form(SurvivalForm(0x897), "Survival_PlayerInfo", "conditions");
+            std::vector<float> state;
+            if (conditions && ScriptStateAccess::Numbers(conditions, "Survival_ConditionsScript", "isFastTravelControlsEnabled", 0, state) && !state.empty() && state[0] == 0)
+            {
+                const auto* fn = world.ctx().at<PapyrusService>().Get("Game", "EnableFastTravel");
+                if (fn)
+                {
+                    GlobalPapyrusFunction<void, bool> enable(fn); enable(true);
+                    state[0] = 1;
+                    ScriptStateAccess::Numbers(conditions, "Survival_ConditionsScript", "isFastTravelControlsEnabled", 0, state, true);
+                }
+            }
+        }
+        auto entries = CefListValue::Create(); size_t index = 0;
+        const auto& party = world.GetPartyService();
+        for (auto it = markers.begin(); it != markers.end();)
+        {
+            const auto& members = party.GetPartyMembers();
+            if (!party.IsInParty() || std::find(members.begin(), members.end(), it->first) == members.end())
+            { RemoveMarker(it->second); it = markers.erase(it); }
+            else ++it;
+        }
+        if (world.GetTransport().IsOnline() && party.IsInParty())
+        for (const auto id : party.GetPartyMembers())
+        {
+            if (id == world.GetTransport().GetLocalPlayerId()) continue;
+            const auto name = party.GetPlayers().find(id); if (name == party.GetPlayers().end()) continue;
+            auto data = CefDictionaryValue::Create(); data->SetInt("id", id); data->SetString("name", name->second.c_str());
+            bool same = false; glm::vec3 position{};
+            if (const auto found = locations.find(id); found != locations.end())
+            {
+                const auto& location = found->second; position = location.Position;
+                UpdateMarker(id, name->second.c_str(), location);
+                auto* worldspace = player->GetWorldSpace();
+                same = worldspace ? world.GetModSystem().GetGameId(location.WorldSpaceId) == worldspace->formID :
+                    !location.WorldSpaceId && world.GetModSystem().GetGameId(location.CellId) == player->parentCell->formID;
+            }
+            bool visible = false;
+            for (auto entity : world.view<PlayerComponent, FormIdComponent>())
+            {
+                if (world.get<PlayerComponent>(entity).Id != id) continue;
+                auto* actor = Cast<Actor>(TESForm::GetById(world.get<FormIdComponent>(entity).Id));
+                if (!actor || !actor->GetNiNode() ||
+                    (actor->GetWorldSpace() != player->GetWorldSpace()) ||
+                    (!player->GetWorldSpace() && actor->GetParentCellEx() != player->GetParentCellEx())) continue;
+                position = glm::vec3(actor->position); same = true;
+                auto point = actor->position; point.z += actor->GetHeight() + 12.f;
+                NiPoint3 screen{}; auto* camera = PlayerCamera::Get();
+                visible = camera && camera->WorldPtToScreenPt3(point, screen) && screen.z >= 0 && screen.x > 0 && screen.x < 1 && screen.y > 0 && screen.y < 1;
+                data->SetDouble("x", screen.x * 100.0); data->SetDouble("y", (1.0 - screen.y) * 100.0);
+                break;
+            }
+            data->SetBool("visible", visible); data->SetBool("sameArea", same);
+            if (same)
+            {
+                const auto delta = position - glm::vec3(player->position);
+                const double bearing = std::remainder(std::atan2(delta.x, delta.y) - player->rotation.z, 6.283185307179586);
+                data->SetDouble("bearing", bearing * 180.0 / 3.141592653589793);
+                data->SetDouble("distance", glm::length(delta) / 70.0);
+            }
+            entries->SetDictionary(index++, data);
+        }
+        auto args = CefListValue::Create(); args->SetDouble(0, hunger); args->SetList(1, entries);
+        overlay->ExecuteAsync("coopHud", args);
+    }
+};
+}
+void InstallCoopHud(entt::dispatcher& dispatcher)
+{
+    static CoopHud hud;
+    hud.update = dispatcher.sink<UpdateEvent>().connect<&CoopHud::OnUpdate>(&hud);
+    hud.notify = dispatcher.sink<NotifyPlayerCellChanged>().connect<&CoopHud::OnLocation>(&hud);
+    hud.disconnected = dispatcher.sink<DisconnectedEvent>().connect<&CoopHud::OnDisconnect>(&hud);
+}
