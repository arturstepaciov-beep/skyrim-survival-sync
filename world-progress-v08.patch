+#include <Messages/NotifyPlayerCellChanged.h>
+using namespace TiltedPhoques;
+TEST_CASE("Co-op reward and chest delta packets preserve identities", "[encoding.worldprogress]")
+{
+    for (auto action : {HomesteadAction::QuestRewardClaim, HomesteadAction::QuestRewardGrant, HomesteadAction::CoopDelta})
+    {
+        HomesteadData q; q.Action = action; q.Token = 5; q.Authority = 42;
+        q.RewardSource = "TIF_Test/Fragment_0/123"; q.Item.BaseId = GameId(0, 0xF); q.Item.Count = 250;
+        Buffer buffer(4096); Buffer::Writer writer(&buffer); q.Serialize(writer);
+        Buffer::Reader reader(&buffer); HomesteadData decoded; decoded.Deserialize(reader);
+        REQUIRE(decoded.Action == action); REQUIRE(decoded.Token == q.Token); REQUIRE(decoded.Authority == 42);
+        REQUIRE(decoded.RewardSource == q.RewardSource); REQUIRE(decoded.Item == q.Item);
+    }
+    NotifyPlayerCellChanged position; position.PlayerId = 7; position.WorldSpaceId = GameId(0, 0x3C);
+    position.CellId = GameId(0, 0xABCD); position.Position = glm::vec3(-73000, 850, -4900); position.HasPosition = true;
+    Buffer buffer(4096); Buffer::Writer writer(&buffer); position.Serialize(writer);
+    Buffer::Reader reader(&buffer); ServerMessageFactory factory; auto packet = factory.Extract(reader);
+    REQUIRE(packet); auto decoded = CastUnique<NotifyPlayerCellChanged>(std::move(packet)); REQUIRE(*decoded == position);
+}
+TEST_CASE("Percentage combat packets preserve sequences epochs and fractions", "[encoding.worldprogress]")
+{
+    RequestHealthChangeBroadcast q;
+    q.Id = 72; q.Percentage = true; q.OwnershipEpoch = 34; q.Serial = 0x100000001ULL;
+    q.DeltaHealth = -300; q.MaximumHealth = 1000;
+    Buffer buffer(4096); Buffer::Writer writer(&buffer); q.Serialize(writer);
+    Buffer::Reader reader(&buffer); ClientMessageFactory factory; auto packet = factory.Extract(reader);
+    REQUIRE(packet); auto decoded = CastUnique<RequestHealthChangeBroadcast>(std::move(packet));
+    REQUIRE(*decoded == q);
+    NotifyHealthChangeBroadcast n;
+    n.Id = q.Id; n.Percentage = true; n.OwnershipEpoch = q.OwnershipEpoch; n.Serial = q.Serial; n.HealthFraction = .6f;
+    Buffer response(4096); Buffer::Writer output(&response); n.Serialize(output);
+    Buffer::Reader input(&response); ServerMessageFactory serverFactory; auto message = serverFactory.Extract(input);
+    REQUIRE(message); auto result = CastUnique<NotifyHealthChangeBroadcast>(std::move(message));
+    REQUIRE(*result == n);
+}
+TEST_CASE("World progress wire preserves bounded state and harvest transactions", "[encoding.worldprogress]")
+{
+    for (auto action : {HomesteadAction::WorldPublish, HomesteadAction::WorldHarvest})
+    {
+        RequestHomestead q; q.Data.Action = action; q.Data.Token = 77; q.Data.Day = 73005.5f;
+        q.Data.Progress.push_back({0x100012, 0x100000002ULL, {4, 73004, 1, 73005}});
+        Buffer buffer(16384); Buffer::Writer writer(&buffer); q.Serialize(writer);
+        Buffer::Reader reader(&buffer); ClientMessageFactory factory; auto packet = factory.Extract(reader);
+        REQUIRE(packet); auto result = CastUnique<RequestHomestead>(std::move(packet));
+        REQUIRE(result->Data.Action == action); REQUIRE(result->Data.Token == 77);
+        REQUIRE(result->Data.Progress.size() == 1);
+        REQUIRE(result->Data.Progress[0].Key == 0x100012);
+        REQUIRE(result->Data.Progress[0].Revision == 0x100000002ULL);
+        REQUIRE(result->Data.Progress[0].Numbers == q.Data.Progress[0].Numbers);
+        REQUIRE(result->Data.Day == q.Data.Day);
+    }
+    HomesteadData data;
+    for (uint32_t i = 0; i < 40; ++i) data.Progress.push_back({i, 1, std::vector<float>(140, 1.f)});
+    Buffer buffer(32768); Buffer::Writer writer(&buffer); data.Serialize(writer);
+    Buffer::Reader reader(&buffer); HomesteadData result; result.Deserialize(reader);
+    REQUIRE(result.Progress.size() == 32);
+    REQUIRE(result.Progress[0].Numbers.size() == 128);
+}
