diff --git a/Code/tests/coop_fixes.cpp b/Code/tests/coop_fixes.cpp
new file mode 100644
index 00000000..ccbaf660
--- /dev/null
+++ b/Code/tests/coop_fixes.cpp
@@ -0,0 +1,47 @@
+#include <TiltedCore/Stl.hpp>
+#include <TiltedCore/Allocator.hpp>
+#include <TiltedCore/Buffer.hpp>
+#include <catch2/catch.hpp>
+#include <QuestRewardPolicy.h>
+#include <HomesteadInventory.h>
+#include <WorldProgressBindings.h>
+#include <cmath>
+TEST_CASE("Quest rewards are granted once regardless of which script runs first", "[coop-fixes]")
+{
+    QuestRewards::Ledger host, guest;
+    const auto hostClaim = host.BeginNative("QF_quest/Fragment_1/gold");
+    REQUIRE(hostClaim.Occurrence == 1); REQUIRE_FALSE(hostClaim.Suppress);
+    REQUIRE_FALSE(host.Receive("QF_quest/Fragment_1/gold", 1));
+    REQUIRE(guest.Receive("QF_quest/Fragment_1/gold", 1));
+    REQUIRE_FALSE(guest.Receive("QF_quest/Fragment_1/gold", 1));
+    const auto catchup = guest.BeginNative("QF_quest/Fragment_1/gold");
+    REQUIRE(catchup.Suppress); REQUIRE(catchup.Occurrence == 1);
+    // Another completion of a repeatable reward is a new occurrence.
+    const auto repeat = host.BeginNative("QF_quest/Fragment_1/gold");
+    REQUIRE_FALSE(repeat.Suppress); REQUIRE(repeat.Occurrence == 2);
+    REQUIRE(guest.Receive("QF_quest/Fragment_1/gold", 2));
+    // Simultaneous native grants must not receive an extra network copy.
+    host.BeginNative("TIF_dialogue/Fragment_0/item"); guest.BeginNative("TIF_dialogue/Fragment_0/item");
+    REQUIRE_FALSE(host.Receive("TIF_dialogue/Fragment_0/item", 1));
+    REQUIRE_FALSE(guest.Receive("TIF_dialogue/Fragment_0/item", 1));
+    REQUIRE_FALSE(host.Receive("invalid", 0));
+}
+TEST_CASE("Large chest reconciliation changes only the transferred variant", "[coop-fixes]")
+{
+    Inventory before, after;
+    for (uint32_t i = 1; i <= 1000; ++i) { Inventory::Entry e; e.BaseId = GameId(0, i); e.Count = 10; before.Entries.push_back(e); }
+    after = before; after.Entries[500].Count += 3;
+    auto delta = HomesteadInventory::Difference(before, after);
+    REQUIRE(delta.Entries.size() == 1); REQUIRE(delta.Entries[0].Count == 3);
+    REQUIRE(delta.Entries[0].BaseId == after.Entries[500].BaseId);
+    auto variant = after.Entries[500]; variant.ExtraHealth = 1.5f; variant.Count = 1; after.Entries.push_back(variant);
+    delta = HomesteadInventory::Difference(before, after);
+    REQUIRE(delta.Entries.size() == 2);
+    REQUIRE(delta.Entries[1].ExtraHealth == 1.5f);
+    REQUIRE(HomesteadInventory::Difference(after, after).Entries.empty());
+}
+TEST_CASE("All indexed farm plots have finite interaction coordinates", "[coop-fixes]")
+{
+    for (const auto& p : WorldProgress::Plots)
+    { REQUIRE(std::isfinite(p.X)); REQUIRE(std::isfinite(p.Y)); REQUIRE(std::isfinite(p.Z)); REQUIRE(p.Soil.Base != 0); }
+}
