@@ -0,0 +1,49 @@
+#include <catch2/catch.hpp>
+#include <HousingLayoutPolicy.h>
+#include <WorldProgressBindings.h>
+#include <cstring>
+#include <unordered_map>
+TEST_CASE("Housing layout follows initially enabled parents and inverted chains", "[housing-layout]")
+{
+    std::unordered_map<uint32_t, HousingLayout::Parent> links{{1,{0,false}},{2,{1,true}},{3,{2,true}}};
+    std::unordered_map<uint32_t,bool> roots{{0,false}};
+    auto parent = [&](uint32_t key)->std::optional<HousingLayout::Parent> { auto i=links.find(key); return i==links.end()?std::nullopt:std::optional(i->second); };
+    auto root = [&](uint32_t key)->std::optional<bool> { auto i=roots.find(key); return i==roots.end()?std::nullopt:std::optional(i->second); };
+    REQUIRE(HousingLayout::Disabled(1,parent,root) == false);
+    REQUIRE(HousingLayout::Disabled(2,parent,root) == true);
+    REQUIRE(HousingLayout::Disabled(3,parent,root) == false);
+    roots[0] = true; // buying the upgrade disables the old barrel/hay group
+    REQUIRE(HousingLayout::Disabled(1,parent,root) == true);
+    REQUIRE(HousingLayout::Disabled(2,parent,root) == false);
+    REQUIRE(HousingLayout::Disabled(3,parent,root) == true);
+    REQUIRE_FALSE(HousingLayout::Disabled(99,parent,root).has_value());
+    links[4]={4,false}; REQUIRE_FALSE(HousingLayout::Disabled(4,parent,root).has_value());
+    links[5]={6,false}; links[6]={5,false}; REQUIRE_FALSE(HousingLayout::Disabled(5,parent,root).has_value());
+    REQUIRE(HousingLayout::BeforeDisabled(false,true)); // repair a saved overlap
+    REQUIRE_FALSE(HousingLayout::BeforeDisabled(false,false)); // preserve unpurchased layout
+}
+TEST_CASE("Official homestead manifest includes complete enable-parent chains", "[housing-layout]")
+{
+    size_t linked{}, oldFarmControls{};
+    for (uint32_t key=0;key<WorldProgress::Bindings.size();++key)
+    {
+        const auto& b=WorldProgress::Bindings[key];
+        if (std::strcmp(b.Target.Plugin,"ccvsvsse004-beafarmer.esl")==0 && (b.Target.Base==0xE22 || b.Target.Base==0xE23))
+        { REQUIRE(b.Kind==0); ++oldFarmControls; }
+        if (b.Kind!=7) continue;
+        ++linked;
+        REQUIRE(b.ParentKey<WorldProgress::Bindings.size());
+        const auto& p=WorldProgress::Bindings[b.ParentKey];
+        REQUIRE(p.Target.Base==b.Aux.Base);
+        REQUIRE(std::strcmp(p.Target.Plugin,b.Aux.Plugin)==0);
+        const auto state=HousingLayout::Disabled(key,
+            [](uint32_t index)->std::optional<HousingLayout::Parent> {
+                const auto& b=WorldProgress::Bindings[index];
+                return b.Kind==7 ? std::optional(HousingLayout::Parent{b.ParentKey,b.Type!=0}) : std::nullopt;
+            }, [](uint32_t)->std::optional<bool> { return false; });
+        REQUIRE(state.has_value());
+    }
+    REQUIRE(linked>100);
+    REQUIRE(oldFarmControls==2);
+    REQUIRE_FALSE(WorldProgress::Replacements.empty());
+}
diff --git a/Code/tests/percentage_health.cpp b/Code/tests/percentage_health.cpp
new file mode 100644
index 00000000..ca9b6f6b
--- /dev/null
+++ b/Code/tests/percentage_health.cpp
@@ -0,0 +1,41 @@
+#include <catch2/catch.hpp>
+#include <PercentageHealth.h>
+#include <limits>
+
+TEST_CASE("Percentage health reconciles mixed level damage exactly once", "[percentage-health]")
+{
+    PercentageHealth::State state;
+    state.Seed(1000, 1000, false);
+    REQUIRE(state.Apply(1, 1, 1, PercentageHealth::Delta(-300, 1000)));
+    REQUIRE(state.Fraction == Approx(.7));
+    REQUIRE(state.Apply(1, 2, 1, PercentageHealth::Delta(-20, 200)));
+    REQUIRE(state.Fraction == Approx(.6));
+    REQUIRE(state.Fraction * 1000 == Approx(600));
+    REQUIRE(state.Fraction * 200 == Approx(120));
+    REQUIRE_FALSE(state.Apply(1, 1, 1, -.3f));
+    REQUIRE(state.Fraction == Approx(.6));
+    REQUIRE(state.Apply(1, 1, 3, -.1f));
+    REQUIRE_FALSE(state.Apply(1, 1, 2, -.1f));
+    REQUIRE(state.Apply(2, 1, 1, -.1f)); // new ownership epoch
+    REQUIRE(state.Fraction == Approx(.4));
+    REQUIRE(state.Apply(2, 2, 2, 1.f));
+    REQUIRE(state.Fraction == 1);
+    REQUIRE(state.Apply(2, 2, 3, -1.f));
+    REQUIRE(state.Fraction == 0);
+    REQUIRE(state.Apply(2, 2, 4, 1.f));
+    REQUIRE(state.Fraction == 0); // delayed healing cannot revive corpses
+}
+TEST_CASE("Percentage health rejects invalid samples and resolves floating point death", "[percentage-health]")
+{
+    PercentageHealth::State state;
+    REQUIRE_FALSE(state.Apply(0, 1, 1, -.5f));
+    REQUIRE_FALSE(state.Apply(1, 1, 0, -.5f));
+    REQUIRE_FALSE(state.Apply(1, 1, 1, std::numeric_limits<float>::quiet_NaN()));
+    REQUIRE_FALSE(state.Apply(1, 1, 1, -2.f));
+    REQUIRE(PercentageHealth::Delta(-30, 0) == 0);
+    REQUIRE(PercentageHealth::Delta(-30, std::numeric_limits<float>::infinity()) == 0);
+    for (uint64_t i = 1; i <= 10; ++i) REQUIRE(state.Apply(1, 1, i, -.1f));
+    REQUIRE(state.Fraction == 0);
+    state.Seed(200, 1000, true);
+    REQUIRE(state.Fraction == 0);
+}
diff --git a/Code/tests/world_progress.cpp b/Code/tests/world_progress.cpp
new file mode 100644
index 00000000..84426ce7
--- /dev/null
+++ b/Code/tests/world_progress.cpp
@@ -0,0 +1,51 @@
+#include <catch2/catch.hpp>
+#include <WorldProgressPolicy.h>
+#include <SurvivalTimePolicy.h>
+#include <limits>
+TEST_CASE("World progress commits once and rejects stale simultaneous edits", "[world-progress]")
+{
+    WorldProgress::Value canonical{5, 1, {0, 0, 0}};
+    auto host = canonical; host.Numbers[1] = 1;
+    auto client = canonical; client.Numbers[2] = 1;
+    REQUIRE(WorldProgress::Commit(canonical, host));
+    REQUIRE(canonical.Revision == 2);
+    REQUIRE_FALSE(WorldProgress::Commit(canonical, client));
+    REQUIRE_FALSE(WorldProgress::Commit(canonical, host));
+    client = canonical; client.Numbers[2] = 1;
+    REQUIRE(WorldProgress::Commit(canonical, client));
+    REQUIRE((canonical.Numbers == std::vector<float>{0, 1, 1}));
+    auto invalid = canonical; invalid.Numbers[0] = std::numeric_limits<float>::quiet_NaN();
+    REQUIRE_FALSE(WorldProgress::Commit(canonical, invalid));
+    invalid = canonical; invalid.Numbers.resize(129);
+    REQUIRE_FALSE(WorldProgress::Commit(canonical, invalid));
+}
+TEST_CASE("Shared wait targets allow seven days across month and year boundaries", "[world-progress]")
+{
+    struct Clock { unsigned Year, Month, Day; float Time; };
+    REQUIRE(SurvivalTime::HoursToTarget(Clock{201, 11, 28, 10}, Clock{202, 0, 4, 10}) == Approx(168));
+    REQUIRE(SurvivalTime::HoursToTarget(Clock{201, 11, 28, 10}, Clock{202, 0, 4, 11}) == 0);
+    REQUIRE(SurvivalTime::HoursToTarget(Clock{202, 0, 4, 10}, Clock{202, 0, 4, 10}) == 0);
+    REQUIRE(SurvivalTime::SkipSpeed == 3);
+}
+TEST_CASE("Concurrent edits to different house array entries merge without undoing builds", "[world-progress]")
+{
+    WorldProgress::Value state{1, 1, {0, 0, 0}};
+    WorldProgress::Value host{1, 1, {0, 1, 0}, {0, 0, 0}};
+    WorldProgress::Value guest{1, 1, {0, 0, 1}, {0, 0, 0}};
+    REQUIRE(WorldProgress::Commit(state, host));
+    REQUIRE(WorldProgress::Commit(state, guest));
+    REQUIRE((state.Numbers == std::vector<float>{0, 1, 1}));
+    REQUIRE_FALSE(WorldProgress::Commit(state, guest));
+}
+TEST_CASE("Shared plots award one harvest and enforce growth and regrowth timers", "[world-progress]")
+{
+    WorldProgress::Value plot{0x100001, 1, {1, 100, 0, 100}};
+    REQUIRE_FALSE(WorldProgress::Harvest(plot, 1, 100.99f));
+    REQUIRE(WorldProgress::Harvest(plot, 1, 101));
+    REQUIRE_FALSE(WorldProgress::Harvest(plot, 1, 101)); // simultaneous peer / replay
+    REQUIRE_FALSE(WorldProgress::Harvest(plot, 2, 103.99f));
+    REQUIRE(WorldProgress::Harvest(plot, 2, 104));
+    REQUIRE_FALSE(WorldProgress::Harvest(plot, 3, std::numeric_limits<float>::quiet_NaN()));
+    plot.Numbers[0] = 0;
+    REQUIRE_FALSE(WorldProgress::Harvest(plot, 3, 108));
+}
