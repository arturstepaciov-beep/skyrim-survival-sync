diff --git a/Code/server/Services/WorldProgressService.cpp b/Code/server/Services/WorldProgressService.cpp
new file mode 100644
index 00000000..f8901956
--- /dev/null
+++ b/Code/server/Services/WorldProgressService.cpp
@@ -0,0 +1,130 @@
+#include <Services/WorldProgressService.h>
+#include <Services/CalendarService.h>
+#include <World.h>
+#include <Components.h>
+#include <Messages/RequestHomestead.h>
+#include <Messages/NotifyHomestead.h>
+#include <WorldProgressBindings.h>
+namespace
+{
+GameId Resolve(World& w, WorldProgress::Form form)
+{
+    const auto& mods = w.ctx().at<ModsComponent>();
+    for (const auto& [name, info] : mods.GetStandardMods()) if (std::string(name.data(), name.size()) == form.Plugin) return GameId(info.id, form.Base);
+    for (const auto& [name, info] : mods.GetLiteMods()) if (std::string(name.data(), name.size()) == form.Plugin) return GameId(info.id, form.Base);
+    return {};
+}
+bool IsPlot(uint32_t key) { return key >= WorldProgress::PlotKeyBase && key - WorldProgress::PlotKeyBase < WorldProgress::Plots.size(); }
+}
+WorldProgressService::WorldProgressService(World& w, entt::dispatcher& d) : m_world(w)
+{
+    m_request = d.sink<PacketEvent<RequestHomestead>>().connect<&WorldProgressService::OnRequest>(this);
+}
+void WorldProgressService::Send(Player* player, HomesteadData data)
+{
+    data.Authority = m_authority;
+    data.Day = m_world.ctx().at<CalendarService>().GetDayCount();
+    NotifyHomestead notify; notify.Data = std::move(data); player->Send(notify);
+}
+void WorldProgressService::OnRequest(const PacketEvent<RequestHomestead>& event)
+{
+    const auto& q = event.Packet.Data;
+    auto* player = event.pPlayer;
+    if (q.Action < HomesteadAction::WorldPoll || !player || !player->GetCharacter()) return;
+    uint32_t authority{};
+    for (auto* peer : m_world.GetPlayerManager()) if (peer->GetCharacter() && (!authority || peer->GetId() < authority)) authority = peer->GetId();
+    if (authority != m_authority) { m_state.clear(); m_tokens.clear(); m_authority = authority; }
+    if (q.Action == HomesteadAction::WorldPoll)
+    {
+        HomesteadData data; data.Action = HomesteadAction::WorldState;
+        // Initial/reconnect snapshots only. Live commits are broadcast immediately.
+        for (const auto& [key, value] : m_state)
+        {
+            data.Progress.push_back(value);
+            if (data.Progress.size() == 32) { Send(player, data); data.Progress.clear(); }
+        }
+        Send(player, std::move(data)); return;
+    }
+    if (q.Action != HomesteadAction::WorldPublish && q.Action != HomesteadAction::WorldHarvest) return;
+    const float day = m_world.ctx().at<CalendarService>().GetDayCount();
+    HomesteadData reply; reply.Action = HomesteadAction::WorldState;
+    const bool planting = q.Action == HomesteadAction::WorldPublish && q.Token && q.Progress.size() == 1 && IsPlot(q.Progress[0].Key);
+    if (planting)
+    {
+        reply.Action = HomesteadAction::WorldHarvestResult; reply.Deposit = true;
+        reply.Token = q.Token; reply.Reference.BaseId = player->GetId();
+    }
+    if (q.Action == HomesteadAction::WorldHarvest)
+    {
+        if (q.Progress.size() != 1) return;
+        reply.Action = HomesteadAction::WorldHarvestResult; reply.Token = q.Token; reply.Reference.BaseId = player->GetId();
+    }
+    for (auto proposed : q.Progress)
+    {
+        const bool plot = IsPlot(proposed.Key);
+        if ((!plot && proposed.Key >= WorldProgress::Bindings.size()) || !WorldProgress::Valid(proposed)) continue;
+        if (!plot && WorldProgress::Bindings[proposed.Key].Kind == 7) continue;
+        const auto target = plot ? WorldProgress::Plots[proposed.Key - WorldProgress::PlotKeyBase].Soil : WorldProgress::Bindings[proposed.Key].Target;
+        if (!Resolve(m_world, target)) continue;
+        auto found = m_state.find(proposed.Key);
+        if (q.Action == HomesteadAction::WorldHarvest)
+        {
+            if (!plot || found == m_state.end() || found->second.Numbers.size() != 4) continue;
+            auto& value = found->second;
+            if (proposed.Revision != value.Revision) { reply.Progress.push_back(value); continue; }
+            const auto cell = Resolve(m_world, WorldProgress::Plots[proposed.Key - WorldProgress::PlotKeyBase].Cell);
+            const auto& plotInfo = WorldProgress::Plots[proposed.Key - WorldProgress::PlotKeyBase];
+            const auto& playerCell = player->GetCellComponent();
+            const auto character = player->GetCharacter();
+            const auto* movement = character ? m_world.try_get<MovementComponent>(*character) : nullptr;
+            // Exterior plots can sit across the player's current cell boundary.
+            // Validate world and physical distance instead of exact exterior cell.
+            const auto world = Resolve(m_world, plotInfo.World);
+            const bool sameArea = world ? playerCell.WorldSpaceId == world : playerCell.Cell == cell;
+            if (!sameArea || !movement || !std::isfinite(movement->Position.x) ||
+                !std::isfinite(movement->Position.y) || !std::isfinite(movement->Position.z) ||
+                glm::distance(movement->Position, glm::vec3(plotInfo.X, plotInfo.Y, plotInfo.Z)) > 512.f ||
+                !q.Token || q.Token <= m_tokens[player->GetId()]) continue;
+            m_tokens[player->GetId()] = q.Token;
+            reply.Action = HomesteadAction::WorldHarvestResult; reply.Token = q.Token;
+            reply.Reference.BaseId = player->GetId();
+            reply.Accepted = WorldProgress::Harvest(value, proposed.Revision, day);
+            reply.Progress.push_back(value); continue;
+        }
+        if (plot)
+        {
+            if (proposed.Numbers.size() != 4 || proposed.Numbers[0] < 0 || proposed.Numbers[0] > WorldProgress::Crops.size() || std::floor(proposed.Numbers[0]) != proposed.Numbers[0]) continue;
+            // Client sends ages; server owns the timestamps and harvest state.
+            if (found == m_state.end())
+            {
+                proposed.Numbers[1] = day - std::clamp(proposed.Numbers[1], 0.f, 10000.f);
+                proposed.Numbers[3] = day - std::clamp(proposed.Numbers[3], 0.f, 10000.f);
+                proposed.Numbers[2] = proposed.Numbers[2] != 0.f ? 1.f : 0.f;
+            }
+            else
+            {
+                if (!planting && proposed.Numbers[0] == found->second.Numbers[0]) continue;
+                const auto& p = WorldProgress::Plots[proposed.Key - WorldProgress::PlotKeyBase];
+                if (proposed.Numbers[0] > 0 && WorldProgress::Crops[size_t(proposed.Numbers[0]) - 1].Family != p.Family) continue;
+                proposed.Numbers = {proposed.Numbers[0], day, 0.f, day};
+            }
+        }
+        bool accepted{};
+        if (found == m_state.end())
+        {
+            if ((player->GetId() != authority && !q.Deposit) || proposed.Revision) continue;
+            proposed.Revision = 1; proposed.Previous.clear(); m_state.emplace(proposed.Key, proposed); accepted = true;
+        }
+        else accepted = WorldProgress::Commit(found->second, proposed);
+        const auto& current = m_state.at(proposed.Key);
+        if (!accepted)
+        {
+            HomesteadData correction = reply; correction.Progress.clear(); correction.Progress.push_back(current);
+            Send(player, std::move(correction));
+            if (planting) return;
+        }
+        else { reply.Accepted = true; reply.Progress.push_back(current); }
+    }
+    if (!reply.Progress.empty()) for (auto* peer : m_world.GetPlayerManager()) Send(peer, reply);
+    else if (q.Action == HomesteadAction::WorldHarvest || planting) Send(player, reply);
+}
