+#include <TiltedOnlinePCH.h>
+#include <Interface/UI.h>
+#include <Interface/IMenu.h>
+#include <Misc/BSFixedString.h>
+#include <SurvivalTimePolicy.h>
+
+// Numeric GFxValue is unmanaged; it has no Scaleform ownership or destructor.
+void ConfigureSurvivalWaitMenu()
+{
+    auto* ui = UI::Get();
+    auto* menu = ui ? ui->FindMenuByName(BSFixedString("Sleep/Wait Menu")) : nullptr;
+    if (!menu) return;
+    auto* movie = menu->uiMovie;
+    if (!movie) return;
+    struct Value { void* Interface{}; uint32_t Type{3}; uint32_t Padding{}; double Number{SurvivalTime::MaxSkipHours}; } value;
+    static_assert(sizeof(Value) == 24);
+    using SetVariable = bool(*)(void*, const char*, const Value&, uint32_t);
+    auto set = reinterpret_cast<SetVariable>((*reinterpret_cast<void***>(movie))[0x10]);
+    set(movie, "_root.SleepWaitMenu_mc.HoursSlider.maximum", value, 0);
+}
+
+static TiltedPhoques::Initializer s_survivalWaitSpeed([]
+{
+    VersionDbPtr<uint8_t> address(52486);
+    auto* site = address.Get() + 0x1D0;
+    // Fail closed if another mod has already replaced this instruction.
+    if (site[0] != 0x0F || site[1] != 0x2F || site[2] != 0x05)
+    {
+        spdlog::warn("SurvivalSync: sleep/wait speed hook unavailable or already patched");
+        return;
+    }
+    static const float secondsPerHour = 1.f / SurvivalTime::SkipSpeed;
+    struct Stub : TiltedPhoques::CodeGenerator
+    {
+        Stub(uint8_t* site, const float* seconds)
+        {
+            push(rax); mov(rax, reinterpret_cast<uintptr_t>(seconds));
+            comiss(xmm0, ptr[rax]); pop(rax); jmp_S(site + 7);
+        }
+    } stub(site, &secondsPerHour);
+    TiltedPhoques::Jump(site, stub.getCode());
+});
