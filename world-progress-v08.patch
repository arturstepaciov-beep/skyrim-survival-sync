+#include <Events/DisconnectedEvent.h>
+namespace
+{
+TESForm* Resolve(WorldProgress::Form form)
+{
+    auto* mods = ModManager::Get(); auto* mod = mods ? mods->GetByName(form.Plugin) : nullptr;
+    return mod && mod->IsLoaded() && form.Base ? TESForm::GetById(mod->GetFormId(form.Base)) : nullptr;
+}
+float Day() { auto* time = TimeData::Get(); return time && time->GameDaysPassed ? time->GameDaysPassed->f : 0.f; }
+int Count(TESObjectREFR* ref, TESForm* base)
+{
+    if (!ref || !base) return 0;
+    GameId id{}; if (!World::Get().GetModSystem().GetServerModId(base->formID, id)) return 0;
+    int total{}; for (const auto& entry : ref->GetInventory().Entries) if (entry.BaseId == id) total += entry.Count; return total;
+}
+void SetCount(TESObjectREFR* ref, TESForm* base, int count)
+{
+    if (!ref || !base) return;
+    Inventory::Entry entry; if (!World::Get().GetModSystem().GetServerModId(base->formID, entry.BaseId)) return;
+    entry.Count = count - Count(ref, base);
+    if (entry.Count)
+    {
+        if (ref == PlayerCharacter::Get()) ref->AddOrRemoveItem(entry, true);
+        else { ScopedInventoryOverride guard; ref->AddOrRemoveItem(entry, true); }
+    }
+}
+bool InCraftingTrigger(const WorldProgress::Binding& binding)
+{
+    auto* trigger = Resolve(binding.Cell); std::vector<float> v;
+    return trigger && ScriptStateAccess::Numbers(trigger, "BYOHHouseCraftingTriggerScript", "bPlayerInTrigger", 0, v) && v[0] != 0;
+}
+bool Attached(TESObjectREFR* ref) { auto* cell = ref ? ref->GetParentCellEx() : nullptr; return cell && cell->IsAttached(); }
+const char* Flora(const WorldProgress::Plot& p) { return p.Family ? "myPlantedFloraBase" : "plantedFloraBase"; }
+const char* Grown(const WorldProgress::Plot& p) { return p.Family ? "myPlantedFloraRef" : "plantedFloraRef"; }
+const char* Seed(const WorldProgress::Plot& p) { return p.Family ? "myPlantedItem" : "plantedItem"; }
+float Number(TESForm* form, const char* script, const char* field, float fallback)
+{
+    std::vector<float> v; return ScriptStateAccess::Numbers(form, script, field, 0, v) && !v.empty() ? v[0] : fallback;
+}
+void SetNumber(TESForm* form, const char* script, const char* field, float value)
+{
+    std::vector<float> v{value}; ScriptStateAccess::Numbers(form, script, field, 0, v, true);
+}
+}
+thread_local bool WorldProgressService::HarvestCommit = false;
+WorldProgressService::WorldProgressService(World& w, entt::dispatcher& d, TransportService& t) : m_world(w), m_transport(t)
+{
+    m_update = d.sink<UpdateEvent>().connect<&WorldProgressService::OnUpdate>(this);
+    m_notify = d.sink<NotifyHomestead>().connect<&WorldProgressService::OnNotify>(this);
+    m_disconnect = d.sink<DisconnectedEvent>().connect<&WorldProgressService::OnDisconnected>(this);
+}
+void WorldProgressService::Send(HomesteadData data) { RequestHomestead q; q.Data = std::move(data); m_transport.Send(q); }
+bool WorldProgressService::Capture(uint32_t key, std::vector<float>& out)
+{
+    if (key >= WorldProgress::PlotKeyBase)
+    {
+        const auto& p = WorldProgress::Plots[key - WorldProgress::PlotKeyBase];
+        auto* soil = Cast<TESObjectREFR>(Resolve(p.Soil)); auto* container = Resolve(p.Container);
+        if (!Attached(soil) || !container) return false;
+        auto* flora = ScriptStateAccess::Form(container, p.Script, Flora(p));
+        auto* seed = ScriptStateAccess::Form(container, p.Script, Seed(p));
+        auto* grown = Cast<TESObjectREFR>(ScriptStateAccess::Form(container, p.Script, Grown(p)));
+        uint32_t crop{};
+        for (size_t i = 0; i < WorldProgress::Crops.size(); ++i)
+        {
+            const auto& c = WorldProgress::Crops[i];
+            if (c.Family == p.Family && ((flora && flora == Resolve(c.Flora)) || (seed && seed == Resolve(c.Seed)))) { crop = uint32_t(i + 1); break; }
+        }
+        if (grown) m_grownPlots[grown->formID] = key;
+        out = {float(crop), std::max(0.f, Day() - Number(container, p.Script, "plantedTimestamp", Day())),
+               grown && (grown->flags & 0x2000) ? 1.f : 0.f, std::max(0.f, Day() - Number(container, p.Script, "resetTimestamp", Day()))};
+        return true;
+    }
+    const auto& b = WorldProgress::Bindings[key]; auto* form = Resolve(b.Target); if (!form) return false;
+    if (b.Kind == 0) { auto* ref = Cast<TESObjectREFR>(form); if (!ref || ref->IsDeleted()) return false; out = {ref->IsDisabled() ? 1.f : 0.f}; return true; }
+    if (b.Kind == 1) { out = {static_cast<TESGlobal*>(form)->f}; return std::isfinite(out[0]); }
+    if (b.Kind == 2 || b.Kind == 6) return ScriptStateAccess::Numbers(form, b.Script, b.Variable, b.Type, out);
+    if (b.Kind == 3 || b.Kind == 5)
+    {
+        const auto* fn = m_world.ctx().at<PapyrusService>().Get("Cell", "GetFactionOwner"); if (!fn) return false;
+        PapyrusFunction<TESFaction*, TESObjectCELL> get(fn);
+        out = {get(static_cast<TESObjectCELL*>(form)) == Resolve({"Skyrim.esm", 0xDB1}) ? 1.f : 0.f}; return true;
+    }
+    if (b.Kind == 4)
+    {
+        auto* chest = Cast<TESObjectREFR>(form); if (!chest) return false;
+        auto* token = Resolve(b.Aux); if (!token) return false;
+        out = {float(Count(chest, token) + (InCraftingTrigger(b) ? Count(PlayerCharacter::Get(), token) : 0))}; return true;
+    }
+    return false;
+}
+void WorldProgressService::Apply(uint32_t key)
+{
+    const auto found = m_state.find(key); if (found == m_state.end()) return;
+    const auto& v = found->second.Numbers;
+    if (key >= WorldProgress::PlotKeyBase)
+    {
+        const auto& p = WorldProgress::Plots[key - WorldProgress::PlotKeyBase];
+        auto* soil = Cast<TESObjectREFR>(Resolve(p.Soil)); auto* container = Resolve(p.Container);
+        if (!Attached(soil) || !container || v.size() != 4) return;
+        const uint32_t crop = uint32_t(v[0]);
+        if (crop > WorldProgress::Crops.size()) return;
+        auto* flora = crop ? Resolve(WorldProgress::Crops[crop - 1].Flora) : nullptr;
+        auto* grown = Cast<TESObjectREFR>(ScriptStateAccess::Form(container, p.Script, Grown(p)));
+        const float serverDay = m_serverDay + Day() - m_localDay;
+        const bool mature = crop && serverDay - v[1] >= 1.f;
+        const bool harvested = v[2] != 0.f && serverDay - v[3] < 3.f;
+        if (grown && (!flora || grown->baseForm != flora || (!harvested && (grown->flags & 0x2000))))
+        {
+            m_grownPlots.erase(grown->formID); grown->Disable(); grown->Delete(); grown = nullptr;
+            ScriptStateAccess::SetForm(container, p.Script, Grown(p), nullptr);
+        }
+        ScriptStateAccess::SetForm(container, p.Script, Flora(p), flora);
+        // Native gift menus still choose the seed. Once committed, the shared clock
+        // owns growth; don't let a second native seed/growth callback duplicate it.
+        if (auto* seed = ScriptStateAccess::Form(container, p.Script, Seed(p)))
+        {
+            SetCount(Cast<TESObjectREFR>(container), seed, 0);
+            ScriptStateAccess::SetForm(container, p.Script, Seed(p), nullptr);
+        }
+        SetNumber(container, p.Script, "plantedTimestamp", Day() - std::max(0.f, serverDay - v[1]));
+        SetNumber(container, p.Script, "resetTimestamp", Day());
+        if (mature && !grown && flora)
+        {
+            const auto* fn = m_world.ctx().at<PapyrusService>().Get("ObjectReference", "PlaceAtMe");
+            if (fn) { PapyrusFunction<TESObjectREFR*, TESObjectREFR, TESForm*, int32_t, bool, bool> place(fn); grown = place(soil, flora, 1, true, false); }
+            if (grown) ScriptStateAccess::SetForm(container, p.Script, Grown(p), grown);
+        }
+        if (grown)
+        {
+            m_grownPlots[grown->formID] = key;
+            if (harvested && !grown->IsDisabled()) grown->Disable();
+            if (!harvested && grown->IsDisabled()) grown->Enable();
+        }
+        ScriptStateAccess::State(soil, p.SoilScript, p.Family ? (mature ? "Planted" : "Empty") : (mature ? "planted" : "empty"));
+        if (p.Family) SetNumber(soil, p.SoilScript, "IsPlanted", mature ? 1.f : 0.f);
+    }
+    else
+    {
+        const auto& b = WorldProgress::Bindings[key]; auto* form = Resolve(b.Target); if (!form || v.empty()) return;
+        if (b.Kind == 0)
+        {
+            auto* ref = Cast<TESObjectREFR>(form); if (!ref || ref->IsDeleted()) return;
+            if (ref->IsDisabled() != (v[0] != 0.f)) { if (v[0]) ref->Disable(); else ref->Enable(); }
+        }
+        else if (b.Kind == 1)
+        {
+            const auto* fn = m_world.ctx().at<PapyrusService>().Get("GlobalVariable", "SetValue");
+            if (fn) { PapyrusFunction<void, TESGlobal, float> set(fn); set(static_cast<TESGlobal*>(form), v[0]); }
+        }
+        else if (b.Kind == 2) { auto numbers = v; ScriptStateAccess::Numbers(form, b.Script, b.Variable, b.Type, numbers, true); }
+        else if (b.Kind == 3)
+        {
+            const auto* fn = m_world.ctx().at<PapyrusService>().Get("Cell", "SetFactionOwner");
+            if (fn) { PapyrusFunction<void, TESObjectCELL, TESFaction*> set(fn); set(static_cast<TESObjectCELL*>(form), v[0] ? static_cast<TESFaction*>(Resolve({"Skyrim.esm", 0xDB1})) : nullptr); }
+        }
+        else if (b.Kind == 4)
+        {
+            auto* chest = Cast<TESObjectREFR>(form); auto* token = Resolve(b.Aux);
+            const bool active = InCraftingTrigger(b);
+            SetCount(chest, token, active ? 0 : std::clamp(int(v[0]), 0, 99));
+            if (active) SetCount(PlayerCharacter::Get(), token, std::clamp(int(v[0]), 0, 99));
+        }
+        else if ((b.Kind == 5 || b.Kind == 6) && v[0])
+        {
+            auto* keyForm = Resolve(b.Aux);
+            if (keyForm && !Count(PlayerCharacter::Get(), keyForm)) SetCount(PlayerCharacter::Get(), keyForm, 1);
+        }
+    }
+    std::vector<float> current; if (Capture(key, current)) m_seen[key] = std::move(current);
+}
+void WorldProgressService::OnUpdate(const UpdateEvent&)
+{
+    if (!m_transport.IsOnline() || !PlayerCharacter::Get()) return;
+    const auto now = m_world.GetTick();
+    if (now >= m_poll)
+    {
+        m_poll = now + (m_authority ? 60000 : 2000);
+        HomesteadData q; q.Action = HomesteadAction::WorldPoll; Send(std::move(q));
+    }
+    if (!m_authority || now < m_scan) return;
+    m_scan = now + 50;
+    HomesteadData q; q.Action = HomesteadAction::WorldPublish;
+    const uint32_t count = uint32_t(WorldProgress::Bindings.size() + WorldProgress::Plots.size());
+    for (uint32_t step = 0; step < 128; ++step)
+    {
+        const auto index = m_cursor++ % count;
+        const auto key = index < WorldProgress::Bindings.size() ? index : WorldProgress::PlotKeyBase + index - uint32_t(WorldProgress::Bindings.size());
+        std::vector<float> current; if (!Capture(key, current)) continue;
+        auto remote = m_state.find(key); auto seen = m_seen.find(key);
+        const bool plot = key >= WorldProgress::PlotKeyBase;
+        bool changed = seen != m_seen.end() && (plot ? seen->second[0] != current[0] : seen->second != current);
+        const bool seed = remote == m_state.end() && m_authority == m_transport.GetLocalPlayerId();
+        if (plot)
+        {
+            if (m_pendingCrops.contains(key)) continue;
+            const auto& p = WorldProgress::Plots[key - WorldProgress::PlotKeyBase];
+            // A fresh native seed also detects clearing and replanting the SAME crop.
+            if (remote != m_state.end() && ScriptStateAccess::Form(Resolve(p.Container), p.Script, Seed(p))) changed = true;
+            if (changed)
+            {
+                HomesteadData edit; edit.Action = HomesteadAction::WorldPublish;
+                edit.Deposit = remote == m_state.end(); edit.Token = ++m_token;
+                const auto revision = remote == m_state.end() ? 0 : remote->second.Revision;
+                edit.Progress.push_back({key, revision, current});
+                m_pendingCrops[key] = {revision, uint32_t(current[0]), edit.Token};
+                m_seen[key] = current; Send(std::move(edit)); continue;
+            }
+        }
+        if (changed && remote == m_state.end() && !seed)
+        {
+            // A house/plot first loaded only by a guest can still publish a real
+            // local edit, without uploading that guest's untouched save as a seed.
+            HomesteadData edit; edit.Action = HomesteadAction::WorldPublish; edit.Deposit = true;
+            edit.Progress.push_back({key, 0, current}); Send(std::move(edit));
+        }
+        if (seed || (changed && remote != m_state.end()))
+        {
+            q.Progress.push_back({key, remote == m_state.end() ? 0 : remote->second.Revision, current,
+                !plot && seen != m_seen.end() ? seen->second : std::vector<float>{}});
+            if (q.Progress.size() == 32) { Send(q); q.Progress.clear(); }
+        }
+        m_seen[key] = std::move(current);
+        if (!changed && remote != m_state.end()) Apply(key);
+    }
+    if (!q.Progress.empty()) Send(std::move(q));
+}
+bool WorldProgressService::IsPlanterReference(const TESObjectREFR* ref) const
+{
+    if (!m_transport.IsOnline() || !ref) return false;
+    for (const auto& plot : WorldProgress::Plots)
+        if (ref == Resolve(plot.Soil) || ref == Resolve(plot.Container)) return true;
+    return false;
+}
+bool WorldProgressService::TryHarvest(TESObjectREFR* ref)
+{
+    if (!m_transport.IsOnline() || !ref || HarvestCommit) return false;
+    auto found = m_grownPlots.find(ref->formID);
+    if (found != m_grownPlots.end())
+    {
+        const auto& plot = WorldProgress::Plots[found->second - WorldProgress::PlotKeyBase];
+        if (ScriptStateAccess::Form(Resolve(plot.Container), plot.Script, Grown(plot)) != ref)
+        { m_grownPlots.erase(found); return false; }
+    }
+    if (found == m_grownPlots.end())
+    {
+        for (uint32_t i = 0; i < WorldProgress::Plots.size(); ++i)
+        {
+            const auto& p = WorldProgress::Plots[i]; auto* soil = Cast<TESObjectREFR>(Resolve(p.Soil));
+            if (!Attached(soil)) continue;
+            if (ScriptStateAccess::Form(Resolve(p.Container), p.Script, Grown(p)) == ref) { found = m_grownPlots.emplace(ref->formID, WorldProgress::PlotKeyBase + i).first; break; }
+        }
+    }
+    if (found == m_grownPlots.end()) return false;
+    const auto state = m_state.find(found->second); if (state == m_state.end()) return true;
+    if (m_pendingHarvests.contains(ref->formID)) return true;
+    HomesteadData q; q.Action = HomesteadAction::WorldHarvest; q.Token = ++m_token; q.Progress.push_back(state->second);
+    m_pendingHarvests[ref->formID] = q.Token; Send(std::move(q)); return true;
+}
+void WorldProgressService::OnNotify(const NotifyHomestead& notify)
+{
+    const auto& data = notify.Data;
+    if (!m_transport.IsOnline() || (data.Action != HomesteadAction::WorldState && data.Action != HomesteadAction::WorldHarvestResult)) return;
+    if (m_authority != data.Authority) { m_state.clear(); m_seen.clear(); m_pendingHarvests.clear(); m_pendingCrops.clear(); m_authority = data.Authority; }
+    m_serverDay = data.Day; m_localDay = Day();
+    if (data.Action == HomesteadAction::WorldHarvestResult && data.Reference.BaseId == m_transport.GetLocalPlayerId())
+    {
+        if (data.Deposit)
+        {
+            for (auto it = m_pendingCrops.begin(); it != m_pendingCrops.end();)
+            {
+                if (it->second.Token != data.Token) { ++it; continue; }
+                const auto crop = it->second.Crop;
+                if (!data.Accepted && crop && crop <= WorldProgress::Crops.size())
+                {
+                    auto* seed = Resolve(WorldProgress::Crops[crop - 1].Seed);
+                    SetCount(PlayerCharacter::Get(), seed, Count(PlayerCharacter::Get(), seed) + 1);
+                }
+                it = m_pendingCrops.erase(it);
+            }
+        }
+        else
+        {
+        for (auto it = m_pendingHarvests.begin(); it != m_pendingHarvests.end();)
+        {
+            if (it->second != data.Token) { ++it; continue; }
+            if (data.Accepted)
+            {
+                auto* ref = Cast<TESObjectREFR>(TESForm::GetById(it->first));
+                if (Attached(ref)) { HarvestCommit = true; ref->Activate(PlayerCharacter::Get(), 0, nullptr, 1, 0); HarvestCommit = false; }
+            }
+            it = m_pendingHarvests.erase(it);
+        }
+        }
+    }
+    for (const auto& value : data.Progress)
+    {
+        if (!WorldProgress::Valid(value) || !value.Revision || (value.Key >= WorldProgress::Bindings.size() &&
+            (value.Key < WorldProgress::PlotKeyBase || value.Key - WorldProgress::PlotKeyBase >= WorldProgress::Plots.size()))) continue;
+        const auto existing = m_state.find(value.Key);
+        if (existing != m_state.end() && value.Revision < existing->second.Revision) continue;
+        m_state[value.Key] = value; Apply(value.Key);
+    }
+}
+void WorldProgressService::OnDisconnected(const DisconnectedEvent&)
+{
+    // Return unfinished crops to the native timer so an offline save keeps growing.
+    for (const auto& [key, state] : m_state)
+    {
+        if (key < WorldProgress::PlotKeyBase || state.Numbers.size() != 4) continue;
+        const auto crop = uint32_t(state.Numbers[0]); if (!crop || crop > WorldProgress::Crops.size()) continue;
+        const auto& p = WorldProgress::Plots[key - WorldProgress::PlotKeyBase]; auto* container = Resolve(p.Container);
+        if (!container) continue;
+        const float serverDay = m_serverDay + Day() - m_localDay;
+        SetNumber(container, p.Script, "resetTimestamp", Day() - std::max(0.f, serverDay - state.Numbers[3]));
+        if (serverDay - state.Numbers[1] < 1.f)
+        {
+            auto* seed = Resolve(WorldProgress::Crops[crop - 1].Seed);
+            ScriptStateAccess::SetForm(container, p.Script, Seed(p), seed);
+            SetCount(Cast<TESObjectREFR>(container), seed, 1);
+        }
+    }
+    m_state.clear(); m_seen.clear(); m_grownPlots.clear(); m_pendingHarvests.clear(); m_pendingCrops.clear();
+    m_authority = m_cursor = 0; m_scan = m_poll = 0; HarvestCommit = false;
+}
diff --git a/Code/client/Services/ScriptStateAccess.h b/Code/client/Services/ScriptStateAccess.h
new file mode 100644
index 00000000..94d8dde2
--- /dev/null
+++ b/Code/client/Services/ScriptStateAccess.h
@@ -0,0 +1,134 @@
+#pragma once
+#include <Misc/BSScript.h>
+#include <Misc/GameVM.h>
+#include <Forms/TESForm.h>
+#include <Games/Memory.h>
+#include <vector>
+#include <cmath>
+#include <cstring>
+#include <string>
+
+// Narrow SE/AE Papyrus adapter. Layouts and vtable slots follow CommonLibSSE-NG.
+// Bound objects remain referenced throughout each operation; no script/reward is replayed.
+namespace ScriptStateAccess
+{
+template <size_t Slot, class R, class... A> R Call(void* self, A... args)
+{
+    using Fn = R(*)(void*, A...);
+    return reinterpret_cast<Fn>((*reinterpret_cast<void***>(self))[Slot])(self, args...);
+}
+struct Object
+{
+    BSScript::Object* Pointer{};
+    Object(TESForm* form, const char* script)
+    {
+        auto* vm = GameVM::Get() ? GameVM::Get()->virtualMachine : nullptr;
+        auto* policy = vm ? vm->GetObjectHandlePolicy() : nullptr;
+        if (!policy || !form) return;
+        const auto handle = Call<4, uint64_t, uint32_t, const void*>(policy, static_cast<uint32_t>(form->formType), form);
+        Call<0x1C, bool, uint64_t, const char*, BSScript::Object**>(vm, handle, script, &Pointer);
+    }
+    ~Object()
+    {
+        if (!Pointer) return;
+        using Dec = uint32_t(BSScript::Object*);
+        POINTER_SKYRIMSE(Dec, dec, 104253);
+        if (!dec(Pointer))
+        {
+            using Destroy = void(BSScript::Object*);
+            POINTER_SKYRIMSE(Destroy, destroy, 104246);
+            destroy(Pointer); Memory::Free(Pointer);
+        }
+    }
+    BSScript::Variable* At(const char* name) const
+    {
+        if (!Pointer || !name) return nullptr;
+        auto* type = *reinterpret_cast<uint8_t**>(reinterpret_cast<uint8_t*>(Pointer) + 8);
+        const std::string automatic = std::string("::") + name + "_var";
+        for (unsigned depth = 0; type && depth < 16; ++depth)
+        {
+            const auto flags = *reinterpret_cast<uint32_t*>(type + 0x20);
+            if ((flags & 3) != 3) return nullptr;
+            const auto count = (flags >> 8) & 0x3FF;
+            auto* names = *reinterpret_cast<uint8_t**>(type + 0x30);
+            if (!names && count) return nullptr;
+            names += ((flags >> 2) & 0x3F) * 8;
+            uint32_t parentCount = 0;
+            auto* parent = *reinterpret_cast<uint8_t**>(type + 0x10);
+            unsigned parents = 0;
+            for (auto* p = parent; p && parents++ < 16; p = *reinterpret_cast<uint8_t**>(p + 0x10))
+            { parentCount += (*reinterpret_cast<uint32_t*>(p + 0x20) >> 8) & 0x3FF; if (parentCount > 1024) return nullptr; }
+            if (parents >= 16) return nullptr;
+            for (uint32_t i = 0; i < count; ++i)
+            {
+                const auto* label = reinterpret_cast<BSFixedString*>(names + i * 16)->AsAscii();
+                if (label && (_stricmp(label, name) == 0 || _stricmp(label, automatic.c_str()) == 0))
+                    return reinterpret_cast<BSScript::Variable*>(reinterpret_cast<uint8_t*>(Pointer) + 0x30) + parentCount + i;
+            }
+            type = parent;
+        }
+        return nullptr;
+    }
+};
+inline bool Numbers(TESForm* form, const char* script, const char* index, uint8_t type, std::vector<float>& out, bool write = false)
+{
+    Object object(form, script); auto* value = object.At(index); if (!value) return false;
+    if (!type) type = static_cast<uint8_t>(value->type);
+    if (static_cast<uint64_t>(value->type) != type) return false;
+    auto* first = value; uint32_t count = 1;
+    if (type >= 13 && type <= 15)
+    {
+        auto* array = reinterpret_cast<uint8_t*>(value->data.pObj); if (!array) return false;
+        count = *reinterpret_cast<uint32_t*>(array + 0x10); if (!count || count > 128) return false;
+        first = reinterpret_cast<BSScript::Variable*>(array + 0x20); type -= 10;
+    }
+    if (type < 3 || type > 5 || (write && out.size() != count)) return false;
+    if (!write) out.clear();
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        if (first[i].type != type) return false;
+        if (write)
+        {
+            if (!std::isfinite(out[i])) return false;
+            if (type == 3) first[i].data.i = static_cast<int32_t>(out[i]);
+            else if (type == 4) first[i].data.f = out[i];
+            else first[i].data.b = out[i] != 0.f;
+        }
+        else out.push_back(type == 3 ? float(first[i].data.i) : type == 4 ? first[i].data.f : first[i].data.b ? 1.f : 0.f);
+    }
+    return true;
+}
+inline TESForm* Form(TESForm* form, const char* script, const char* index)
+{
+    Object object(form, script); auto* value = object.At(index);
+    auto* bound = value ? value->GetObject() : nullptr;
+    auto* policy = BSScript::IObjectHandlePolicy::Get();
+    return bound && policy ? static_cast<TESForm*>(policy->GetObjectForHandle(0, bound->GetHandle())) : nullptr;
+}
+inline bool SetForm(TESForm* form, const char* script, const char* index, TESForm* desired)
+{
+    Object object(form, script); auto* value = object.At(index); if (!value) return false;
+    const auto declared = value->type;
+    if (static_cast<uint64_t>(declared) <= 16 || (static_cast<uint64_t>(declared) & 1)) return false;
+    if (!desired) { value->Reset(); value->type = declared; value->data.pObj = nullptr; return true; }
+    auto* vm = GameVM::Get()->virtualMachine; auto* policy = vm->GetObjectHandlePolicy();
+    const auto* className = reinterpret_cast<BSFixedString*>(static_cast<uintptr_t>(declared) + 8);
+    const auto handle = Call<4, uint64_t, uint32_t, const void*>(policy, 0, desired);
+    BSScript::Object* result{};
+    if (!Call<0x1C, bool, uint64_t, const char*, BSScript::Object**>(vm, handle, className->AsAscii(), &result))
+    {
+        if (!Call<0x15, bool, const BSFixedString*, BSScript::Object**>(vm, className, &result) || !result) return false;
+        auto* binder = Call<0x2F, void*>(vm);
+        using Bind = void(void*, BSScript::Object**, uint64_t);
+        POINTER_SKYRIMSE(Bind, bind, 104184); bind(binder, &result, handle);
+    }
+    if (!result) return false;
+    value->Reset(); value->type = declared; value->data.pObj = result;
+    return true;
+}
+inline void State(TESForm* form, const char* script, const char* state)
+{
+    Object object(form, script);
+    if (object.Pointer) reinterpret_cast<BSFixedString*>(reinterpret_cast<uint8_t*>(object.Pointer) + 0x10)->Set(state);
+}
+}
