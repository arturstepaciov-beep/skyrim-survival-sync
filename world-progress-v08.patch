diff --git a/Code/client/Services/Generic/QuestRewardSync.cpp b/Code/client/Services/Generic/QuestRewardSync.cpp
new file mode 100644
index 00000000..40759d9d
--- /dev/null
+++ b/Code/client/Services/Generic/QuestRewardSync.cpp
@@ -0,0 +1,112 @@
+#include <TiltedOnlinePCH.h>
+#include <Services/QuestRewardSync.h>
+#include <Services/TransportService.h>
+#include <Services/OverlayService.h>
+#include <Services/ScriptStateAccess.h>
+#include <World.h>
+#include <PlayerCharacter.h>
+#include <Forms/TESBoundObject.h>
+#include <Misc/NativeFunction.h>
+#include <Games/Overrides.h>
+#include <Messages/RequestHomestead.h>
+#include <Messages/NotifyHomestead.h>
+#include <QuestRewardPolicy.h>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace
+{
+std::mutex s_mutex;
+QuestRewards::Ledger s_ledger;
+std::string ItemKey(const HomesteadData& d)
+{
+    return std::string(d.RewardSource.c_str()) + ":" + std::to_string(d.Item.BaseId.ModId) + ":" + std::to_string(d.Item.BaseId.BaseId);
+}
+std::string GrantKey(const HomesteadData& d) { return ItemKey(d) + ":" + std::to_string(d.Token); }
+
+using Dispatch = bool(*)(NativeFunction*, BSScript::Variable*, BSScript::IVirtualMachine*, uint32_t, BSScript::Variable*, BSScript::StackFrame*);
+Dispatch s_dispatch{};
+bool CaptureDispatch(NativeFunction* fn, BSScript::Variable* base, BSScript::IVirtualMachine* vm, uint32_t stackId,
+                     BSScript::Variable* result, BSScript::StackFrame* frame)
+{
+    if (ScopedInventoryOverride::IsOverriden() || !fn || _stricmp(fn->functionName.AsAscii(), "AddItem") ||
+        _stricmp(fn->typeName.AsAscii(), "ObjectReference") || !base || !frame)
+        return s_dispatch(fn, base, vm, stackId, result, frame);
+    auto& world = World::Get();
+    if (!world.GetTransport().IsOnline() || !world.GetPartyService().IsInParty())
+        return s_dispatch(fn, base, vm, stackId, result, frame);
+    auto* object = base->GetObject(); auto* player = PlayerCharacter::Get();
+    auto* policy = vm ? vm->GetObjectHandlePolicy() : nullptr;
+    if (!object || !player || !policy || object->GetHandle() !=
+        ScriptStateAccess::Call<4, uint64_t, uint32_t, const void*>(policy, static_cast<uint32_t>(player->formType), player))
+        return s_dispatch(fn, base, vm, stackId, result, frame);
+
+    std::string source;
+    auto* caller = reinterpret_cast<uint8_t*>(frame);
+    for (unsigned depth = 0; caller && source.empty() && depth < 64; ++depth)
+    {
+        auto* function = *reinterpret_cast<BSScript::IFunction**>(caller + 0x10);
+        if (function)
+        {
+            const auto* script = function->GetObjectTypeName().AsAscii();
+            const auto* name = function->GetName().AsAscii();
+            if (script && name && (_strnicmp(script, "QF_", 3) == 0 || _strnicmp(script, "TIF_", 4) == 0) &&
+                _strnicmp(name, "Fragment_", 9) == 0)
+                source = std::string(script) + "/" + name + "/" + std::to_string(*reinterpret_cast<uint32_t*>(caller + 0x20));
+        }
+        auto* previous = *reinterpret_cast<uint8_t**>(caller + 8);
+        if (previous == caller) break;
+        caller = previous;
+    }
+    if (source.empty() || source.size() > 240) return s_dispatch(fn, base, vm, stackId, result, frame);
+    const auto page = frame->GetPageForFrame();
+    const auto* itemVar = frame->GetStackFrameVariable(0, page);
+    const auto* countVar = frame->GetStackFrameVariable(1, page);
+    auto* itemObject = itemVar ? itemVar->GetObject() : nullptr;
+    auto* item = itemObject ? static_cast<TESForm*>(policy->GetObjectForHandle(0, itemObject->GetHandle())) : nullptr;
+    const int count = countVar && countVar->type == BSScript::Variable::kInteger ? countVar->data.i : 0;
+    HomesteadData data; data.Action = HomesteadAction::QuestRewardClaim; data.RewardSource = source.c_str(); data.Item.Count = count;
+    if (!Cast<TESBoundObject>(item) || count <= 0 || count > 32767 || !world.GetModSystem().GetServerModId(item->formID, data.Item.BaseId))
+        return s_dispatch(fn, base, vm, stackId, result, frame);
+    {
+        std::lock_guard lock(s_mutex);
+        const auto claim = s_ledger.BeginNative(ItemKey(data)); data.Token = claim.Occurrence;
+        if (claim.Suppress) { if (result) result->Reset(); return true; }
+    }
+    const bool ok = s_dispatch(fn, base, vm, stackId, result, frame);
+    if (ok) world.GetRunner().Queue([data] { RequestHomestead request; request.Data = data; World::Get().GetTransport().Send(request); });
+    return ok;
+}
+struct Rewards
+{
+    entt::scoped_connection notify;
+    void OnNotify(const NotifyHomestead& n)
+    {
+        const auto& d = n.Data;
+        if (d.Action != HomesteadAction::QuestRewardGrant || d.RewardSource.empty() || !d.Token || d.Item.Count <= 0 ||
+            !World::Get().GetTransport().IsOnline() || !World::Get().GetPartyService().IsInParty()) return;
+        {
+            std::lock_guard lock(s_mutex);
+            if (!s_ledger.Receive(ItemKey(d), d.Token)) return;
+        }
+        auto* player = PlayerCharacter::Get(); if (!player) return;
+        // Use the normal inventory event path so server-owned player inventory
+        // observes the grant. The script capture only surrounds Papyrus AddItem.
+        player->AddOrRemoveItem(d.Item, true);
+        World::Get().GetOverlayService().SendSystemMessage("Shared quest reward received.");
+    }
+};
+}
+void InstallQuestRewardCapture(NativeFunction* function)
+{
+    if (s_dispatch || !function || _stricmp(function->typeName.AsAscii(), "ObjectReference") ||
+        _stricmp(function->functionName.AsAscii(), "AddItem")) return;
+    s_dispatch = reinterpret_cast<Dispatch>((*reinterpret_cast<void***>(function))[0x16]);
+    TP_HOOK(&s_dispatch, CaptureDispatch);
+}
+void InstallQuestRewardSync(entt::dispatcher& dispatcher)
+{
+    static Rewards rewards;
+    rewards.notify = dispatcher.sink<NotifyHomestead>().connect<&Rewards::OnNotify>(&rewards);
+}
