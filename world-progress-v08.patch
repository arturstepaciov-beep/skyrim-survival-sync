diff --git a/Code/tests/percentage_health.cpp b/Code/tests/percentage_health.cpp
new file mode 100644
index 00000000..ca9b6f6b
--- /dev/null
+++ b/Code/tests/percentage_health.cpp
@@ -0,0 +1,41 @@
+#include <catch2/catch.hpp>
+#include <PercentageHealth.h>
+#include <limits>
+
+TEST_CASE("Percentage health reconciles mixed level damage exactly once", "[percentage-health]")
+{
+    PercentageHealth::State state;
+    state.Seed(1000, 1000, false);
+    REQUIRE(state.Apply(1, 1, 1, PercentageHealth::Delta(-300, 1000)));
+    REQUIRE(state.Fraction == Approx(.7));
+    REQUIRE(state.Apply(1, 2, 1, PercentageHealth::Delta(-20, 200)));
+    REQUIRE(state.Fraction == Approx(.6));
+    REQUIRE(state.Fraction * 1000 == Approx(600));
+    REQUIRE(state.Fraction * 200 == Approx(120));
+    REQUIRE_FALSE(state.Apply(1, 1, 1, -.3f));
+    REQUIRE(state.Fraction == Approx(.6));
+    REQUIRE(state.Apply(1, 1, 3, -.1f));
+    REQUIRE_FALSE(state.Apply(1, 1, 2, -.1f));
+    REQUIRE(state.Apply(2, 1, 1, -.1f)); // new ownership epoch
+    REQUIRE(state.Fraction == Approx(.4));
+    REQUIRE(state.Apply(2, 2, 2, 1.f));
+    REQUIRE(state.Fraction == 1);
+    REQUIRE(state.Apply(2, 2, 3, -1.f));
+    REQUIRE(state.Fraction == 0);
+    REQUIRE(state.Apply(2, 2, 4, 1.f));
+    REQUIRE(state.Fraction == 0); // delayed healing cannot revive corpses
+}
+TEST_CASE("Percentage health rejects invalid samples and resolves floating point death", "[percentage-health]")
+{
+    PercentageHealth::State state;
+    REQUIRE_FALSE(state.Apply(0, 1, 1, -.5f));
+    REQUIRE_FALSE(state.Apply(1, 1, 0, -.5f));
+    REQUIRE_FALSE(state.Apply(1, 1, 1, std::numeric_limits<float>::quiet_NaN()));
+    REQUIRE_FALSE(state.Apply(1, 1, 1, -2.f));
+    REQUIRE(PercentageHealth::Delta(-30, 0) == 0);
+    REQUIRE(PercentageHealth::Delta(-30, std::numeric_limits<float>::infinity()) == 0);
+    for (uint64_t i = 1; i <= 10; ++i) REQUIRE(state.Apply(1, 1, i, -.1f));
+    REQUIRE(state.Fraction == 0);
+    state.Seed(200, 1000, true);
+    REQUIRE(state.Fraction == 0);
+}
