+++ b/Code/client/Services/Generic/WorldProgressService.cpp
@@ -0,0 +1,342 @@
+#include <Services/WorldProgressService.h>
+#include <Services/ScriptStateAccess.h>
+#include <Services/TransportService.h>
+#include <Services/PapyrusService.h>
+#include <WorldProgressBindings.h>
