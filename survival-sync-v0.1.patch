+#pragma once
+#include "Message.h"
+#include <Structs/TimeModel.h>
+// Protocol extension: every participant must use this custom client/server build.
+struct RequestTimeSkip final : ClientMessage
+{
+    static constexpr ClientOpcode Opcode = kRequestTimeSkip;
+    RequestTimeSkip()
+        : ClientMessage(Opcode)
+    {
+    }
+    void SerializeRaw(TiltedPhoques::Buffer::Writer&) const noexcept override;
+    void DeserializeRaw(TiltedPhoques::Buffer::Reader&) noexcept override;
+    bool operator==(const RequestTimeSkip& rhs) const noexcept { return GetOpcode() == rhs.GetOpcode() && TargetTime == rhs.TargetTime; }
+    TimeModel TargetTime;
+};
