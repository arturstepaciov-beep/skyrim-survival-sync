+void CalendarService::OnTimeSkip(const PacketEvent<RequestTimeSkip>& event) noexcept
+{
+    if (!bEnableSurvivalTimeSync || !event.pPlayer || !event.pPlayer->GetCharacter())
+        return;
+    // Account for real time before comparing, preventing a stale server baseline.
+    const auto now = GameServer::Get()->GetTick();
+    if (m_lastTick && now >= m_lastTick)
+        m_dateTime.Update(now - m_lastTick);
+    m_lastTick = now;
+    const float hours = SurvivalTime::HoursToTarget(m_dateTime.m_timeModel, event.Packet.TargetTime);
+    if (hours <= 0.f)
+        return;
+    m_dateTime.AddHours(hours);
+    spdlog::info("Survival time: player {} advanced the shared clock by {} hours", event.pPlayer->GetId(), hours);
