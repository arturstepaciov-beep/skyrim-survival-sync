+-- Local build metadata helper required by the root xmake before_build hook.
+function main()
+    import("detect.tools.find_git")
+    local git = find_git()
+    if not git then return "unknown", "unknown" end
+    return os.iorunv(git, {"rev-parse", "--abbrev-ref", "HEAD"}):trim(),
+           os.iorunv(git, {"describe", "--tags", "--always"}):trim()
+end
