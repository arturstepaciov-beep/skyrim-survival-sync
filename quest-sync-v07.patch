+bool QuestSyncReady()
+{
+    auto* player = PlayerCharacter::Get();
+    if (!player || !player->GetNiNode() || !player->parentCell) return false;
+    auto* ui = UI::Get();
+    return !ui || !ui->GetMenuOpen(BSFixedString("Loading Menu"));
+}
+constexpr uint16_t kJournalFlags = TESQuest::Completed | TESQuest::Failed | TESQuest::Active;
+}
+
+void QuestService::SyncStatus(const String& text) noexcept
+{
+    auto args = CefListValue::Create();
+    args->SetString(0, text.c_str());
+    if (auto* app = m_world.GetOverlayService().GetOverlayApp()) app->ExecuteAsync("questSyncStatus", args);
+}
+
+void QuestService::SyncWithHost() noexcept
+{
+    const auto& party = m_world.GetPartyService();
+    if (!m_world.GetTransport().IsOnline() || !party.IsInParty())
+    { SyncStatus("Join the host's party first."); return; }
+    if (party.IsLeader())
+    { SyncStatus("You are the quest host (party leader)."); return; }
+    if (m_pending && m_world.GetTick() < m_requestDeadline) return;
+    m_pending = true;
+    m_requestDeadline = m_world.GetTick() + 15000;
+    m_world.GetTransport().Send(RequestQuestSync{});
+    SyncStatus("Requesting the host's quest journal...");
+}
+
+void QuestService::Publish(bool force) noexcept
+{
+    if (!QuestSyncReady() || !m_world.GetPartyService().IsLeader()) return;
+    for (TESQuest* quest : ModManager::Get()->quests)
+    {
+        if (!quest || IsNonSyncableQuest(quest)) continue;
+        // Never publish unstarted background/initialization quests.
+        if (!quest->currentStage) continue;
+        QuestState state;
+        if (!m_world.GetModSystem().GetServerModId(quest->formID, state.Id)) continue;
+        state.Action = QuestSyncAction::State;
+        state.Authority = m_world.GetPartyService().GetLeaderPlayerId();
+        state.Stage = quest->currentStage;
+        state.Flags = quest->flags & kJournalFlags;
+        state.Type = static_cast<uint8_t>(quest->type);
+        state.Stopped = quest->IsStopped();
+        for (auto* objective : quest->objectives)
+        {
+            if (!objective) continue;
+            if (state.Objectives.size() == 255) break;
+            state.Objectives.push_back({objective->stageId, objective->state});
+        }
+        auto old = m_published.find(state.Id);
+        if (force || old == m_published.end() || old->second != state)
+        {
+            RequestQuestSync message; message.Data = state;
+            m_world.GetTransport().Send(message);
+            m_published[state.Id] = std::move(state);
+        }
+    }
+    if (force)
+    {
+        RequestQuestSync end; end.Data.Action = QuestSyncAction::Complete;
+        m_world.GetTransport().Send(end);
+    }
+}
+
+void QuestService::OnSync(const NotifyQuestSync& message) noexcept
+{
+    const auto& party = m_world.GetPartyService();
+    const auto& state = message.Data;
+    if (!party.IsInParty() || state.Authority != party.GetLeaderPlayerId()) return;
+    if (state.Action == QuestSyncAction::Request)
+    {
+        if (party.IsLeader())
+        {
+            // A loading host will publish after its player is ready again.
+            m_published.clear(); m_nextScan = 0;
+            if (QuestSyncReady()) Publish(true);
+        }
+        return;
+    }
+    if (party.IsLeader()) return;
+    if (state.Action == QuestSyncAction::State && state.Id && state.Stage)
+        m_desired[state.Id] = state;
+    else if (state.Action == QuestSyncAction::Complete && m_pending)
+    {
+        m_pending = false;
+        SyncStatus("Host journal received. Catch-up queued; conflicts are skipped.");
+    }
+}
+
+void QuestService::Apply(const QuestState& state) noexcept
+{
+    const auto form = m_world.GetModSystem().GetGameId(state.Id);
+    auto* quest = Cast<TESQuest>(TESForm::GetById(form));
+    if (!quest || IsNonSyncableQuest(quest)) return;
+    // Rewinding a divergent save cannot undo scripts, inventory or world changes.
+    if (QuestSyncPolicy::ShouldSkip(quest->currentStage, quest->flags, state.Stage, state.Flags,
+                                    state.Stopped, quest->IsStageDone(state.Stage))) return;
+    if (quest->currentStage != state.Stage)
+    {
+        auto previous = m_stageRequests.find(state.Id);
+        if (previous == m_stageRequests.end() || previous->second != state.Stage)
+        {
+            // Papyrus is asynchronous: enqueue each stage once, then await its state.
+            m_stageRequests[state.Id] = state.Stage;
+            quest->ScriptSetStage(state.Stage);
+            spdlog::info("Quest catch-up queued {:X} stage {}", form, state.Stage);
+        }
+        return;
+    }
+    ScopedQuestOverride override;
+    if (!state.Stopped && quest->IsStopped() && !(state.Flags & QuestSyncPolicy::TerminalFlags))
+    {
+        bool started = false;
+        quest->EnsureQuestStarted(started, false);
+        if (!started) return;
+    }
+    bool changed = false;
+    const auto flags = static_cast<uint16_t>((quest->flags & ~kJournalFlags) | (state.Flags & kJournalFlags));
+    if (flags != quest->flags) { quest->flags = flags; changed = true; }
+    if (state.Stopped && !quest->IsStopped()) { quest->SetStopped(); changed = true; }
+    for (auto* objective : quest->objectives)
+    {
+        if (!objective) continue;
+        const auto found = std::find_if(state.Objectives.begin(), state.Objectives.end(),
+            [objective](const auto& o) { return o.Id == objective->stageId; });
+        if (found != state.Objectives.end() && objective->state != found->State)
+        { objective->state = found->State; changed = true; }
+    }
+    if (changed) quest->MarkChanged(2);
+}
+
+void QuestService::OnUpdate(const UpdateEvent&) noexcept
+{
+    const auto& party = m_world.GetPartyService();
+    if (!m_world.GetTransport().IsOnline() || !party.IsInParty())
+    {
+        m_published.clear(); m_desired.clear(); m_stageRequests.clear();
+        m_lastLeader = 0; m_lastMembers = 0; m_pending = false; m_nextScan = 0;
+        return;
+    }
+    const auto now = m_world.GetTick();
+    const auto leader = party.GetLeaderPlayerId();
+    const auto members = party.GetPartyMembers().size();
+    const bool contextChanged = leader != m_lastLeader || members != m_lastMembers;
+    if (leader != m_lastLeader)
+    {
+        m_stageRequests.clear();
+        for (auto it = m_desired.begin(); it != m_desired.end();)
+            if (it->second.Authority != leader) it = m_desired.erase(it); else ++it;
+    }
+    m_lastLeader = leader; m_lastMembers = members;
+    if (m_pending && now >= m_requestDeadline)
+    { m_pending = false; SyncStatus("Host did not respond. Check that both players use this build and try again."); }
+    if (!QuestSyncReady() || (!contextChanged && now < m_nextScan)) return;
+    m_nextScan = now + 2000;
+    if (party.IsLeader()) Publish(contextChanged || m_published.empty());
+    else
+    {
+        if (contextChanged) SyncWithHost();
+        for (const auto& [id, state] : m_desired) Apply(state);
+    }
+}
 
