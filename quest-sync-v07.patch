+        if (now < next || player->GetId() == party->LeaderPlayerId) return;
+        next = now + 2000;
+        notify.Data = {}; notify.Data.Authority = party->LeaderPlayerId;
+        if (auto* host = m_world.GetPlayerManager().GetById(party->LeaderPlayerId)) host->Send(notify);
+        return;
+    }
+    if (player->GetId() != party->LeaderPlayerId) return;
+    if (state.Action != QuestSyncAction::State && state.Action != QuestSyncAction::Complete) return;
+    if (state.Action == QuestSyncAction::State)
+    {
+        if (!state.Id || !state.Stage || state.Type > 11) return;
+        if ((state.Type == 0 || state.Type == 6) && !bEnableMiscQuestSync) return;
+    }
+    GameServer::Get()->SendToParty(notify, player->GetParty(), event.GetSender());
 }
