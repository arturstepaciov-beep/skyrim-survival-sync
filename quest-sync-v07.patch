index 00000000..bb730e7d
--- /dev/null
+++ b/Code/common/QuestSyncPolicy.h
@@ -0,0 +1,14 @@
+#pragma once
+#include <cstdint>
+
+namespace QuestSyncPolicy
+{
+constexpr uint16_t TerminalFlags = (1 << 1) | (1 << 6);
+constexpr bool ShouldSkip(uint16_t localStage, uint16_t localFlags, uint16_t hostStage,
+                          uint16_t hostFlags, bool hostStopped, bool hostStageDone)
+{
+    return localStage > hostStage || ((localFlags & TerminalFlags) & ~hostFlags) ||
+        (localStage != hostStage && hostStageDone) ||
+        (!localStage && (hostStopped || (hostFlags & TerminalFlags)));
+}
+}
