@@ -0,0 +1,38 @@
+#include <Structs/QuestState.h>
+#include <TiltedCore/Serialization.hpp>
+
+void QuestState::Serialize(Buffer::Writer& w) const noexcept
+{
+    w.WriteBits(static_cast<uint8_t>(Action), 8);
+    w.WriteBits(Authority, 32);
+    Id.Serialize(w);
+    w.WriteBits(Stage, 16);
+    w.WriteBits(Flags, 16);
+    w.WriteBits(Type, 8);
+    w.WriteBits(Stopped, 1);
+    const auto count = std::min<size_t>(Objectives.size(), 255);
+    w.WriteBits(count, 8);
+    for (size_t i = 0; i < count; ++i)
+    {
+        w.WriteBits(Objectives[i].Id, 16);
+        w.WriteBits(Objectives[i].State, 8);
+    }
+}
+void QuestState::Deserialize(Buffer::Reader& r) noexcept
+{
+    uint64_t value{};
+    r.ReadBits(value, 8); Action = static_cast<QuestSyncAction>(value);
+    r.ReadBits(value, 32); Authority = static_cast<uint32_t>(value);
+    Id.Deserialize(r);
+    r.ReadBits(value, 16); Stage = static_cast<uint16_t>(value);
+    r.ReadBits(value, 16); Flags = static_cast<uint16_t>(value);
+    r.ReadBits(value, 8); Type = static_cast<uint8_t>(value);
+    r.ReadBits(value, 1); Stopped = value != 0;
+    r.ReadBits(value, 8);
+    Objectives.clear(); Objectives.resize(static_cast<size_t>(value));
+    for (auto& objective : Objectives)
+    {
+        r.ReadBits(value, 16); objective.Id = static_cast<uint16_t>(value);
+        r.ReadBits(value, 8); objective.State = static_cast<uint8_t>(value);
+    }
+}
