+TEST_CASE("Quest catch-up packets preserve authority, lifecycle and objectives", "[encoding.questsync]")
+{
+    for (auto action : {QuestSyncAction::Request, QuestSyncAction::State, QuestSyncAction::Complete})
+    {
+        QuestState state;
+        state.Action = action; state.Authority = 42; state.Id = GameId(3, 0x12345);
+        state.Stage = 65535; state.Flags = 0x842; state.Type = 11; state.Stopped = true;
+        for (uint16_t i = 0; i < 255; ++i) state.Objectives.push_back({i, static_cast<uint8_t>(i)});
+        RequestQuestSync request; request.Data = state;
+        Buffer clientBuffer(4096); Buffer::Writer cw(&clientBuffer); request.Serialize(cw);
+        Buffer::Reader cr(&clientBuffer); ClientMessageFactory cf; auto cm = cf.Extract(cr); REQUIRE(cm);
+        auto decodedRequest = CastUnique<RequestQuestSync>(std::move(cm));
+        REQUIRE(decodedRequest->Data == state);
+        NotifyQuestSync notify; notify.Data = state;
+        Buffer serverBuffer(4096); Buffer::Writer sw(&serverBuffer); notify.Serialize(sw);
+        Buffer::Reader sr(&serverBuffer); ServerMessageFactory sf; auto sm = sf.Extract(sr); REQUIRE(sm);
+        auto decodedNotify = CastUnique<NotifyQuestSync>(std::move(sm));
+        REQUIRE(decodedNotify->Data == state);
+    }
+}
+
+TEST_CASE("Quest catch-up never rewinds or reopens divergent terminal progress", "[encoding.questsync]")
+{
+    using QuestSyncPolicy::ShouldSkip;
+    REQUIRE_FALSE(ShouldSkip(10, 0, 20, 0, false, false));
+    REQUIRE_FALSE(ShouldSkip(0, 0, 20, 0, false, false));
+    REQUIRE_FALSE(ShouldSkip(20, 0, 20, 2, true, true));
+    REQUIRE(ShouldSkip(30, 0, 20, 0, false, true));
+    REQUIRE(ShouldSkip(10, 2, 20, 0, false, false));
+    REQUIRE(ShouldSkip(10, 64, 20, 0, false, false));
+    REQUIRE(ShouldSkip(10, 0, 20, 0, false, true));
+    REQUIRE(ShouldSkip(0, 0, 20, 2, true, false));
+    REQUIRE(ShouldSkip(0, 0, 20, 0, true, false));
+    REQUIRE_FALSE(ShouldSkip(20, 2, 20, 2, true, true));
+}
+
+TEST_CASE("Quest objectives are bounded to one small packet", "[encoding.questsync]")
+{
+    RequestQuestSync request;
+    request.Data.Action = QuestSyncAction::State;
+    for (uint16_t i = 0; i < 300; ++i) request.Data.Objectives.push_back({i, 1});
+    Buffer buffer(4096); Buffer::Writer w(&buffer); request.Serialize(w);
+    Buffer::Reader r(&buffer); ClientMessageFactory f; auto message = f.Extract(r); REQUIRE(message);
+    auto decoded = CastUnique<RequestQuestSync>(std::move(message));
+    REQUIRE(decoded->Data.Objectives.size() == 255);
+    REQUIRE(decoded->Data.Objectives.back().Id == 254);
+}
