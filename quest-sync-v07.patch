+#pragma once
+#include <Structs/GameId.h>
+
+// One quest per packet keeps even large journals below the transport limit.
+enum class QuestSyncAction : uint8_t { Request, State, Complete };
+struct QuestState
+{
+    struct Objective
+    {
+        uint16_t Id{};
+        uint8_t State{};
+        bool operator==(const Objective&) const = default;
+    };
+    QuestSyncAction Action{QuestSyncAction::Request};
+    uint32_t Authority{};
+    GameId Id{};
+    uint16_t Stage{};
+    uint16_t Flags{};
+    uint8_t Type{};
+    bool Stopped{};
+    TiltedPhoques::Vector<Objective> Objectives;
+    bool operator==(const QuestState&) const = default;
+    void Serialize(Buffer::Writer&) const noexcept;
+    void Deserialize(Buffer::Reader&) noexcept;
+};
